// RUN: pass tile-to-loop

// A dot whose bias and ReLU blocks are placed at its register tile (`at reg`): where the fold
// writes an element of the dot, the bias block adds its element of the bias and the ReLU block
// clamps the sum, and only the ReLU's result is stored. No buffer holds the dot or the shifted sum.
// CHECK: loop.func @dense([[INPUT:%[0-9]+]]: !loop.buf<2x4xf32, global>, [[WEIGHT:%[0-9]+]]: !loop.buf<4x16xf32, global>, [[BIAS:%[0-9]+]]: !loop.buf<16xf32, global>, [[OUTPUT:%[0-9]+]]: !loop.buf<2x16xf32, global>) attributes {access = [in, in, in, out]} {
// CHECK-NOT: shape = [2, 16]
// CHECK: [[STATE:%[0-9]+]] = loop.alloc() {shape = [], dtype = f32} : () -> !loop.buf<f32, private>
// CHECK: loop.yield() : () -> ()
// CHECK-NEXT: }) : (index, index) -> ()
// CHECK-NEXT: [[SUM:%[0-9]+]] = loop.load([[STATE]]) : (!loop.buf<f32, private>) -> f32
// CHECK-NEXT: [[OFFSET:%[0-9]+]] = loop.load([[BIAS]], [[COLUMN:%[0-9]+]]) : (!loop.buf<16xf32, global>, index) -> f32
// CHECK-NEXT: [[SHIFTED:%[0-9]+]] = arith.add([[SUM]], [[OFFSET]]) : (f32, f32) -> f32
// CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant() {value = 0.0 : f32} : () -> f32
// CHECK-NEXT: [[RECTIFIED:%[0-9]+]] = arith.maximum([[SHIFTED]], [[ZERO]]) : (f32, f32) -> f32
// CHECK-NEXT: loop.store([[RECTIFIED]], [[OUTPUT]], {{%[0-9]+}}, [[COLUMN]]) : (f32, !loop.buf<2x16xf32, global>, index, index) -> ()
tile.dispatch @dense(%input: tensor<2x4xf32>, %weight: tensor<4x16xf32>, %bias: tensor<16xf32>) -> tensor<2x16xf32> {
  %product = tile.block(%input, %weight) {iters = [par 2, par 16, red 4], reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<2x4xf32>, tensor<4x16xf32>) -> tensor<2x16xf32>
  %shifted = tile.block(%product, %bias) {iters = [par 2, par 16], reads = [$0[d0, d1] at reg, $1[d1]], folds = [none -> [d0, d1]]} ({
  ^body(%sum: f32, %offset: f32):
    %added = arith.add(%sum, %offset) : (f32, f32) -> f32
    tile.yield(%added) : (f32) -> ()
  }) : (tensor<2x16xf32>, tensor<16xf32>) -> tensor<2x16xf32>
  %rectified = tile.block(%shifted) {iters = [par 2, par 16], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
  ^body(%value: f32):
    %zero = arith.constant() {value = 0.0 : f32} : () -> f32
    %clamped = arith.maximum(%value, %zero) : (f32, f32) -> f32
    tile.yield(%clamped) : (f32) -> ()
  }) : (tensor<2x16xf32>) -> tensor<2x16xf32>
  func.return(%rectified) : (tensor<2x16xf32>) -> ()
}
func.func @main(%input: tensor<2x4xf32>, %weight: tensor<4x16xf32>, %bias: tensor<16xf32>) -> tensor<2x16xf32> {
  %out = host.dispatch(%input, %weight, %bias) {callee = @dense} : (tensor<2x4xf32>, tensor<4x16xf32>, tensor<16xf32>) -> tensor<2x16xf32>
  func.return(%out) : (tensor<2x16xf32>) -> ()
}

// -----

// The same under a register tile of 2 rows of one vector: the atom that writes the tile out of
// its registers runs the bias and the ReLU on each lane before it stores.
// CHECK: loop.func @dense([[INPUT:%[0-9]+]]: !loop.buf<2x4xf32, global>, [[WEIGHT:%[0-9]+]]: !loop.buf<4x16xf32, global>, [[BIAS:%[0-9]+]]: !loop.buf<16xf32, global>, [[OUTPUT:%[0-9]+]]: !loop.buf<2x16xf32, global>) attributes {access = [in, in, in, out]} {
// CHECK-NEXT: [[TILE:%[0-9]+]] = loop.alloc() {shape = [2, 16], dtype = f32, space = reg} : () -> !loop.buf<2x16xf32, reg>
// CHECK-NOT: loop.alloc
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [2, 16], lanes = 16} ({
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [2, 16], lanes = 16} ({
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [2, 16], lanes = 16} ({
// CHECK-NEXT: ^body([[ROW:%[0-9]+]]: index, [[LANE:%[0-9]+]]: index):
// CHECK-NEXT: [[AT_ROW:%[0-9]+]] = loop.index({{%[0-9]+}}, [[ROW]]) {expr = d0 + d1} : (index, index) -> index
// CHECK-NEXT: [[AT_COLUMN:%[0-9]+]] = loop.index({{%[0-9]+}}, [[LANE]]) {expr = d0 + d1} : (index, index) -> index
// CHECK-NEXT: [[SUM:%[0-9]+]] = loop.load([[TILE]], [[ROW]], [[LANE]]) : (!loop.buf<2x16xf32, reg>, index, index) -> f32
// CHECK-NEXT: [[OFFSET:%[0-9]+]] = loop.load([[BIAS]], [[AT_COLUMN]]) : (!loop.buf<16xf32, global>, index) -> f32
// CHECK-NEXT: [[SHIFTED:%[0-9]+]] = arith.add([[SUM]], [[OFFSET]]) : (f32, f32) -> f32
// CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant() {value = 0.0 : f32} : () -> f32
// CHECK-NEXT: [[RECTIFIED:%[0-9]+]] = arith.maximum([[SHIFTED]], [[ZERO]]) : (f32, f32) -> f32
// CHECK-NEXT: loop.store([[RECTIFIED]], [[OUTPUT]], [[AT_ROW]], [[AT_COLUMN]]) : (f32, !loop.buf<2x16xf32, global>, index, index) -> ()
tile.dispatch @dense(%input: tensor<2x4xf32>, %weight: tensor<4x16xf32>, %bias: tensor<16xf32>) -> tensor<2x16xf32> {
  %product = tile.block(%input, %weight) {iters = [par 2, par 16, red 4], reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]], loops = [d2 by 1, d0 by 2 : reg, d1 by 16 : lanes]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<2x4xf32>, tensor<4x16xf32>) -> tensor<2x16xf32>
  %shifted = tile.block(%product, %bias) {iters = [par 2, par 16], reads = [$0[d0, d1] at reg, $1[d1]], folds = [none -> [d0, d1]]} ({
  ^body(%sum: f32, %offset: f32):
    %added = arith.add(%sum, %offset) : (f32, f32) -> f32
    tile.yield(%added) : (f32) -> ()
  }) : (tensor<2x16xf32>, tensor<16xf32>) -> tensor<2x16xf32>
  %rectified = tile.block(%shifted) {iters = [par 2, par 16], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
  ^body(%value: f32):
    %zero = arith.constant() {value = 0.0 : f32} : () -> f32
    %clamped = arith.maximum(%value, %zero) : (f32, f32) -> f32
    tile.yield(%clamped) : (f32) -> ()
  }) : (tensor<2x16xf32>) -> tensor<2x16xf32>
  func.return(%rectified) : (tensor<2x16xf32>) -> ()
}
func.func @main(%input: tensor<2x4xf32>, %weight: tensor<4x16xf32>, %bias: tensor<16xf32>) -> tensor<2x16xf32> {
  %out = host.dispatch(%input, %weight, %bias) {callee = @dense} : (tensor<2x4xf32>, tensor<4x16xf32>, tensor<16xf32>) -> tensor<2x16xf32>
  func.return(%out) : (tensor<2x16xf32>) -> ()
}

// -----

// The sums of the lanes of each row, the block that adds them and the bias, all at the register
// tile of the lane sums: once the tile is finished, its sums leave the registers for private
// scratch, and the adding block reads the lanes of each row from there, the bias added to each sum
// as it is computed.
// CHECK: loop.func @row_sums([[INPUT:%[0-9]+]]: !loop.buf<4x8xf32, global>, [[BIAS:%[0-9]+]]: !loop.buf<4xf32, global>, [[OUTPUT:%[0-9]+]]: !loop.buf<4xf32, global>) attributes {access = [in, in, out<over = 1>]} {
// CHECK: [[PIECE:%[0-9]+]] = loop.alloc() {shape = [4, 4], dtype = f32} : () -> !loop.buf<4x4xf32, private>
// CHECK-NEXT: [[STATE:%[0-9]+]] = loop.alloc() {shape = [4, 4], dtype = f32, space = reg} : () -> !loop.buf<4x4xf32, reg>
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [4, 4], lanes = 4} ({
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [4, 4], lanes = 4} ({
// CHECK: loop.atom({{%[0-9]+}}, {{%[0-9]+}}) {tile = [4, 4], lanes = 4} ({
// CHECK-NEXT: ^body([[ROW:%[0-9]+]]: index, [[LANE:%[0-9]+]]: index):
// CHECK: [[SUM:%[0-9]+]] = loop.load([[STATE]], [[ROW]], [[LANE]]) : (!loop.buf<4x4xf32, reg>, index, index) -> f32
// CHECK: loop.store([[SUM]], [[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (f32, !loop.buf<4x4xf32, private>, index, index) -> ()
// CHECK: loop.for({{%[0-9]+}}, {{%[0-9]+}}) ({
// CHECK: [[LANE_0:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<4x4xf32, private>, index, index) -> f32
// CHECK: [[LANE_1:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<4x4xf32, private>, index, index) -> f32
// CHECK: [[LANE_2:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<4x4xf32, private>, index, index) -> f32
// CHECK: [[LANE_3:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<4x4xf32, private>, index, index) -> f32
// CHECK-NEXT: [[PAIR_0:%[0-9]+]] = arith.add([[LANE_0]], [[LANE_2]]) : (f32, f32) -> f32
// CHECK-NEXT: [[PAIR_1:%[0-9]+]] = arith.add([[LANE_1]], [[LANE_3]]) : (f32, f32) -> f32
// CHECK-NEXT: [[TOTAL:%[0-9]+]] = arith.add([[PAIR_0]], [[PAIR_1]]) : (f32, f32) -> f32
// CHECK-NEXT: [[OFFSET:%[0-9]+]] = loop.load([[BIAS]], [[AT:%[0-9]+]]) : (!loop.buf<4xf32, global>, index) -> f32
// CHECK-NEXT: [[SHIFTED:%[0-9]+]] = arith.add([[TOTAL]], [[OFFSET]]) : (f32, f32) -> f32
// CHECK-NEXT: loop.store([[SHIFTED]], [[OUTPUT]], [[AT]]) : (f32, !loop.buf<4xf32, global>, index) -> ()
tile.dispatch @row_sums(%input: tensor<4x8xf32>, %bias: tensor<4xf32>) -> tensor<4xf32> {
  %lane_sums = tile.block(%input) {iters = [par 4, red 2, par 4], reads = [$0[d0, d1 * 4 + d2]], folds = [sum -> [d0, d2]], loops = [d1 by 1, d0 by 4 : reg, d2 by 4 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x8xf32>) -> tensor<4x4xf32>
  %sums = tile.block(%lane_sums) {iters = [par 4], reads = [$0[d0, 0] at reg, $0[d0, 1], $0[d0, 2], $0[d0, 3]], folds = [none -> [d0]]} ({
  ^body(%lane_0: f32, %lane_1: f32, %lane_2: f32, %lane_3: f32):
    %pair_0 = arith.add(%lane_0, %lane_2) : (f32, f32) -> f32
    %pair_1 = arith.add(%lane_1, %lane_3) : (f32, f32) -> f32
    %total = arith.add(%pair_0, %pair_1) : (f32, f32) -> f32
    tile.yield(%total) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4xf32>
  %biased = tile.block(%sums, %bias) {iters = [par 4], reads = [$0[d0] at reg, $1[d0]], folds = [none -> [d0]]} ({
  ^body(%sum: f32, %offset: f32):
    %shifted = arith.add(%sum, %offset) : (f32, f32) -> f32
    tile.yield(%shifted) : (f32) -> ()
  }) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%biased) : (tensor<4xf32>) -> ()
}
func.func @main(%input: tensor<4x8xf32>, %bias: tensor<4xf32>) -> tensor<4xf32> {
  %out = host.dispatch(%input, %bias) {callee = @row_sums} : (tensor<4x8xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%out) : (tensor<4xf32>) -> ()
}

// -----

// The rows of a matrix doubled, two rows at a time, and the block that adds each row, placed at
// that mode: each piece of two rows is kept in private scratch while it is computed, and the
// adding block reads its rows from there once it is finished.
// CHECK: loop.func @rows_added([[INPUT:%[0-9]+]]: !loop.buf<4x4xf32, global>, [[OUTPUT:%[0-9]+]]: !loop.buf<4xf32, global>) attributes {access = [in, out]} {
// CHECK: loop.for({{%[0-9]+}}, {{%[0-9]+}}) ({
// CHECK: [[PIECE:%[0-9]+]] = loop.alloc() {shape = [2, 4], dtype = f32} : () -> !loop.buf<2x4xf32, private>
// CHECK: [[TWICE:%[0-9]+]] = arith.add({{%[0-9]+}}, {{%[0-9]+}}) : (f32, f32) -> f32
// CHECK: loop.store([[TWICE]], [[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (f32, !loop.buf<2x4xf32, private>, index, index) -> ()
// CHECK: loop.for({{%[0-9]+}}, {{%[0-9]+}}) ({
// CHECK: [[FIRST:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<2x4xf32, private>, index, index) -> f32
// CHECK: [[SECOND:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<2x4xf32, private>, index, index) -> f32
// CHECK: [[THIRD:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<2x4xf32, private>, index, index) -> f32
// CHECK: [[FOURTH:%[0-9]+]] = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<2x4xf32, private>, index, index) -> f32
// CHECK-NEXT: [[PAIR_0:%[0-9]+]] = arith.add([[FIRST]], [[SECOND]]) : (f32, f32) -> f32
// CHECK-NEXT: [[PAIR_1:%[0-9]+]] = arith.add([[THIRD]], [[FOURTH]]) : (f32, f32) -> f32
// CHECK-NEXT: [[TOTAL:%[0-9]+]] = arith.add([[PAIR_0]], [[PAIR_1]]) : (f32, f32) -> f32
// CHECK-NEXT: loop.store([[TOTAL]], [[OUTPUT]], {{%[0-9]+}}) : (f32, !loop.buf<4xf32, global>, index) -> ()
tile.dispatch @rows_added(%input: tensor<4x4xf32>) -> tensor<4xf32> {
  %doubled = tile.block(%input) {iters = [par 4, par 4], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    %twice = arith.add(%element, %element) : (f32, f32) -> f32
    tile.yield(%twice) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4x4xf32>
  %sums = tile.block(%doubled) {iters = [par 4], reads = [$0[d0, 0] at 0, $0[d0, 1], $0[d0, 2], $0[d0, 3]], folds = [none -> [d0]]} ({
  ^body(%first: f32, %second: f32, %third: f32, %fourth: f32):
    %pair_0 = arith.add(%first, %second) : (f32, f32) -> f32
    %pair_1 = arith.add(%third, %fourth) : (f32, f32) -> f32
    %total = arith.add(%pair_0, %pair_1) : (f32, f32) -> f32
    tile.yield(%total) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4xf32>
  func.return(%sums) : (tensor<4xf32>) -> ()
}
func.func @main(%input: tensor<4x4xf32>) -> tensor<4xf32> {
  %out = host.dispatch(%input) {callee = @rows_added} : (tensor<4x4xf32>) -> tensor<4xf32>
  func.return(%out) : (tensor<4xf32>) -> ()
}
