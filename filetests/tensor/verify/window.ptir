  func.return(%sum) : (tensor<3xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_max: the input must be an integer or float tensor, got tensor<4xi1>
func.func @window_i1_input(%input: tensor<4xi1>) -> tensor<3xi1> {
  %max = tensor.reduce_window_max(%input) {window_dims = [2], strides = [1], padding = [(0, 0)], base_dilation = [1], window_dilation = [1]} : (tensor<4xi1>) -> tensor<3xi1>
  func.return(%max) : (tensor<3xi1>) -> ()
