// RUN: pass merge-contracted-axes

// A convolution splits its patches [N, OH, OW, KH * KW * C_in] into [N, OH, OW, KH, KW, C_in] and
// contracts them with the weight [C_out, C_in, KH, KW]. The pass moves the weight to
// [KH * KW * C_in, C_out], and the patches contract whole.
// CHECK: func.func @conv
// CHECK: tensor.transpose(%1) {perm = [2, 3, 1, 0]} : (tensor<4x3x2x2xf32>) -> tensor<2x2x3x4xf32>
// CHECK: tensor.reshape(%2) {shape = [12, 4]} : (tensor<2x2x3x4xf32>) -> tensor<12x4xf32>
// CHECK: tensor.dot_general(%0, %3) {contract_lhs = [3], contract_rhs = [0]} : (tensor<1x2x2x12xf32>, tensor<12x4xf32>) -> tensor<1x2x2x4xf32>
func.func @conv(%0: tensor<1x2x2x12xf32>, %1: tensor<4x3x2x2xf32> {param = 1}) -> tensor<1x2x2x4xf32> {
  %2 = tensor.reshape(%0) {shape = [1, 2, 2, 2, 2, 3]} : (tensor<1x2x2x12xf32>) -> tensor<1x2x2x2x2x3xf32>
  %3 = tensor.dot_general(%2, %1) {contract_lhs = [3, 4, 5], contract_rhs = [2, 3, 1]} : (tensor<1x2x2x2x2x3xf32>, tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32>
  func.return(%3) : (tensor<1x2x2x4xf32>) -> ()
}

// -----

// A batch axis of the lhs after the split axis moves up, and the weight keeps its batch axis first.
// CHECK: func.func @batched
// CHECK: tensor.transpose(%1) {perm = [0, 2, 1, 3]} : (tensor<4x3x2x5xf32>) -> tensor<4x2x3x5xf32>
// CHECK: tensor.reshape(%2) {shape = [4, 6, 5]} : (tensor<4x2x3x5xf32>) -> tensor<4x6x5xf32>
// CHECK: tensor.dot_general(%0, %3) {batch_lhs = [1], batch_rhs = [0], contract_lhs = [0], contract_rhs = [1]} : (tensor<6x4xf32>, tensor<4x6x5xf32>) -> tensor<4x5xf32>
func.func @batched(%0: tensor<6x4xf32>, %1: tensor<4x3x2x5xf32> {param = 1}) -> tensor<4x5xf32> {
  %2 = tensor.reshape(%0) {shape = [2, 3, 4]} : (tensor<6x4xf32>) -> tensor<2x3x4xf32>
  %3 = tensor.dot_general(%2, %1) {batch_lhs = [2], batch_rhs = [0], contract_lhs = [0, 1], contract_rhs = [2, 1]} : (tensor<2x3x4xf32>, tensor<4x3x2x5xf32>) -> tensor<4x5xf32>
  func.return(%3) : (tensor<4x5xf32>) -> ()
}

// -----

// A weight computed at run time stays as it is: transposing it would cost a copy on every run.
// CHECK: func.func @run_time_weight
// CHECK-NOT: tensor.transpose
func.func @run_time_weight(%0: tensor<1x2x2x12xf32>, %1: tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32> {
  %2 = tensor.reshape(%0) {shape = [1, 2, 2, 2, 2, 3]} : (tensor<1x2x2x12xf32>) -> tensor<1x2x2x2x2x3xf32>
  %3 = tensor.dot_general(%2, %1) {contract_lhs = [3, 4, 5], contract_rhs = [2, 3, 1]} : (tensor<1x2x2x2x2x3xf32>, tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32>
  func.return(%3) : (tensor<1x2x2x4xf32>) -> ()
}

// -----

// The pass leaves a dot alone when its reshape does more than split one axis into the contracted
// axes.
// CHECK: func.func @not_a_split
// CHECK-NOT: tensor.transpose
func.func @not_a_split(%0: tensor<4x3xf32>, %1: tensor<2x3x5xf32> {param = 1}) -> tensor<2x5xf32> {
  %2 = tensor.reshape(%0) {shape = [2, 2, 3]} : (tensor<4x3xf32>) -> tensor<2x2x3xf32>
  %3 = tensor.dot_general(%2, %1) {contract_lhs = [1, 2], contract_rhs = [0, 1]} : (tensor<2x2x3xf32>, tensor<2x3x5xf32>) -> tensor<2x5xf32>
  func.return(%3) : (tensor<2x5xf32>) -> ()
}
