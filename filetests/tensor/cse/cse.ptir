// RUN: pass cse,dce

// Identical pure ops merge.
// CHECK: func.func @same([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK: [[EXP:%[0-9]+]] = tensor.exp([[INPUT]])
// CHECK-NOT: tensor.exp
// CHECK: tensor.add([[EXP]], [[EXP]])
func.func @same(%input: tensor<4xf32>) -> tensor<4xf32> {
  %exp = tensor.exp(%input) : (tensor<4xf32>) -> tensor<4xf32>
  %exp_copy = tensor.exp(%input) : (tensor<4xf32>) -> tensor<4xf32>
  %sum = tensor.add(%exp, %exp_copy) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%sum) : (tensor<4xf32>) -> ()
}

// -----

// Equal attributes on different operands keep both ops.
// CHECK: func.func @keep([[MATRIX:%[0-9]+]]: tensor<3x3xf32>)
// CHECK: [[TRANSPOSED:%[0-9]+]] = tensor.transpose([[MATRIX]]) {perm = [1, 0]}
// CHECK-NEXT: tensor.transpose([[TRANSPOSED]]) {perm = [1, 0]}
func.func @keep(%matrix: tensor<3x3xf32>) -> (tensor<3x3xf32>, tensor<3x3xf32>) {
  %transposed = tensor.transpose(%matrix) {perm = [1, 0]} : (tensor<3x3xf32>) -> tensor<3x3xf32>
  %restored = tensor.transpose(%transposed) {perm = [1, 0]} : (tensor<3x3xf32>) -> tensor<3x3xf32>
  func.return(%transposed, %restored) : (tensor<3x3xf32>, tensor<3x3xf32>) -> ()
}

// -----

// An opaque op is never merged.
// NO-INTERP: custom calls have no reference semantics
// CHECK: func.func @opaque([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK: tensor.custom_call([[INPUT]])
// CHECK: tensor.custom_call([[INPUT]])
func.func @opaque(%input: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
  %first_call = tensor.custom_call(%input) {target = "k", results = [tensor<4xf32>]} : (tensor<4xf32>) -> tensor<4xf32>
  %second_call = tensor.custom_call(%input) {target = "k", results = [tensor<4xf32>]} : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%first_call, %second_call) : (tensor<4xf32>, tensor<4xf32>) -> ()
}
