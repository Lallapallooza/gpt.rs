// RUN: pass tile-to-loop, loop-to-isa {target = "x86-64-v4"}

// A register tile of 6 rows by 96 columns, in vectors of 16 lanes, holds 36 accumulators, more
// registers than the 32 of x86-64-v4: its vector code would spill, so the lowering fails. It names
// the op where the code that holds the most registers holds them: a product of the reduction,
// while the 36 accumulators, the 6 vectors of a row of weights, an input's broadcast and the
// product are live, 44.
// ERROR: loop-to-isa {target = "x86-64-v4"}: loop.func @project: its vector code holds 44 vector registers at once at loc("" via ["tile-to-loop"("arith.mul":{{[0-9]+}}), "loop-to-isa"("arith.mul":{{[0-9]+}})]), and x86-64-v4 has 32
tile.dispatch @project(%input: tensor<6x7xf32>, %weight: tensor<7x96xf32>) -> tensor<6x96xf32> attributes {target = "x86-64-v4@3928f7d3"} {
  %product = tile.block(%input, %weight) {iters = [par 6, par 96, red 7], reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]], loops = [d2 by 1, d0 by 6 : reg, d1 by 96 : reg, d1 by 16 : lanes]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<6x7xf32>, tensor<7x96xf32>) -> tensor<6x96xf32>
  func.return(%product) : (tensor<6x96xf32>) -> ()
}
func.func @main(%input: tensor<6x7xf32>, %weight: tensor<7x96xf32>) -> tensor<6x96xf32> {
  %product = host.dispatch(%input, %weight) {callee = @project} : (tensor<6x7xf32>, tensor<7x96xf32>) -> tensor<6x96xf32>
  func.return(%product) : (tensor<6x96xf32>) -> ()
}
