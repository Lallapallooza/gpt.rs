// RUN: verify

// ERROR: tensor.argmax: axis 2 is out of range for rank 2
func.func @argmax_axis(%scores: tensor<2x5xf32>) -> tensor<2xsi32> {
  %best = tensor.argmax(%scores) {axis = 2, out = si32} : (tensor<2x5xf32>) -> tensor<2xsi32>
  func.return(%best) : (tensor<2xsi32>) -> ()
}

// -----

// ERROR: tensor.argmax: indices must be si32 or si64, got f32
func.func @argmax_float_indices(%scores: tensor<2x5xf32>) -> tensor<2xf32> {
  %best = tensor.argmax(%scores) {axis = 1, out = f32} : (tensor<2x5xf32>) -> tensor<2xf32>
  func.return(%best) : (tensor<2xf32>) -> ()
}

// -----

// ERROR: tensor.argmax: axis 1 of tensor<2x0xf32> is empty
func.func @argmax_empty_axis(%scores: tensor<2x0xf32>) -> tensor<2xsi32> {
  %best = tensor.argmax(%scores) {axis = 1, out = si32} : (tensor<2x0xf32>) -> tensor<2xsi32>
  func.return(%best) : (tensor<2xsi32>) -> ()
}

// -----

// ERROR: tensor.top_k: k = 6 exceeds axis 1 of tensor<2x5xf32>
func.func @top_k_too_many(%scores: tensor<2x5xf32>) -> (tensor<2x6xf32>, tensor<2x6xsi32>) {
  %top_values, %top_indices = tensor.top_k(%scores) {k = 6, axis = 1, indices = si32} : (tensor<2x5xf32>) -> (tensor<2x6xf32>, tensor<2x6xsi32>)
  func.return(%top_values, %top_indices) : (tensor<2x6xf32>, tensor<2x6xsi32>) -> ()
}

// -----

// ERROR: tensor.top_k: indices must be si32 or si64, got f32
func.func @top_k_float_indices(%scores: tensor<2x5xf32>) -> (tensor<2x2xf32>, tensor<2x2xf32>) {
  %top_values, %top_indices = tensor.top_k(%scores) {k = 2, axis = 1, indices = f32} : (tensor<2x5xf32>) -> (tensor<2x2xf32>, tensor<2x2xf32>)
  func.return(%top_values, %top_indices) : (tensor<2x2xf32>, tensor<2x2xf32>) -> ()
}

// -----

// ERROR: tensor.segment_sum: segment ids must be si32 or si64 with one id per row of tensor<6x4xf32>, got tensor<5xsi32>
func.func @segment_ids(%data: tensor<6x4xf32>, %segment_ids: tensor<5xsi32>) -> tensor<3x4xf32> {
  %sums = tensor.segment_sum(%data, %segment_ids) {num_segments = 3} : (tensor<6x4xf32>, tensor<5xsi32>) -> tensor<3x4xf32>
  func.return(%sums) : (tensor<3x4xf32>) -> ()
}

// -----

// ERROR: tensor.segment_sum: data must have rank at least 1, got tensor<f32>
func.func @segment_scalar(%data: tensor<f32>, %segment_ids: tensor<1xsi32>) -> tensor<3xf32> {
  %sums = tensor.segment_sum(%data, %segment_ids) {num_segments = 3} : (tensor<f32>, tensor<1xsi32>) -> tensor<3xf32>
  func.return(%sums) : (tensor<3xf32>) -> ()
}
