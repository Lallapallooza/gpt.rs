// RUN: pass tensor-to-tile

// Arithmetic and transcendental ops of the unary and binary families.
// CHECK: func.func @arithmetic([[LHS:%[0-9]+]]: tensor<4xf32>, [[RHS:%[0-9]+]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK: tile.block([[LHS]], [[RHS]]) {iters = [par 4], reads = [$0[d0], $1[d0]], folds = [none -> [d0]]}
// CHECK-NEXT: ^body([[LHS_ELEMENT:%[0-9]+]]: f32, [[RHS_ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: arith.add([[LHS_ELEMENT]], [[RHS_ELEMENT]])
// CHECK: arith.reciprocal
// CHECK-NOT: tensor.
func.func @arithmetic(%lhs: tensor<4xf32>, %rhs: tensor<4xf32>) -> tensor<4xf32> {
  %sum = tensor.add(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %difference = tensor.sub(%sum, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %product = tensor.mul(%difference, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %quotient = tensor.div(%product, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %maximum = tensor.maximum(%quotient, %lhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %minimum = tensor.minimum(%maximum, %lhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %negated = tensor.neg(%minimum) : (tensor<4xf32>) -> tensor<4xf32>
  %magnitude = tensor.abs(%negated) : (tensor<4xf32>) -> tensor<4xf32>
  %exponential = tensor.exp(%magnitude) : (tensor<4xf32>) -> tensor<4xf32>
  %logarithm = tensor.log(%exponential) : (tensor<4xf32>) -> tensor<4xf32>
  %tanh = tensor.tanh(%logarithm) : (tensor<4xf32>) -> tensor<4xf32>
  %erf = tensor.erf(%tanh) : (tensor<4xf32>) -> tensor<4xf32>
  %rsqrt = tensor.rsqrt(%erf) : (tensor<4xf32>) -> tensor<4xf32>
  %reciprocal = tensor.reciprocal(%rsqrt) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%reciprocal) : (tensor<4xf32>) -> ()
}

// -----
// Constants stay.
// CHECK: tensor.constant() {value = dense<[2, 2] x f32: [1.0, -0.5, 1e-7, inf]>}
func.func @constants() -> (tensor<2x2xf32>, tensor<3xsi32>, tensor<f32>, tensor<2xbf16>, tensor<2xf32>, tensor<1xf32>, tensor<2xi1>, tensor<2xf8e4m3>, tensor<0xf32>) {
  %matrix = tensor.constant() {value = dense<[2, 2] x f32: [1.0, -0.5, 1e-7, inf]>} : () -> tensor<2x2xf32>
  %zeros = tensor.constant() {value = dense<[3] x si32: 0>} : () -> tensor<3xsi32>
  %half = tensor.constant() {value = dense<[] x f32: 0.5>} : () -> tensor<f32>
  %bf16_values = tensor.constant() {value = dense<[2] x bf16: [1.0, 3.140625]>} : () -> tensor<2xbf16>
  %negative_zero_and_inf = tensor.constant() {value = dense<[2] x f32: [-0.0, -inf]>} : () -> tensor<2xf32>
  %nan = tensor.constant() {value = dense<[1] x f32: 0x0000c07f>} : () -> tensor<1xf32>
  %flags = tensor.constant() {value = dense<[2] x i1: [true, false]>} : () -> tensor<2xi1>
  %fp8_values = tensor.constant() {value = dense<[2] x f8e4m3: 0x3840>} : () -> tensor<2xf8e4m3>
  %empty = tensor.constant() {value = dense<[0] x f32: []>} : () -> tensor<0xf32>
  func.return(%matrix, %zeros, %half, %bf16_values, %negative_zero_and_inf, %nan, %flags, %fp8_values, %empty) : (tensor<2x2xf32>, tensor<3xsi32>, tensor<f32>, tensor<2xbf16>, tensor<2xf32>, tensor<1xf32>, tensor<2xi1>, tensor<2xf8e4m3>, tensor<0xf32>) -> ()
}

// -----
// CHECK: ^body([[LHS_ELEMENT:%[0-9]+]]: f32, [[RHS_ELEMENT:%[0-9]+]]: f32):
// CHECK: arith.less([[LHS_ELEMENT]], [[RHS_ELEMENT]])
// CHECK-NOT: tensor.
func.func @compare(%lhs: tensor<4xf32>, %rhs: tensor<4xf32>) -> (tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>) {
  %less = tensor.less(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  %less_equal = tensor.less_equal(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  %equal = tensor.equal(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  %greater_equal = tensor.greater_equal(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  %greater = tensor.greater(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  %not_equal = tensor.not_equal(%lhs, %rhs) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  func.return(%less, %less_equal, %equal, %greater_equal, %greater, %not_equal) : (tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>, tensor<4xi1>) -> ()
}

// -----
// CHECK: iters = [par 2, par {T}]
// CHECK-NEXT: ^body([[LHS_ELEMENT:%[0-9]+]]: si32, [[RHS_ELEMENT:%[0-9]+]]: si32):
// CHECK: arith.greater_equal([[LHS_ELEMENT]], [[RHS_ELEMENT]]) : (si32, si32) -> i1
// CHECK-NOT: tensor.
func.func @compare_si32(%lhs: tensor<2x{T}xsi32>, %rhs: tensor<2x{T}xsi32>) -> tensor<2x{T}xi1> {
  %greater_equal = tensor.greater_equal(%lhs, %rhs) : (tensor<2x{T}xsi32>, tensor<2x{T}xsi32>) -> tensor<2x{T}xi1>
  func.return(%greater_equal) : (tensor<2x{T}xi1>) -> ()
}

// -----
// CHECK: reads = [$0[d0, d1], $1[d0, d1], $2[d0, d1]]
// CHECK-NEXT: ^body([[CONDITION:%[0-9]+]]: i1, [[ON_TRUE:%[0-9]+]]: f32, [[ON_FALSE:%[0-9]+]]: f32):
// CHECK: arith.select([[CONDITION]], [[ON_TRUE]], [[ON_FALSE]]) : (i1, f32, f32) -> f32
// CHECK-NOT: tensor.
func.func @select(%condition: tensor<2x{T}xi1>, %on_true: tensor<2x{T}xf32>, %on_false: tensor<2x{T}xf32>) -> tensor<2x{T}xf32> {
  %selected = tensor.select(%condition, %on_true, %on_false) : (tensor<2x{T}xi1>, tensor<2x{T}xf32>, tensor<2x{T}xf32>) -> tensor<2x{T}xf32>
  func.return(%selected) : (tensor<2x{T}xf32>) -> ()
}

// -----
// CHECK: ^body([[BF16_ELEMENT:%[0-9]+]]: bf16):
// CHECK: arith.cast([[BF16_ELEMENT]]) {to = f32} : (bf16) -> f32
// CHECK: ^body([[SI32_ELEMENT:%[0-9]+]]: si32):
// CHECK: arith.cast([[SI32_ELEMENT]]) {to = i1} : (si32) -> i1
// CHECK-NOT: tensor.
func.func @cast(%bf16_input: tensor<2x3xbf16>, %si32_input: tensor<4xsi32>) -> (tensor<2x3xf32>, tensor<4xi1>, tensor<4xsi32>) {
  %widened = tensor.cast(%bf16_input) {to = f32} : (tensor<2x3xbf16>) -> tensor<2x3xf32>
  %nonzero = tensor.cast(%si32_input) {to = i1} : (tensor<4xsi32>) -> tensor<4xi1>
  %unchanged = tensor.cast(%si32_input) {to = si32} : (tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%widened, %nonzero, %unchanged) : (tensor<2x3xf32>, tensor<4xi1>, tensor<4xsi32>) -> ()
}

// -----
// `stop_gradient` is its input.
// CHECK: func.func @stop_gradient([[INPUT:%[0-9]+]]: tensor<2x{T}xf32>) -> tensor<2x{T}xf32> {
// CHECK: func.return([[INPUT]])
func.func @stop_gradient(%input: tensor<2x{T}xf32>) -> tensor<2x{T}xf32> {
  %stopped = tensor.stop_gradient(%input) : (tensor<2x{T}xf32>) -> tensor<2x{T}xf32>
  func.return(%stopped) : (tensor<2x{T}xf32>) -> ()
}

// -----
// The ops that compute on bits, and sin and cos.
// `x & x` reads one operand twice.
// CHECK: func.func @bits([[BYTES:%[0-9]+]]: tensor<4xui8>, [[FLAGS:%[0-9]+]]: tensor<4xi1>, [[ANGLES:%[0-9]+]]: tensor<4xf64>) -> (tensor<4xui8>, tensor<4xi1>, tensor<4xf64>) {
// CHECK: tile.block([[BYTES]]) {iters = [par 4], reads = [$0[d0], $0[d0]], folds = [none -> [d0]]}
// CHECK: arith.and
// CHECK: arith.shift_right_arithmetic
// CHECK: arith.not({{%[0-9]+}}) : (i1) -> i1
// CHECK-NOT: tensor.
func.func @bits(%bytes: tensor<4xui8>, %flags: tensor<4xi1>, %angles: tensor<4xf64>) -> (tensor<4xui8>, tensor<4xi1>, tensor<4xf64>) {
  %masked = tensor.and(%bytes, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %merged = tensor.or(%masked, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %toggled = tensor.xor(%merged, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %shifted_left = tensor.shift_left(%toggled, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %shifted_logical = tensor.shift_right_logical(%shifted_left, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %shifted_arithmetic = tensor.shift_right_arithmetic(%shifted_logical, %bytes) : (tensor<4xui8>, tensor<4xui8>) -> tensor<4xui8>
  %inverted = tensor.not(%shifted_arithmetic) : (tensor<4xui8>) -> tensor<4xui8>
  %negated_flags = tensor.not(%flags) : (tensor<4xi1>) -> tensor<4xi1>
  %sines = tensor.sin(%angles) : (tensor<4xf64>) -> tensor<4xf64>
  %cosines = tensor.cos(%sines) : (tensor<4xf64>) -> tensor<4xf64>
  func.return(%inverted, %negated_flags, %cosines) : (tensor<4xui8>, tensor<4xi1>, tensor<4xf64>) -> ()
}

// -----
// Casts between the integer widths, and to the fnuz floats.
// CHECK: ^body([[SI16_ELEMENT:%[0-9]+]]: si16):
// CHECK: arith.cast([[SI16_ELEMENT]]) {to = ui64} : (si16) -> ui64
// CHECK: ^body([[E4M3_SOURCE:%[0-9]+]]: f32):
// CHECK: arith.cast([[E4M3_SOURCE]]) {to = f8e4m3fnuz}
// CHECK: ^body([[E5M2_SOURCE:%[0-9]+]]: f32):
// CHECK: arith.cast([[E5M2_SOURCE]]) {to = f8e5m2fnuz}
// CHECK-NOT: tensor.
func.func @casts(%si16_input: tensor<4xsi16>, %f32_input: tensor<4xf32>) -> (tensor<4xui64>, tensor<4xf8e4m3fnuz>, tensor<4xf8e5m2fnuz>) {
  %ui64 = tensor.cast(%si16_input) {to = ui64} : (tensor<4xsi16>) -> tensor<4xui64>
  %fp8_e4m3 = tensor.cast(%f32_input) {to = f8e4m3fnuz} : (tensor<4xf32>) -> tensor<4xf8e4m3fnuz>
  %fp8_e5m2 = tensor.cast(%f32_input) {to = f8e5m2fnuz} : (tensor<4xf32>) -> tensor<4xf8e5m2fnuz>
  func.return(%ui64, %fp8_e4m3, %fp8_e5m2) : (tensor<4xui64>, tensor<4xf8e4m3fnuz>, tensor<4xf8e5m2fnuz>) -> ()
}
