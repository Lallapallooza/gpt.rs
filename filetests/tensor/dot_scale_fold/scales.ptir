// RUN: pass dot-scale-fold

// A static scale of a dot's result moves into the weight, laid out along the weight's free axis.
// ROUNDING: fold_scale: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @scale([[INPUT:%[0-9]+]]: tensor<2x3xf32>, [[WEIGHT:%[0-9]+]]: tensor<3x4xf32> {param = 1}, [[SCALE:%[0-9]+]]: tensor<4xf32> {param = 2})
// CHECK-NEXT: [[RESHAPED_SCALE:%[0-9]+]] = tensor.reshape([[SCALE]]) {shape = [1, 4]}
// CHECK-NEXT: [[SCALES:%[0-9]+]] = tensor.broadcast_to([[RESHAPED_SCALE]]) {shape = [3, 4]}
// CHECK-NEXT: [[SCALED_WEIGHT:%[0-9]+]] = tensor.mul([[WEIGHT]], [[SCALES]])
// CHECK-NEXT: [[SCALED:%[0-9]+]] = tensor.dot_general([[INPUT]], [[SCALED_WEIGHT]]) {contract_lhs = [1], contract_rhs = [0]}
// CHECK-NEXT: func.return([[SCALED]])
func.func @scale(%input: tensor<2x3xf32>, %weight: tensor<3x4xf32> {param = 1}, %scale: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// With batch axes, the free axes of the weight still end the result.
// ROUNDING: fold_scale: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @batched([[INPUT:%[0-9]+]]: tensor<2x3x5xf32>, [[WEIGHT:%[0-9]+]]: tensor<2x5x4xf32> {param = 1}, [[SCALE:%[0-9]+]]: tensor<4xf32> {param = 2})
// CHECK-NEXT: [[RESHAPED_SCALE:%[0-9]+]] = tensor.reshape([[SCALE]]) {shape = [1, 1, 4]}
// CHECK-NEXT: [[SCALES:%[0-9]+]] = tensor.broadcast_to([[RESHAPED_SCALE]]) {shape = [2, 5, 4]}
// CHECK-NEXT: [[SCALED_WEIGHT:%[0-9]+]] = tensor.mul([[WEIGHT]], [[SCALES]])
// CHECK-NEXT: tensor.dot_general([[INPUT]], [[SCALED_WEIGHT]]) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]}
func.func @batched(%input: tensor<2x3x5xf32>, %weight: tensor<2x5x4xf32> {param = 1}, %scale: tensor<4xf32> {param = 2}) -> tensor<2x3x4xf32> {
  %product = tensor.dot_general(%input, %weight) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]} : (tensor<2x3x5xf32>, tensor<2x5x4xf32>) -> tensor<2x3x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 3, 4]} : (tensor<4xf32>) -> tensor<2x3x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x3x4xf32>, tensor<2x3x4xf32>) -> tensor<2x3x4xf32>
  func.return(%scaled) : (tensor<2x3x4xf32>) -> ()
}

// -----

// The scale stays outside the dot when it varies along an axis of `x`.
// CHECK: func.func @along_x
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @along_x(%input: tensor<2x3xf32>, %weight: tensor<3x4xf32> {param = 1}, %scale: tensor<2x1xf32> {param = 2}) -> tensor<2x4xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<2x1xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// A run-time weight would be scaled on every run.
// CHECK: func.func @run_time_weight
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @run_time_weight(%input: tensor<2x3xf32>, %weight: tensor<3x4xf32>, %scale: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// Scaling a weight cast from a narrower dtype would store a widened copy of it.
// CHECK: func.func @cast_weight
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @cast_weight(%input: tensor<2x3xf32>, %weight: tensor<3x4xbf16> {param = 1}, %scale: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %widened = tensor.cast(%weight) {to = f32} : (tensor<3x4xbf16>) -> tensor<3x4xf32>
  %product = tensor.dot_general(%input, %widened) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// Another use of the unscaled product needs it as it is.
// CHECK: func.func @shared_product
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @shared_product(%input: tensor<2x3xf32>, %weight: tensor<3x4xf32> {param = 1}, %scale: tensor<4xf32> {param = 2}) -> (tensor<2x4xf32>, tensor<2x4xf32>) {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled, %product) : (tensor<2x4xf32>, tensor<2x4xf32>) -> ()
}

// -----

// A scale computed at run time would scale the weight on every run.
// CHECK: func.func @run_time_scale
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @run_time_scale(%input: tensor<2x3xf32>, %weight: tensor<3x4xf32> {param = 1}, %scale: tensor<4xf32>) -> tensor<2x4xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// A constant weight keeps the multiply: its scaled copy would add a stored parameter as large as
// the weight, instead of replacing one.
// CHECK: func.func @constant_weight
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @constant_weight(%input: tensor<2x3xf32>, %scale: tensor<4xf32> {param = 1}) -> tensor<2x4xf32> {
  %weight = tensor.constant() {value = dense<3x4xf32: 0.5>} : () -> tensor<3x4xf32>
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// A bf16 weight of a dot with an f32 result keeps the f32 multiply: scaling the weight would round
// in bf16.
// CHECK: func.func @widening_dot
// CHECK: [[PRODUCT:%[0-9]+]] = tensor.dot_general
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[PRODUCT]], [[SCALES]])
func.func @widening_dot(%input: tensor<2x3xbf16>, %weight: tensor<3x4xbf16> {param = 1}, %scale: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0], out = f32} : (tensor<2x3xbf16>, tensor<3x4xbf16>) -> tensor<2x4xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%scaled) : (tensor<2x4xf32>) -> ()
}

// -----

// A scale along the last of two free axes of the weight.
// ROUNDING: fold_scale: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @two_free([[INPUT:%[0-9]+]]: tensor<2x3xf32>, [[WEIGHT:%[0-9]+]]: tensor<3x4x5xf32> {param = 1}, [[SCALE:%[0-9]+]]: tensor<5xf32> {param = 2})
// CHECK-NEXT: tensor.reshape([[SCALE]]) {shape = [1, 1, 5]}
func.func @two_free(%input: tensor<2x3xf32>, %weight: tensor<3x4x5xf32> {param = 1}, %scale: tensor<5xf32> {param = 2}) -> tensor<2x4x5xf32> {
  %product = tensor.dot_general(%input, %weight) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4x5xf32>) -> tensor<2x4x5xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [2, 4, 5]} : (tensor<5xf32>) -> tensor<2x4x5xf32>
  %scaled = tensor.mul(%product, %scales) : (tensor<2x4x5xf32>, tensor<2x4x5xf32>) -> tensor<2x4x5xf32>
  func.return(%scaled) : (tensor<2x4x5xf32>) -> ()
}

// -----

// A product that a transpose and a reshape move, which only adds or removes axes of extent 1:
// the scale along a batch axis of the result moves into the weight's batch axis, and the moves
// follow the scaled product, as with a depthwise filter's channels and the BatchNorm after it.
// ROUNDING: fold_scale: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @moved([[INPUT:%[0-9]+]]: tensor<2x3x5xf32>, [[WEIGHT:%[0-9]+]]: tensor<2x5x1xf32> {param = 1}, [[SCALE:%[0-9]+]]: tensor<2xf32> {param = 2})
// CHECK-NEXT: [[RESHAPED_SCALE:%[0-9]+]] = tensor.reshape([[SCALE]]) {shape = [2, 1, 1]}
// CHECK-NEXT: [[SCALES:%[0-9]+]] = tensor.broadcast_to([[RESHAPED_SCALE]]) {shape = [2, 5, 1]}
// CHECK-NEXT: [[SCALED_WEIGHT:%[0-9]+]] = tensor.mul([[WEIGHT]], [[SCALES]])
// CHECK-NEXT: [[PRODUCT:%[0-9]+]] = tensor.dot_general([[INPUT]], [[SCALED_WEIGHT]]) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]}
// CHECK-NEXT: [[SWAPPED:%[0-9]+]] = tensor.transpose([[PRODUCT]]) {perm = [1, 0, 2]}
// CHECK-NEXT: [[CHANNELS:%[0-9]+]] = tensor.reshape([[SWAPPED]]) {shape = [3, 2]}
// CHECK-NEXT: func.return([[CHANNELS]])
func.func @moved(%input: tensor<2x3x5xf32>, %weight: tensor<2x5x1xf32> {param = 1}, %scale: tensor<2xf32> {param = 2}) -> tensor<3x2xf32> {
  %product = tensor.dot_general(%input, %weight) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]} : (tensor<2x3x5xf32>, tensor<2x5x1xf32>) -> tensor<2x3x1xf32>
  %swapped = tensor.transpose(%product) {perm = [1, 0, 2]} : (tensor<2x3x1xf32>) -> tensor<3x2x1xf32>
  %channels = tensor.reshape(%swapped) {shape = [3, 2]} : (tensor<3x2x1xf32>) -> tensor<3x2xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [3, 2]} : (tensor<2xf32>) -> tensor<3x2xf32>
  %scaled = tensor.mul(%channels, %scales) : (tensor<3x2xf32>, tensor<3x2xf32>) -> tensor<3x2xf32>
  func.return(%scaled) : (tensor<3x2xf32>) -> ()
}

// -----

// A reshape that merges axes the scale varies along keeps the scale outside the dot.
// CHECK: func.func @merged
// CHECK: [[FLAT:%[0-9]+]] = tensor.reshape
// CHECK: [[SCALES:%[0-9]+]] = tensor.broadcast_to
// CHECK: tensor.mul([[FLAT]], [[SCALES]])
func.func @merged(%input: tensor<2x3x5xf32>, %weight: tensor<2x5x1xf32> {param = 1}, %scale: tensor<6xf32> {param = 2}) -> tensor<6xf32> {
  %product = tensor.dot_general(%input, %weight) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]} : (tensor<2x3x5xf32>, tensor<2x5x1xf32>) -> tensor<2x3x1xf32>
  %flat = tensor.reshape(%product) {shape = [6]} : (tensor<2x3x1xf32>) -> tensor<6xf32>
  %scales = tensor.broadcast_to(%scale) {shape = [6]} : (tensor<6xf32>) -> tensor<6xf32>
  %scaled = tensor.mul(%flat, %scales) : (tensor<6xf32>, tensor<6xf32>) -> tensor<6xf32>
  func.return(%scaled) : (tensor<6xf32>) -> ()
}
