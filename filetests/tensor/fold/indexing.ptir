// RUN: pass fold,dce

// A dynamic slice as large as its input is the input, and an update as large as its base
// replaces it: the starts clamp to 0.
// CHECK: func.func @whole([[BASE:%[0-9]+]]: tensor<2x3xf32>, [[UPDATE:%[0-9]+]]: tensor<2x3xf32>, [[STARTS:%[0-9]+]]: tensor<2xsi32>)
// CHECK-NOT: tensor.dynamic
// CHECK: func.return([[BASE]], [[UPDATE]])
func.func @whole(%base: tensor<2x3xf32>, %update: tensor<2x3xf32>, %starts: tensor<2xsi32>) -> (tensor<2x3xf32>, tensor<2x3xf32>) {
  %sliced = tensor.dynamic_slice(%base, %starts) {sizes = [2, 3]} : (tensor<2x3xf32>, tensor<2xsi32>) -> tensor<2x3xf32>
  %updated = tensor.dynamic_update_slice(%base, %update, %starts) : (tensor<2x3xf32>, tensor<2x3xf32>, tensor<2xsi32>) -> tensor<2x3xf32>
  func.return(%sliced, %updated) : (tensor<2x3xf32>, tensor<2x3xf32>) -> ()
}

// -----

// A smaller slice or update depends on the run-time starts, so neither folds.
// CHECK: func.func @partial
// CHECK: tensor.dynamic_slice
// CHECK: tensor.dynamic_update_slice
func.func @partial(%base: tensor<4x3xf32>, %update: tensor<2x3xf32>, %starts: tensor<2xsi32>) -> (tensor<2x3xf32>, tensor<4x3xf32>) {
  %sliced = tensor.dynamic_slice(%base, %starts) {sizes = [2, 3]} : (tensor<4x3xf32>, tensor<2xsi32>) -> tensor<2x3xf32>
  %updated = tensor.dynamic_update_slice(%base, %update, %starts) : (tensor<4x3xf32>, tensor<2x3xf32>, tensor<2xsi32>) -> tensor<4x3xf32>
  func.return(%sliced, %updated) : (tensor<2x3xf32>, tensor<4x3xf32>) -> ()
}
