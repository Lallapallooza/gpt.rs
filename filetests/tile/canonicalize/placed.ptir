// RUN: pass canonicalize

// A block placed in the loops of the block before it names its iterators as the first iterators
// of that block, by position: its iterator of one point stays, as the scheduled block's does.
// CHECK: tile.dispatch @placed([[INPUT:%[0-9]+]]: tensor<1x8xf32>) -> tensor<1x8xf32> {
// CHECK-NEXT: [[DOUBLED:%[0-9]+]] = tile.block([[INPUT]]) {iters = [par 1, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 1]} ({
// CHECK: [[SQUARED:%[0-9]+]] = tile.block([[DOUBLED]]) {iters = [par 1, par 8], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
// CHECK: func.return([[SQUARED]]) : (tensor<1x8xf32>) -> ()
tile.dispatch @placed(%input: tensor<1x8xf32>) -> tensor<1x8xf32> {
  %doubled = tile.block(%input) {iters = [par 1, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    %twice = arith.add(%element, %element) : (f32, f32) -> f32
    tile.yield(%twice) : (f32) -> ()
  }) : (tensor<1x8xf32>) -> tensor<1x8xf32>
  %squared = tile.block(%doubled) {iters = [par 1, par 8], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
  ^body(%value: f32):
    %square = arith.mul(%value, %value) : (f32, f32) -> f32
    tile.yield(%square) : (f32) -> ()
  }) : (tensor<1x8xf32>) -> tensor<1x8xf32>
  func.return(%squared) : (tensor<1x8xf32>) -> ()
}
func.func @main(%input: tensor<1x8xf32>) -> tensor<1x8xf32> {
  %squared = host.dispatch(%input) {callee = @placed} : (tensor<1x8xf32>) -> tensor<1x8xf32>
  func.return(%squared) : (tensor<1x8xf32>) -> ()
}

// -----

// The first block of a run, without loops of its own, keeps its iterator of one point too: the
// block placed after it names its iterators by position.
// CHECK: tile.dispatch @run_head([[INPUT:%[0-9]+]]: tensor<1x8xf32>) -> tensor<1x8xf32> {
// CHECK-NEXT: [[DOUBLED:%[0-9]+]] = tile.block([[INPUT]]) {iters = [par 1, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
// CHECK: [[SQUARED:%[0-9]+]] = tile.block([[DOUBLED]]) {iters = [par 1, par 8], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
// CHECK: func.return([[SQUARED]]) : (tensor<1x8xf32>) -> ()
tile.dispatch @run_head(%input: tensor<1x8xf32>) -> tensor<1x8xf32> {
  %doubled = tile.block(%input) {iters = [par 1, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    %twice = arith.add(%element, %element) : (f32, f32) -> f32
    tile.yield(%twice) : (f32) -> ()
  }) : (tensor<1x8xf32>) -> tensor<1x8xf32>
  %squared = tile.block(%doubled) {iters = [par 1, par 8], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1]]} ({
  ^body(%value: f32):
    %square = arith.mul(%value, %value) : (f32, f32) -> f32
    tile.yield(%square) : (f32) -> ()
  }) : (tensor<1x8xf32>) -> tensor<1x8xf32>
  func.return(%squared) : (tensor<1x8xf32>) -> ()
}
func.func @main(%input: tensor<1x8xf32>) -> tensor<1x8xf32> {
  %squared = host.dispatch(%input) {callee = @run_head} : (tensor<1x8xf32>) -> tensor<1x8xf32>
  func.return(%squared) : (tensor<1x8xf32>) -> ()
}
