// ERROR: tile.block: read 0 names operand $1, but the block has 1 operands
func.func @missing_operand(%input: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%input) {iters = [par 4], reads = [$1[d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

