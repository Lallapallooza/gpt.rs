// -----
// ERROR: tensor.extract_patches: patch size overflows
func.func @patches_size_overflow(%input: tensor<1x1x1x1xf32>) -> tensor<1x2x2x1xf32> {
  %patches = tensor.extract_patches(%input) {window = [4294967296, 4294967296], strides = [1, 1], dilation = [1, 1], padding = [(4294967296, 0), (4294967296, 0)], pad_value = 0.0} : (tensor<1x1x1x1xf32>) -> tensor<1x2x2x1xf32>
  func.return(%patches) : (tensor<1x2x2x1xf32>) -> ()
}

// -----
// ERROR: tensor.extract_patches: pad_value 0.5 is not representable in si32
func.func @patches_fractional_pad(%input: tensor<1x4x4x1xsi32>) -> tensor<1x4x4x9xsi32> {
  %patches = tensor.extract_patches(%input) {window = [3, 3], strides = [1, 1], dilation = [1, 1], padding = [(1, 1), (1, 1)], pad_value = 0.5} : (tensor<1x4x4x1xsi32>) -> tensor<1x4x4x9xsi32>
  func.return(%patches) : (tensor<1x4x4x9xsi32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_max: tensor<{N}x4xf32> has a dynamic dimension
func.func @window_dynamic(%input: tensor<{N}x4xf32>) -> tensor<{N}x2xf32> {
  %max = tensor.reduce_window_max(%input) {window_dims = [1, 3], strides = [1, 1], padding = [(0, 0), (0, 0)], base_dilation = [1, 1], window_dilation = [1, 1]} : (tensor<{N}x4xf32>) -> tensor<{N}x2xf32>
  func.return(%max) : (tensor<{N}x2xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_max: window_dims [2] has rank 1, but the input has rank 2
