// RUN: pass prune-params

// A parameter argument that nothing reads goes. A run-time argument stays even when nothing reads
// it, so the run-time arguments keep their positions.
// CHECK: func.func @unread([[INPUT:%[0-9]+]]: tensor<4xf32>, [[UNREAD_INPUT:%[0-9]+]]: tensor<4xf32>, [[WEIGHT:%[0-9]+]]: tensor<4xf32> {param = 2}) -> tensor<4xf32>
// CHECK-NEXT: tensor.add([[INPUT]], [[WEIGHT]])
func.func @unread(%input: tensor<4xf32>, %unread_weight: tensor<4xf32> {param = 1}, %unread_input: tensor<4xf32>, %weight: tensor<4xf32> {param = 2}) -> tensor<4xf32> {
  %sum = tensor.add(%input, %weight) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%sum) : (tensor<4xf32>) -> ()
}

// -----
// A function whose parameters all go keeps only its run-time arguments.
// CHECK: func.func @none_read([[INPUT:%[0-9]+]]: tensor<4xf32>) -> tensor<4xf32>
// CHECK-NEXT: tensor.neg([[INPUT]])
func.func @none_read(%input: tensor<4xf32>, %weight: tensor<4xf32> {param = 1}, %indices: tensor<2xsi32> {param = 2}) -> tensor<4xf32> {
  %negated = tensor.neg(%input) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%negated) : (tensor<4xf32>) -> ()
}

// -----
// A load-time function loses the parameters it does not read too.
// CHECK: func.func @run([[INPUT:%[0-9]+]]: tensor<4xf32>, [[EXP_WEIGHT:%[0-9]+]]: tensor<4xf32> {param = 3}) -> tensor<4xf32>
// CHECK: func.func @load([[WEIGHT:%[0-9]+]]: tensor<4xf32> {param = 1}) -> (tensor<4xf32> {param = 3})
// CHECK-NEXT: tensor.exp([[WEIGHT]])
func.func @run(%input: tensor<4xf32>, %exp_weight: tensor<4xf32> {param = 3}) -> tensor<4xf32> {
  %product = tensor.mul(%input, %exp_weight) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%product) : (tensor<4xf32>) -> ()
}
func.func @load(%weight: tensor<4xf32> {param = 1}, %unread_weight: tensor<4xf32> {param = 2}) -> (tensor<4xf32> {param = 3}) {
  %exp_weight = tensor.exp(%weight) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%exp_weight) : (tensor<4xf32>) -> ()
}
