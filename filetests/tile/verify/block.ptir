// ERROR: tile.block: the operands of read 0 differ in type: tensor<4xf32> and tensor<8xf32>
func.func @list_of_types(%first: tensor<4xf32>, %second: tensor<8xf32>) -> tensor<4xf32> {
  %output = tile.block(%first, %second) {iters = [par 4], reads = [$0..$1[0][d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>, tensor<8xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: fold 0 has 1 writes, but argmax gives 2 results
func.func @argmax_one_write(%scores: tensor<4x4xf32>) -> tensor<4xf32> {
  %best = tile.block(%scores) {iters = [par 4, red 4], reads = [$0[d0, d1]], folds = [argmax -> [d0]]} ({
  ^body(%score: f32):
    %index = tile.index() {expr = d1, dtype = si64} : () -> si64
    tile.yield(%score, %index) : (f32, si64) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4xf32>
  func.return(%best) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: write 0 updates $1, but the block has 1 operands
func.func @update_missing(%input: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%input) {iters = [par 4], reads = [$0[d0]], folds = [none -> $1[d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

