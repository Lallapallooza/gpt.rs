  func.return(%max) : (tensor<3x4xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_max: strides [1] has rank 1, but the input has rank 2
func.func @window_strides_rank(%input: tensor<4x4xf32>) -> tensor<3x4xf32> {
