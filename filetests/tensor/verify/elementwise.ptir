func.func @compare_mismatch(%0: tensor<4xf32>, %1: tensor<4xsi32>) -> tensor<4xi1> {
  %2 = tensor.compare(%0, %1) {kind = less} : (tensor<4xf32>, tensor<4xsi32>) -> tensor<4xi1>
  func.return(%2) : (tensor<4xi1>) -> ()
}

