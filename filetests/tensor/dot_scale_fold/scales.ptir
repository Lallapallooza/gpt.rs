// RUN: pass dot-scale-fold

// A static scale of a dot's result moves into the weight, laid out along the weight's free axis.
// ROUNDING: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @scale
// CHECK-NEXT: [[R:%[0-9]+]] = tensor.reshape(%2) {shape = [1, 4]}
// CHECK-NEXT: [[B:%[0-9]+]] = tensor.broadcast_to([[R]]) {shape = [3, 4]}
// CHECK-NEXT: [[W:%[0-9]+]] = tensor.mul(%1, [[B]])
// CHECK-NEXT: [[D:%[0-9]+]] = tensor.dot_general(%0, [[W]]) {contract_lhs = [1], contract_rhs = [0]}
// CHECK-NEXT: func.return([[D]])
func.func @scale(%0: tensor<2x3xf32>, %1: tensor<3x4xf32> {param = 1}, %2: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// With batch axes, the free axes of the weight still end the result.
// ROUNDING: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @batched
// CHECK-NEXT: [[R:%[0-9]+]] = tensor.reshape(%2) {shape = [1, 1, 4]}
// CHECK-NEXT: [[B:%[0-9]+]] = tensor.broadcast_to([[R]]) {shape = [2, 5, 4]}
// CHECK-NEXT: [[W:%[0-9]+]] = tensor.mul(%1, [[B]])
// CHECK-NEXT: tensor.dot_general(%0, [[W]]) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]}
func.func @batched(%0: tensor<2x3x5xf32>, %1: tensor<2x5x4xf32> {param = 1}, %2: tensor<4xf32> {param = 2}) -> tensor<2x3x4xf32> {
  %3 = tensor.dot_general(%0, %1) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]} : (tensor<2x3x5xf32>, tensor<2x5x4xf32>) -> tensor<2x3x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 3, 4]} : (tensor<4xf32>) -> tensor<2x3x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x3x4xf32>, tensor<2x3x4xf32>) -> tensor<2x3x4xf32>
  func.return(%5) : (tensor<2x3x4xf32>) -> ()
}

// -----

// The scale stays outside the dot when it varies along an axis of `x`.
// CHECK: func.func @along_x
// CHECK: tensor.mul(%3, %4)
func.func @along_x(%0: tensor<2x3xf32>, %1: tensor<3x4xf32> {param = 1}, %2: tensor<2x1xf32> {param = 2}) -> tensor<2x4xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<2x1xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// A run-time weight would be scaled on every run.
// CHECK: func.func @run_time_weight
// CHECK: tensor.mul(%3, %4)
func.func @run_time_weight(%0: tensor<2x3xf32>, %1: tensor<3x4xf32>, %2: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// Scaling a weight cast from a narrower dtype would store a widened copy of it.
// CHECK: func.func @cast_weight
// CHECK: tensor.mul(%4, %5)
func.func @cast_weight(%0: tensor<2x3xf32>, %1: tensor<3x4xbf16> {param = 1}, %2: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %3 = tensor.cast(%1) {to = f32} : (tensor<3x4xbf16>) -> tensor<3x4xf32>
  %4 = tensor.dot_general(%0, %3) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %5 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %6 = tensor.mul(%4, %5) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%6) : (tensor<2x4xf32>) -> ()
}

// -----

// Another use of the unscaled product needs it as it is.
// CHECK: func.func @shared_product
// CHECK: tensor.mul(%3, %4)
func.func @shared_product(%0: tensor<2x3xf32>, %1: tensor<3x4xf32> {param = 1}, %2: tensor<4xf32> {param = 2}) -> (tensor<2x4xf32>, tensor<2x4xf32>) {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5, %3) : (tensor<2x4xf32>, tensor<2x4xf32>) -> ()
}

// -----

// A scale computed at run time would scale the weight on every run.
// CHECK: func.func @run_time_scale
// CHECK: tensor.mul(%3, %4)
func.func @run_time_scale(%0: tensor<2x3xf32>, %1: tensor<3x4xf32> {param = 1}, %2: tensor<4xf32>) -> tensor<2x4xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// A constant weight keeps the multiply: its scaled copy would add a stored parameter as large as
// the weight, instead of replacing one.
// CHECK: func.func @constant_weight
// CHECK: tensor.mul(%3, %4)
func.func @constant_weight(%0: tensor<2x3xf32>, %1: tensor<4xf32> {param = 1}) -> tensor<2x4xf32> {
  %2 = tensor.constant() {value = dense<[3, 4] x f32: 0.5>} : () -> tensor<3x4xf32>
  %3 = tensor.dot_general(%0, %2) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4xf32>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%1) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// A bf16 weight of a dot with an f32 result keeps the f32 multiply: scaling the weight would round
// in bf16.
// CHECK: func.func @widening_dot
// CHECK: tensor.mul(%3, %4)
func.func @widening_dot(%0: tensor<2x3xbf16>, %1: tensor<3x4xbf16> {param = 1}, %2: tensor<4xf32> {param = 2}) -> tensor<2x4xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0], out = f32} : (tensor<2x3xbf16>, tensor<3x4xbf16>) -> tensor<2x4xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4]} : (tensor<4xf32>) -> tensor<2x4xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
  func.return(%5) : (tensor<2x4xf32>) -> ()
}

// -----

// A scale along the last of two free axes of the weight.
// ROUNDING: the scale rounds into every weight before the sum, instead of into the sum once
// CHECK: func.func @two_free
// CHECK-NEXT: tensor.reshape(%2) {shape = [1, 1, 5]}
func.func @two_free(%0: tensor<2x3xf32>, %1: tensor<3x4x5xf32> {param = 1}, %2: tensor<5xf32> {param = 2}) -> tensor<2x4x5xf32> {
  %3 = tensor.dot_general(%0, %1) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x4x5xf32>) -> tensor<2x4x5xf32>
  %4 = tensor.broadcast_to(%2) {shape = [2, 4, 5]} : (tensor<5xf32>) -> tensor<2x4x5xf32>
  %5 = tensor.mul(%3, %4) : (tensor<2x4x5xf32>, tensor<2x4x5xf32>) -> tensor<2x4x5xf32>
  func.return(%5) : (tensor<2x4x5xf32>) -> ()
}
