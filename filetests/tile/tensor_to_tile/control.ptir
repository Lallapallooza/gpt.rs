// RUN: pass tensor-to-tile

// Control flow stays, with the ops of its regions converted.
// CHECK: func.func @cond([[PREDICATE:%[0-9]+]]: tensor<i1>, [[INPUT:%[0-9]+]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK: tensor.cond([[PREDICATE]], [[INPUT]])
// CHECK-NEXT: ^then_branch([[THEN_INPUT:%[0-9]+]]: tensor<4xf32>):
// CHECK: tile.block([[THEN_INPUT]])
// CHECK: arith.neg
// CHECK: tensor.yield
// CHECK-NOT: tensor.neg
func.func @cond(%predicate: tensor<i1>, %input: tensor<4xf32>) -> tensor<4xf32> {
  %result = tensor.cond(%predicate, %input) {results = [tensor<4xf32>]} ({
  ^then_branch(%then_input: tensor<4xf32>):
    %negated = tensor.neg(%then_input) : (tensor<4xf32>) -> tensor<4xf32>
    tensor.yield(%negated) : (tensor<4xf32>) -> ()
  }, {
  ^else_branch(%else_input: tensor<4xf32>):
    tensor.yield(%else_input) : (tensor<4xf32>) -> ()
  }) : (tensor<i1>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%result) : (tensor<4xf32>) -> ()
}

// -----
// Control flow stays, with the ops of its body converted.
// CHECK: func.func @scan([[INIT:%[0-9]+]]: tensor<4xf32>, [[SEQUENCE:%[0-9]+]]: tensor<6x4xf32>) -> (tensor<4xf32>, tensor<6x4xf32>) {
// CHECK: tensor.scan([[INIT]], [[SEQUENCE]]) {carry_count = 1, outputs = [tensor<4xf32>]}
// CHECK-NEXT: ^body([[CARRY:%[0-9]+]]: tensor<4xf32>, [[ROW:%[0-9]+]]: tensor<4xf32>):
// CHECK: [[NEXT:%[0-9]+]] = tile.block([[CARRY]], [[ROW]])
// CHECK: tensor.yield([[NEXT]], [[NEXT]]) : (tensor<4xf32>, tensor<4xf32>) -> ()
// CHECK-NOT: tensor.add
func.func @scan(%init: tensor<4xf32>, %sequence: tensor<6x4xf32>) -> (tensor<4xf32>, tensor<6x4xf32>) {
  %final, %outputs = tensor.scan(%init, %sequence) {carry_count = 1, outputs = [tensor<4xf32>]} ({
  ^body(%carry: tensor<4xf32>, %row: tensor<4xf32>):
    %next = tensor.add(%carry, %row) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
    tensor.yield(%next, %next) : (tensor<4xf32>, tensor<4xf32>) -> ()
  }) : (tensor<4xf32>, tensor<6x4xf32>) -> (tensor<4xf32>, tensor<6x4xf32>)
  func.return(%final, %outputs) : (tensor<4xf32>, tensor<6x4xf32>) -> ()
}

// -----
// A loop that counts from 0 to 10.
// CHECK: tensor.while
// CHECK: arith.less
// CHECK: tensor.yield
// CHECK: arith.add
// CHECK-NOT: tensor.add
func.func @while_bounded(%input: tensor<4xf32>) -> (tensor<si32>, tensor<4xf32>) {
  %zero = tensor.constant() {value = dense<si32: 0>} : () -> tensor<si32>
  %count, %result = tensor.while(%zero, %input) ({
  ^cond(%cond_count: tensor<si32>, %cond_value: tensor<4xf32>):
    %ten = tensor.constant() {value = dense<si32: 10>} : () -> tensor<si32>
    %below_ten = tensor.less(%cond_count, %ten) : (tensor<si32>, tensor<si32>) -> tensor<i1>
    tensor.yield(%below_ten, %cond_count, %cond_value) : (tensor<i1>, tensor<si32>, tensor<4xf32>) -> ()
  }, {
  ^body(%body_count: tensor<si32>, %body_value: tensor<4xf32>):
    %one = tensor.constant() {value = dense<si32: 1>} : () -> tensor<si32>
    %next_count = tensor.add(%body_count, %one) : (tensor<si32>, tensor<si32>) -> tensor<si32>
    %doubled = tensor.add(%body_value, %body_value) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
    tensor.yield(%next_count, %doubled) : (tensor<si32>, tensor<4xf32>) -> ()
  }) : (tensor<si32>, tensor<4xf32>) -> (tensor<si32>, tensor<4xf32>)
  func.return(%count, %result) : (tensor<si32>, tensor<4xf32>) -> ()
}
