// RUN: pass tensor-to-tile

// Element `i` draws word block `i` of the stream; the new state advances the counter.
// CHECK: func.func @rng([[STATE:%[0-9]+]]: tensor<2xui64>) -> (tensor<2x3xf32>, tensor<4xbf16>, tensor<2xui64>, tensor<4xui32>) {
// CHECK: tile.block([[STATE]]) {iters = [par 2, par 3], reads = [$0[0], $0[1]], folds = [none -> [d0, d1]]}
// CHECK-NEXT: ^body([[KEY:%[0-9]+]]: ui64, [[COUNTER:%[0-9]+]]: ui64):
// CHECK: tile.index() {expr = d0 * 3 + d1, dtype = ui64}
// CHECK-NEXT: arith.rng_uniform([[KEY]], [[COUNTER]], {{%[0-9]+}}) {dtype = f32}
// CHECK: tile.index() {expr = 2, dtype = ui64}
// CHECK: arith.rng_normal
// CHECK-NOT: tensor.
func.func @rng(%state: tensor<2xui64>) -> (tensor<2x3xf32>, tensor<4xbf16>, tensor<2xui64>, tensor<4xui32>) {
  %uniform_state, %uniform = tensor.rng_uniform(%state) {shape = [2, 3], dtype = f32} : (tensor<2xui64>) -> (tensor<2xui64>, tensor<2x3xf32>)
  %normal_state, %normal = tensor.rng_normal(%uniform_state) {shape = [4], dtype = bf16} : (tensor<2xui64>) -> (tensor<2xui64>, tensor<4xbf16>)
  %final_state, %words = tensor.rng_uniform(%normal_state) {shape = [4], dtype = ui32} : (tensor<2xui64>) -> (tensor<2xui64>, tensor<4xui32>)
  func.return(%uniform, %normal, %final_state, %words) : (tensor<2x3xf32>, tensor<4xbf16>, tensor<2xui64>, tensor<4xui32>) -> ()
}
