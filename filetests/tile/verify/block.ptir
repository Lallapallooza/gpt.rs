// ERROR: tile.block: read 0 names operand $2, but the block has 2 operands
func.func @list_past_operands(%first: tensor<4xf32>, %second: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%first, %second) {iters = [par 4], reads = [$0..$2[0][d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

