// ERROR: tensor.cond: region 1 yields (tensor<2x2xf32>), expected (tensor<4xf32>)
func.func @cond_yield(%0: tensor<i1>, %1: tensor<4xf32>) -> tensor<4xf32> {
  %2 = tensor.cond(%0, %1) {results = [tensor<4xf32>]} ({
  ^then_branch(%3: tensor<4xf32>):
    tensor.yield(%3) : (tensor<4xf32>) -> ()
