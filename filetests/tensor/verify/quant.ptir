// RUN: verify

// ERROR: tensor.dequantize: the scale must have the extents [4, 2] for block [1, 32], got tensor<4x3xe8m0>
func.func @dequantize_scale_extents(%codes: tensor<4x64xf4e2m1>, %scale: tensor<4x3xe8m0>) -> tensor<4x64xf32> {
  %dequantized = tensor.dequantize(%codes, %scale) {block = [1, 32], to = f32} : (tensor<4x64xf4e2m1>, tensor<4x3xe8m0>) -> tensor<4x64xf32>
  func.return(%dequantized) : (tensor<4x64xf32>) -> ()
}

// -----

// ERROR: tensor.dequantize: quantized must be an integer, narrow float or float tensor, got tensor<4x64xe8m0>
func.func @dequantize_scales(%codes: tensor<4x64xe8m0>, %scale: tensor<4x2xe8m0>) -> tensor<4x64xf32> {
  %dequantized = tensor.dequantize(%codes, %scale) {block = [1, 32], to = f32} : (tensor<4x64xe8m0>, tensor<4x2xe8m0>) -> tensor<4x64xf32>
  func.return(%dequantized) : (tensor<4x64xf32>) -> ()
}

// -----

// ERROR: tensor.quantize: block [32] must have one extent per axis of rank 2
func.func @quantize_block_rank(%input: tensor<4x64xf32>, %scale: tensor<4x2xf32>) -> tensor<4x64xf4e2m1> {
  %codes = tensor.quantize(%input, %scale) {block = [32], to = f4e2m1} : (tensor<4x64xf32>, tensor<4x2xf32>) -> tensor<4x64xf4e2m1>
  func.return(%codes) : (tensor<4x64xf4e2m1>) -> ()
}

// -----

// ERROR: tensor.quantize: to must be an integer or narrow float dtype, got bf16
func.func @quantize_to_float(%input: tensor<4x64xf32>, %scale: tensor<4x2xf32>) -> tensor<4x64xbf16> {
  %codes = tensor.quantize(%input, %scale) {block = [1, 32], to = bf16} : (tensor<4x64xf32>, tensor<4x2xf32>) -> tensor<4x64xbf16>
  func.return(%codes) : (tensor<4x64xbf16>) -> ()
}

// -----

// ERROR: tensor.block_scale_amax: e8m0 scales are powers of two, which this op does not give
func.func @amax_e8m0(%input: tensor<4x64xf32>) -> tensor<4x2xe8m0> {
  %scale = tensor.block_scale_amax(%input) {block = [1, 32], to = si8, scale_dtype = e8m0} : (tensor<4x64xf32>) -> tensor<4x2xe8m0>
  func.return(%scale) : (tensor<4x2xe8m0>) -> ()
}

// -----

// ERROR: tensor.block_scale_amax: a block of 2 needs a static extent, got {T}
func.func @scale_block_extent(%input: tensor<{T}x64xf32>) -> tensor<{T}x64xf32> {
  %scale = tensor.block_scale_amax(%input) {block = [2, 1], to = f4e2m1, scale_dtype = f32} : (tensor<{T}x64xf32>) -> tensor<{T}x64xf32>
  func.return(%scale) : (tensor<{T}x64xf32>) -> ()
}

// -----

// ERROR: tensor.quantize_stochastic: the random bits must be tensor<8x16xui32>, got tensor<8x16xsi32>
func.func @random_dtype(%input: tensor<8x16xf32>, %scale: tensor<8x1xf32>, %random_bits: tensor<8x16xsi32>) -> tensor<8x16xf8e4m3> {
  %codes = tensor.quantize_stochastic(%input, %scale, %random_bits) {block = [1, 16], to = f8e4m3} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<8x16xsi32>) -> tensor<8x16xf8e4m3>
  func.return(%codes) : (tensor<8x16xf8e4m3>) -> ()
}

// -----

// ERROR: tensor.quantize_table: to must be an integer dtype, got f4e2m1
func.func @table_float_codes(%input: tensor<4x64xf32>, %scale: tensor<4x2xf16>, %table: tensor<16xf32>) -> tensor<4x64xf4e2m1> {
  %codes = tensor.quantize_table(%input, %scale, %table) {block = [1, 32], to = f4e2m1} : (tensor<4x64xf32>, tensor<4x2xf16>, tensor<16xf32>) -> tensor<4x64xf4e2m1>
  func.return(%codes) : (tensor<4x64xf4e2m1>) -> ()
}

// -----

// ERROR: tensor.quantize_table: the table must have rank 1, got tensor<4x4xf32>
func.func @table_rank(%input: tensor<4x64xf32>, %scale: tensor<4x2xf16>, %table: tensor<4x4xf32>) -> tensor<4x64xui4> {
  %codes = tensor.quantize_table(%input, %scale, %table) {block = [1, 32], to = ui4} : (tensor<4x64xf32>, tensor<4x2xf16>, tensor<4x4xf32>) -> tensor<4x64xui4>
  func.return(%codes) : (tensor<4x64xui4>) -> ()
}

// -----

// ERROR: tensor.dequantize: the offset must have the scale's extents, got tensor<4x1xf16> and tensor<4x2xf16>
func.func @offset_extents(%codes: tensor<4x64xui4>, %scale: tensor<4x2xf16>, %offset: tensor<4x1xf16>) -> tensor<4x64xbf16> {
  %dequantized = tensor.dequantize(%codes, %scale, %offset) {block = [1, 32], to = bf16} : (tensor<4x64xui4>, tensor<4x2xf16>, tensor<4x1xf16>) -> tensor<4x64xbf16>
  func.return(%dequantized) : (tensor<4x64xbf16>) -> ()
}

// -----

// ERROR: tensor.dequantize: the offset must be a float tensor, got tensor<4x2xe8m0>
func.func @offset_dtype(%codes: tensor<4x64xui4>, %scale: tensor<4x2xf16>, %offset: tensor<4x2xe8m0>) -> tensor<4x64xbf16> {
  %dequantized = tensor.dequantize(%codes, %scale, %offset) {block = [1, 32], to = bf16} : (tensor<4x64xui4>, tensor<4x2xf16>, tensor<4x2xe8m0>) -> tensor<4x64xbf16>
  func.return(%dequantized) : (tensor<4x64xbf16>) -> ()
}

// -----

// ERROR: tensor.block_scale_range: scale_dtype must be a float dtype, got e8m0
func.func @range_e8m0(%input: tensor<4x64xf32>) -> (tensor<4x2xe8m0>, tensor<4x2xe8m0>) {
  %scale, %offset = tensor.block_scale_range(%input) {block = [1, 32], to = ui8, scale_dtype = e8m0} : (tensor<4x64xf32>) -> (tensor<4x2xe8m0>, tensor<4x2xe8m0>)
  func.return(%scale, %offset) : (tensor<4x2xe8m0>, tensor<4x2xe8m0>) -> ()
}
