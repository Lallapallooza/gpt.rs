// RUN: roundtrip

// CHECK: func.func @linear_bias_gelu([[INPUT:%[0-9]+]]: tensor<{M}x8xf32>, [[WEIGHT:%[0-9]+]]: tensor<6x8xbf16>, [[BIAS:%[0-9]+]]: tensor<6xf32>) -> tensor<{M}x6xf32> {
// CHECK-NEXT: [[PROJECTION:%[0-9]+]] = tile.block([[INPUT]], [[WEIGHT]]) {iters = [par {M}, par 6, red 8], reads = [$0[d0, d2], $1[d1, d2]], folds = [sum -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[ACTIVATION:%[0-9]+]]: f32, [[WEIGHT_ELEMENT:%[0-9]+]]: bf16):
// CHECK-NEXT: [[WIDENED_WEIGHT:%[0-9]+]] = arith.cast([[WEIGHT_ELEMENT]]) {to = f32} : (bf16) -> f32
// CHECK-NEXT: [[PRODUCT:%[0-9]+]] = arith.mul([[ACTIVATION]], [[WIDENED_WEIGHT]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[PRODUCT]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{M}x8xf32>, tensor<6x8xbf16>) -> tensor<{M}x6xf32>
// CHECK-NEXT: [[ACTIVATED:%[0-9]+]] = tile.block([[PROJECTION]], [[BIAS]]) {iters = [par {M}, par 6], reads = [$0[d0, d1], $1[d1]], folds = [none -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[DOT:%[0-9]+]]: f32, [[BIAS_ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: [[BIASED:%[0-9]+]] = arith.add([[DOT]], [[BIAS_ELEMENT]]) : (f32, f32) -> f32
// CHECK-NEXT: [[INV_SQRT_TWO:%[0-9]+]] = arith.constant() {value = 0.70710677 : f32} : () -> f32
// CHECK-NEXT: [[SCALED:%[0-9]+]] = arith.mul([[BIASED]], [[INV_SQRT_TWO]]) : (f32, f32) -> f32
// CHECK-NEXT: [[ERF:%[0-9]+]] = arith.erf([[SCALED]]) : (f32) -> f32
// CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant() {value = 1.0 : f32} : () -> f32
// CHECK-NEXT: [[ERF_PLUS_ONE:%[0-9]+]] = arith.add([[ERF]], [[ONE]]) : (f32, f32) -> f32
// CHECK-NEXT: [[HALF:%[0-9]+]] = arith.constant() {value = 0.5 : f32} : () -> f32
// CHECK-NEXT: [[HALF_BIASED:%[0-9]+]] = arith.mul([[BIASED]], [[HALF]]) : (f32, f32) -> f32
// CHECK-NEXT: [[GELU:%[0-9]+]] = arith.mul([[HALF_BIASED]], [[ERF_PLUS_ONE]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[GELU]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{M}x6xf32>, tensor<6xf32>) -> tensor<{M}x6xf32>
// CHECK-NEXT: func.return([[ACTIVATED]]) : (tensor<{M}x6xf32>) -> ()
// CHECK-NEXT: }
func.func @linear_bias_gelu(%input: tensor<{M}x8xf32>, %weight: tensor<6x8xbf16>, %bias: tensor<6xf32>) -> tensor<{M}x6xf32> {
  %projection = tile.block(%input, %weight) {iters = [par {M}, par 6, red 8], reads = [$0[d0, d2], $1[d1, d2]], folds = [sum -> [d0, d1]]} ({
  ^body(%activation: f32, %weight_element: bf16):
    %widened_weight = arith.cast(%weight_element) {to = f32} : (bf16) -> f32
    %product = arith.mul(%activation, %widened_weight) : (f32, f32) -> f32
    tile.yield(%product) : (f32) -> ()
  }) : (tensor<{M}x8xf32>, tensor<6x8xbf16>) -> tensor<{M}x6xf32>
  %activated = tile.block(%projection, %bias) {iters = [par {M}, par 6], reads = [$0[d0, d1], $1[d1]], folds = [none -> [d0, d1]]} ({
  ^body(%dot: f32, %bias_element: f32):
    %biased = arith.add(%dot, %bias_element) : (f32, f32) -> f32
    %inv_sqrt_two = arith.constant() {value = 0.70710677 : f32} : () -> f32
    %scaled = arith.mul(%biased, %inv_sqrt_two) : (f32, f32) -> f32
    %erf = arith.erf(%scaled) : (f32) -> f32
    %one = arith.constant() {value = 1.0 : f32} : () -> f32
    %erf_plus_one = arith.add(%erf, %one) : (f32, f32) -> f32
    %half = arith.constant() {value = 0.5 : f32} : () -> f32
    %half_biased = arith.mul(%biased, %half) : (f32, f32) -> f32
    %gelu = arith.mul(%half_biased, %erf_plus_one) : (f32, f32) -> f32
    tile.yield(%gelu) : (f32) -> ()
  }) : (tensor<{M}x6xf32>, tensor<6xf32>) -> tensor<{M}x6xf32>
  func.return(%activated) : (tensor<{M}x6xf32>) -> ()
}

// -----

// Folds of every kind: argmax and top_k over the last axis, an ordered sum, and the
// logical folds.
// CHECK: func.func @folds([[SCORES:%[0-9]+]]: tensor<2x5xf32>, [[FLAGS:%[0-9]+]]: tensor<2x5xi1>) -> (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>, tensor<2xf32>, tensor<2xf32>, tensor<2xf32>, tensor<2xi1>, tensor<2xi1>) {
// CHECK-NEXT: [[ARGMAX_VALUE:%[0-9]+]], [[ARGMAX_INDEX:%[0-9]+]], [[ARGMIN_VALUE:%[0-9]+]], [[ARGMIN_INDEX:%[0-9]+]], [[TOP_VALUES:%[0-9]+]], [[TOP_INDICES:%[0-9]+]] = tile.block([[SCORES]]) {iters = [par 2, red 5], reads = [$0[d0, d1]], folds = [argmax -> ([d0], [d0]), argmin -> ([d0], [d0]), top_k<k = 3> -> ([d0], [d0])]} ({
// CHECK-NEXT: ^body([[SCORE:%[0-9]+]]: f32):
// CHECK-NEXT: [[INDEX:%[0-9]+]] = tile.index() {expr = d1, dtype = si32} : () -> si32
// CHECK-NEXT: [[WIDE_INDEX:%[0-9]+]] = tile.index() {expr = d1, dtype = si64} : () -> si64
// CHECK-NEXT: tile.yield([[SCORE]], [[INDEX]], [[SCORE]], [[WIDE_INDEX]], [[SCORE]], [[INDEX]]) : (f32, si32, f32, si64, f32, si32) -> ()
// CHECK-NEXT: }) : (tensor<2x5xf32>) -> (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>)
// CHECK-NEXT: [[SUM:%[0-9]+]], [[MAX:%[0-9]+]], [[MIN:%[0-9]+]] = tile.block([[SCORES]]) {iters = [par 2, red_ordered 5], reads = [$0[d0, d1]], folds = [sum -> [d0], max -> [d0], min -> [d0]]} ({
// CHECK-NEXT: ^body([[SCORE:%[0-9]+]]: f32):
// CHECK-NEXT: tile.yield([[SCORE]], [[SCORE]], [[SCORE]]) : (f32, f32, f32) -> ()
// CHECK-NEXT: }) : (tensor<2x5xf32>) -> (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>)
// CHECK-NEXT: [[ALL:%[0-9]+]], [[ANY:%[0-9]+]] = tile.block([[FLAGS]]) {iters = [par 2, red 5], reads = [$0[d0, d1]], folds = [and -> [d0], or -> [d0]]} ({
// CHECK-NEXT: ^body([[FLAG:%[0-9]+]]: i1):
// CHECK-NEXT: tile.yield([[FLAG]], [[FLAG]]) : (i1, i1) -> ()
// CHECK-NEXT: }) : (tensor<2x5xi1>) -> (tensor<2xi1>, tensor<2xi1>)
// CHECK-NEXT: func.return([[ARGMAX_VALUE]], [[ARGMAX_INDEX]], [[ARGMIN_VALUE]], [[ARGMIN_INDEX]], [[TOP_VALUES]], [[TOP_INDICES]], [[SUM]], [[MAX]], [[MIN]], [[ALL]], [[ANY]]) : (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>, tensor<2xf32>, tensor<2xf32>, tensor<2xf32>, tensor<2xi1>, tensor<2xi1>) -> ()
// CHECK-NEXT: }
func.func @folds(%scores: tensor<2x5xf32>, %flags: tensor<2x5xi1>) -> (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>, tensor<2xf32>, tensor<2xf32>, tensor<2xf32>, tensor<2xi1>, tensor<2xi1>) {
  %argmax_value, %argmax_index, %argmin_value, %argmin_index, %top_values, %top_indices = tile.block(%scores) {iters = [par 2, red 5], reads = [$0[d0, d1]], folds = [argmax -> ([d0], [d0]), argmin -> ([d0], [d0]), top_k<k = 3> -> ([d0], [d0])]} ({
  ^body(%score: f32):
    %index = tile.index() {expr = d1, dtype = si32} : () -> si32
    %wide_index = tile.index() {expr = d1, dtype = si64} : () -> si64
    tile.yield(%score, %index, %score, %wide_index, %score, %index) : (f32, si32, f32, si64, f32, si32) -> ()
  }) : (tensor<2x5xf32>) -> (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>)
  %sum, %max, %min = tile.block(%scores) {iters = [par 2, red_ordered 5], reads = [$0[d0, d1]], folds = [sum -> [d0], max -> [d0], min -> [d0]]} ({
  ^body(%score: f32):
    tile.yield(%score, %score, %score) : (f32, f32, f32) -> ()
  }) : (tensor<2x5xf32>) -> (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>)
  %all, %any = tile.block(%flags) {iters = [par 2, red 5], reads = [$0[d0, d1]], folds = [and -> [d0], or -> [d0]]} ({
  ^body(%flag: i1):
    tile.yield(%flag, %flag) : (i1, i1) -> ()
  }) : (tensor<2x5xi1>) -> (tensor<2xi1>, tensor<2xi1>)
  func.return(%argmax_value, %argmax_index, %argmin_value, %argmin_index, %top_values, %top_indices, %sum, %max, %min, %all, %any) : (tensor<2xf32>, tensor<2xsi32>, tensor<2xf32>, tensor<2xsi64>, tensor<2x3xf32>, tensor<2x3xsi32>, tensor<2xf32>, tensor<2xf32>, tensor<2xf32>, tensor<2xi1>, tensor<2xi1>) -> ()
}

// -----

// Causal attention for one head on its scores: the scaled scores fold with online softmax over the
// keys, the value's iterator `d1` drops from the states, and a sink starts each fold. The states
// merge, and the output is `o / l`.
// CHECK: func.func @attention([[SCORES:%[0-9]+]]: tensor<{T}x{S}xf32>, [[VALUE:%[0-9]+]]: tensor<{S}x8xf32>, [[SINK_MAX:%[0-9]+]]: tensor<{T}xf32>, [[SINK_SUM:%[0-9]+]]: tensor<{T}xf32>, [[SINK_ACCUMULATED:%[0-9]+]]: tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>, tensor<{T}x8xf32>) {
// CHECK-NEXT: [[MAX:%[0-9]+]], [[SUM:%[0-9]+]], [[ACCUMULATED:%[0-9]+]] = tile.block([[SCORES]], [[VALUE]], [[SINK_MAX]], [[SINK_SUM]], [[SINK_ACCUMULATED]]) {iters = [par {T}, par 8, red {S}], reads = [$0[d0, d2], $1[d2, d1]], folds = [online_softmax<value_iters = [d1]> -> ([d0], [d0], [d0, d1]) init ($2, $3, $4)], constraints = [d2 <= d0 or d2 < 4]} ({
// CHECK-NEXT: ^body([[SCORE:%[0-9]+]]: f32, [[VALUE_ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: [[SCALE:%[0-9]+]] = arith.constant() {value = 0.125 : f32} : () -> f32
// CHECK-NEXT: [[SCALED:%[0-9]+]] = arith.mul([[SCORE]], [[SCALE]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[SCALED]], [[VALUE_ELEMENT]]) : (f32, f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}x{S}xf32>, tensor<{S}x8xf32>, tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>)
// CHECK-NEXT: [[MERGED_MAX:%[0-9]+]], [[MERGED_SUM:%[0-9]+]], [[MERGED_ACCUMULATED:%[0-9]+]] = tile.block([[MAX]], [[SUM]], [[ACCUMULATED]]) {iters = [par {T}, par 8], reads = [$0[d0], $1[d0], $2[d0, d1]], folds = [online_softmax_merge<value_iters = [d1]> -> ([d0], [d0], [d0, d1])]} ({
// CHECK-NEXT: ^body([[PARTIAL_MAX:%[0-9]+]]: f32, [[PARTIAL_SUM:%[0-9]+]]: f32, [[PARTIAL_ACCUMULATED:%[0-9]+]]: f32):
// CHECK-NEXT: tile.yield([[PARTIAL_MAX]], [[PARTIAL_SUM]], [[PARTIAL_ACCUMULATED]]) : (f32, f32, f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>)
// CHECK-NEXT: [[OUTPUT:%[0-9]+]] = tile.block([[MERGED_SUM]], [[MERGED_ACCUMULATED]]) {iters = [par {T}, par 8], reads = [$0[d0], $1[d0, d1]], folds = [none -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[DENOMINATOR:%[0-9]+]]: f32, [[NUMERATOR:%[0-9]+]]: f32):
// CHECK-NEXT: [[NORMALIZED:%[0-9]+]] = arith.div([[NUMERATOR]], [[DENOMINATOR]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[NORMALIZED]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}xf32>, tensor<{T}x8xf32>) -> tensor<{T}x8xf32>
// CHECK-NEXT: func.return([[MAX]], [[SUM]], [[ACCUMULATED]], [[OUTPUT]]) : (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>, tensor<{T}x8xf32>) -> ()
// CHECK-NEXT: }
func.func @attention(%scores: tensor<{T}x{S}xf32>, %value: tensor<{S}x8xf32>, %sink_max: tensor<{T}xf32>, %sink_sum: tensor<{T}xf32>, %sink_accumulated: tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>, tensor<{T}x8xf32>) {
  %max, %sum, %accumulated = tile.block(%scores, %value, %sink_max, %sink_sum, %sink_accumulated) {iters = [par {T}, par 8, red {S}], reads = [$0[d0, d2], $1[d2, d1]], folds = [online_softmax<value_iters = [d1]> -> ([d0], [d0], [d0, d1]) init ($2, $3, $4)], constraints = [d2 <= d0 or d2 < 4]} ({
  ^body(%score: f32, %value_element: f32):
    %scale = arith.constant() {value = 0.125 : f32} : () -> f32
    %scaled = arith.mul(%score, %scale) : (f32, f32) -> f32
    tile.yield(%scaled, %value_element) : (f32, f32) -> ()
  }) : (tensor<{T}x{S}xf32>, tensor<{S}x8xf32>, tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>)
  %merged_max, %merged_sum, %merged_accumulated = tile.block(%max, %sum, %accumulated) {iters = [par {T}, par 8], reads = [$0[d0], $1[d0], $2[d0, d1]], folds = [online_softmax_merge<value_iters = [d1]> -> ([d0], [d0], [d0, d1])]} ({
  ^body(%partial_max: f32, %partial_sum: f32, %partial_accumulated: f32):
    tile.yield(%partial_max, %partial_sum, %partial_accumulated) : (f32, f32, f32) -> ()
  }) : (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>)
  %output = tile.block(%merged_sum, %merged_accumulated) {iters = [par {T}, par 8], reads = [$0[d0], $1[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%denominator: f32, %numerator: f32):
    %normalized = arith.div(%numerator, %denominator) : (f32, f32) -> f32
    tile.yield(%normalized) : (f32) -> ()
  }) : (tensor<{T}xf32>, tensor<{T}x8xf32>) -> tensor<{T}x8xf32>
  func.return(%max, %sum, %accumulated, %output) : (tensor<{T}xf32>, tensor<{T}xf32>, tensor<{T}x8xf32>, tensor<{T}x8xf32>) -> ()
}

// -----

// The partition function of the logits: the state, merged with itself, and `m + log(l)`.
// CHECK: func.func @logsumexp([[LOGITS:%[0-9]+]]: tensor<2x16xf32>) -> (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>) {
// CHECK-NEXT: [[MAX:%[0-9]+]], [[SUM:%[0-9]+]] = tile.block([[LOGITS]]) {iters = [par 2, red 16], reads = [$0[d0, d1]], folds = [logsumexp -> ([d0], [d0])]} ({
// CHECK-NEXT: ^body([[LOGIT:%[0-9]+]]: f32):
// CHECK-NEXT: tile.yield([[LOGIT]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<2x16xf32>) -> (tensor<2xf32>, tensor<2xf32>)
// CHECK-NEXT: [[MERGED_MAX:%[0-9]+]], [[MERGED_SUM:%[0-9]+]] = tile.block([[MAX]], [[SUM]]) {iters = [par 2, red 2], reads = [$0[d0], $1[d0]], folds = [logsumexp_merge -> ([d0], [d0])]} ({
// CHECK-NEXT: ^body([[PARTIAL_MAX:%[0-9]+]]: f32, [[PARTIAL_SUM:%[0-9]+]]: f32):
// CHECK-NEXT: tile.yield([[PARTIAL_MAX]], [[PARTIAL_SUM]]) : (f32, f32) -> ()
// CHECK-NEXT: }) : (tensor<2xf32>, tensor<2xf32>) -> (tensor<2xf32>, tensor<2xf32>)
// CHECK-NEXT: [[LOGSUMEXP:%[0-9]+]] = tile.block([[MERGED_MAX]], [[MERGED_SUM]]) {iters = [par 2], reads = [$0[d0], $1[d0]], folds = [none -> [d0]]} ({
// CHECK-NEXT: ^body([[ROW_MAX:%[0-9]+]]: f32, [[ROW_SUM:%[0-9]+]]: f32):
// CHECK-NEXT: [[LOG_SUM:%[0-9]+]] = arith.log([[ROW_SUM]]) : (f32) -> f32
// CHECK-NEXT: [[LOG_TOTAL:%[0-9]+]] = arith.add([[ROW_MAX]], [[LOG_SUM]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[LOG_TOTAL]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<2xf32>, tensor<2xf32>) -> tensor<2xf32>
// CHECK-NEXT: func.return([[MAX]], [[SUM]], [[LOGSUMEXP]]) : (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>) -> ()
// CHECK-NEXT: }
func.func @logsumexp(%logits: tensor<2x16xf32>) -> (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>) {
  %max, %sum = tile.block(%logits) {iters = [par 2, red 16], reads = [$0[d0, d1]], folds = [logsumexp -> ([d0], [d0])]} ({
  ^body(%logit: f32):
    tile.yield(%logit) : (f32) -> ()
  }) : (tensor<2x16xf32>) -> (tensor<2xf32>, tensor<2xf32>)
  %merged_max, %merged_sum = tile.block(%max, %sum) {iters = [par 2, red 2], reads = [$0[d0], $1[d0]], folds = [logsumexp_merge -> ([d0], [d0])]} ({
  ^body(%partial_max: f32, %partial_sum: f32):
    tile.yield(%partial_max, %partial_sum) : (f32, f32) -> ()
  }) : (tensor<2xf32>, tensor<2xf32>) -> (tensor<2xf32>, tensor<2xf32>)
  %logsumexp = tile.block(%merged_max, %merged_sum) {iters = [par 2], reads = [$0[d0], $1[d0]], folds = [none -> [d0]]} ({
  ^body(%row_max: f32, %row_sum: f32):
    %log_sum = arith.log(%row_sum) : (f32) -> f32
    %log_total = arith.add(%row_max, %log_sum) : (f32, f32) -> f32
    tile.yield(%log_total) : (f32) -> ()
  }) : (tensor<2xf32>, tensor<2xf32>) -> tensor<2xf32>
  func.return(%max, %sum, %logsumexp) : (tensor<2xf32>, tensor<2xf32>, tensor<2xf32>) -> ()
}

// -----

// A cumulative sum, a padded shifted read, and an update of a cache at a position read from an
// operand.
// CHECK: func.func @prefix_and_into([[COUNTS:%[0-9]+]]: tensor<8xsi32>, [[CACHE:%[0-9]+]]: tensor<16x4xf32>, [[UPDATE:%[0-9]+]]: tensor<1x4xf32>, [[POSITION:%[0-9]+]]: tensor<si32>) -> (tensor<8xsi32>, tensor<8xsi32>, tensor<16x4xf32>) {
// CHECK-NEXT: [[PREFIX_SUMS:%[0-9]+]] = tile.block([[COUNTS]]) {iters = [prefix 8], reads = [$0[d0]], folds = [sum -> [d0]]} ({
// CHECK-NEXT: ^body([[COUNT:%[0-9]+]]: si32):
// CHECK-NEXT: tile.yield([[COUNT]]) : (si32) -> ()
// CHECK-NEXT: }) : (tensor<8xsi32>) -> tensor<8xsi32>
// CHECK-NEXT: [[SHIFTED:%[0-9]+]] = tile.block([[COUNTS]]) {iters = [par 8], reads = [$0[d0 - 1] pad 0.0], folds = [none -> [d0]]} ({
// CHECK-NEXT: ^body([[PREVIOUS_COUNT:%[0-9]+]]: si32):
// CHECK-NEXT: tile.yield([[PREVIOUS_COUNT]]) : (si32) -> ()
// CHECK-NEXT: }) : (tensor<8xsi32>) -> tensor<8xsi32>
// CHECK-NEXT: [[UPDATED_CACHE:%[0-9]+]] = tile.block([[CACHE]], [[UPDATE]], [[POSITION]]) {iters = [par 1, par 4], reads = [$1[d0, d1]], folds = [none -> $0[$2[] + d0, d1]]} ({
// CHECK-NEXT: ^body([[NEW_VALUE:%[0-9]+]]: f32):
// CHECK-NEXT: tile.yield([[NEW_VALUE]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<16x4xf32>, tensor<1x4xf32>, tensor<si32>) -> tensor<16x4xf32>
// CHECK-NEXT: func.return([[PREFIX_SUMS]], [[SHIFTED]], [[UPDATED_CACHE]]) : (tensor<8xsi32>, tensor<8xsi32>, tensor<16x4xf32>) -> ()
// CHECK-NEXT: }
func.func @prefix_and_into(%counts: tensor<8xsi32>, %cache: tensor<16x4xf32>, %update: tensor<1x4xf32>, %position: tensor<si32>) -> (tensor<8xsi32>, tensor<8xsi32>, tensor<16x4xf32>) {
  %prefix_sums = tile.block(%counts) {iters = [prefix 8], reads = [$0[d0]], folds = [sum -> [d0]]} ({
  ^body(%count: si32):
    tile.yield(%count) : (si32) -> ()
  }) : (tensor<8xsi32>) -> tensor<8xsi32>
  %shifted = tile.block(%counts) {iters = [par 8], reads = [$0[d0 - 1] pad 0.0], folds = [none -> [d0]]} ({
  ^body(%previous_count: si32):
    tile.yield(%previous_count) : (si32) -> ()
  }) : (tensor<8xsi32>) -> tensor<8xsi32>
  %updated_cache = tile.block(%cache, %update, %position) {iters = [par 1, par 4], reads = [$1[d0, d1]], folds = [none -> $0[$2[] + d0, d1]]} ({
  ^body(%new_value: f32):
    tile.yield(%new_value) : (f32) -> ()
  }) : (tensor<16x4xf32>, tensor<1x4xf32>, tensor<si32>) -> tensor<16x4xf32>
  func.return(%prefix_sums, %shifted, %updated_cache) : (tensor<8xsi32>, tensor<8xsi32>, tensor<16x4xf32>) -> ()
}

// -----

// One of three expert weights, picked per token.
// CHECK: func.func @experts([[INPUT:%[0-9]+]]: tensor<{T}x8xf32>, [[CHOICES:%[0-9]+]]: tensor<{T}xsi32>, [[FIRST_EXPERT:%[0-9]+]]: tensor<4x8xf32>, [[SECOND_EXPERT:%[0-9]+]]: tensor<4x8xf32>, [[THIRD_EXPERT:%[0-9]+]]: tensor<4x8xf32>) -> tensor<{T}x4xf32> {
// CHECK-NEXT: [[OUTPUT:%[0-9]+]] = tile.block([[INPUT]], [[CHOICES]], [[FIRST_EXPERT]], [[SECOND_EXPERT]], [[THIRD_EXPERT]]) {iters = [par {T}, par 4, red 8], reads = [$0[d0, d2], $2..$4[$1[d0]][d1, d2]], folds = [sum -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[ACTIVATION:%[0-9]+]]: f32, [[EXPERT_WEIGHT:%[0-9]+]]: f32):
// CHECK-NEXT: [[PRODUCT:%[0-9]+]] = arith.mul([[ACTIVATION]], [[EXPERT_WEIGHT]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[PRODUCT]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}x8xf32>, tensor<{T}xsi32>, tensor<4x8xf32>, tensor<4x8xf32>, tensor<4x8xf32>) -> tensor<{T}x4xf32>
// CHECK-NEXT: func.return([[OUTPUT]]) : (tensor<{T}x4xf32>) -> ()
// CHECK-NEXT: }
func.func @experts(%input: tensor<{T}x8xf32>, %choices: tensor<{T}xsi32>, %first_expert: tensor<4x8xf32>, %second_expert: tensor<4x8xf32>, %third_expert: tensor<4x8xf32>) -> tensor<{T}x4xf32> {
  %output = tile.block(%input, %choices, %first_expert, %second_expert, %third_expert) {iters = [par {T}, par 4, red 8], reads = [$0[d0, d2], $2..$4[$1[d0]][d1, d2]], folds = [sum -> [d0, d1]]} ({
  ^body(%activation: f32, %expert_weight: f32):
    %product = arith.mul(%activation, %expert_weight) : (f32, f32) -> f32
    tile.yield(%product) : (f32) -> ()
  }) : (tensor<{T}x8xf32>, tensor<{T}xsi32>, tensor<4x8xf32>, tensor<4x8xf32>, tensor<4x8xf32>) -> tensor<{T}x4xf32>
  func.return(%output) : (tensor<{T}x4xf32>) -> ()
}

// -----

// Blocks grouped over a grid, a sealed dispatch with symbol facts, and its call.
// CHECK: tile.dispatch @rms([[INPUT:%[0-9]+]]: tensor<{T}x8xf32>) -> tensor<{T}xf32> attributes {grid = [d0], facts = {T = [16, 4096] % 16}} {
// CHECK-NEXT: [[SUM_OF_SQUARES:%[0-9]+]] = tile.block([[INPUT]]) {iters = [par {T}, red 8], reads = [$0[d0, d1]], folds = [sum -> [d0]]} ({
// CHECK-NEXT: ^body([[ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: [[SQUARE:%[0-9]+]] = arith.mul([[ELEMENT]], [[ELEMENT]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[SQUARE]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}x8xf32>) -> tensor<{T}xf32>
// CHECK-NEXT: func.return([[SUM_OF_SQUARES]]) : (tensor<{T}xf32>) -> ()
// CHECK-NEXT: }
// CHECK: func.func @call([[INPUT:%[0-9]+]]: tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}x8xf32>) {
// CHECK-NEXT: [[SUM_OF_SQUARES:%[0-9]+]] = host.dispatch([[INPUT]]) {callee = @rms} : (tensor<{T}x8xf32>) -> tensor<{T}xf32>
// CHECK-NEXT: [[EXPONENTIALS:%[0-9]+]] = tile.group() {grid = [d0]} ({
// CHECK-NEXT: [[BLOCK_EXPONENTIALS:%[0-9]+]] = tile.block([[INPUT]]) {iters = [par {T}, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: [[EXPONENTIAL:%[0-9]+]] = arith.exp([[ELEMENT]]) : (f32) -> f32
// CHECK-NEXT: tile.yield([[EXPONENTIAL]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<{T}x8xf32>) -> tensor<{T}x8xf32>
// CHECK-NEXT: tile.yield([[BLOCK_EXPONENTIALS]]) : (tensor<{T}x8xf32>) -> ()
// CHECK-NEXT: }) : () -> tensor<{T}x8xf32>
// CHECK-NEXT: func.return([[SUM_OF_SQUARES]], [[EXPONENTIALS]]) : (tensor<{T}xf32>, tensor<{T}x8xf32>) -> ()
// CHECK-NEXT: }
tile.dispatch @rms(%input: tensor<{T}x8xf32>) -> tensor<{T}xf32> attributes {grid = [d0], facts = {T = [16, 4096] % 16}} {
  %sum_of_squares = tile.block(%input) {iters = [par {T}, red 8], reads = [$0[d0, d1]], folds = [sum -> [d0]]} ({
  ^body(%element: f32):
    %square = arith.mul(%element, %element) : (f32, f32) -> f32
    tile.yield(%square) : (f32) -> ()
  }) : (tensor<{T}x8xf32>) -> tensor<{T}xf32>
  func.return(%sum_of_squares) : (tensor<{T}xf32>) -> ()
}

func.func @call(%input: tensor<{T}x8xf32>) -> (tensor<{T}xf32>, tensor<{T}x8xf32>) {
  %sum_of_squares = host.dispatch(%input) {callee = @rms} : (tensor<{T}x8xf32>) -> tensor<{T}xf32>
  %exponentials = tile.group() {grid = [d0]} ({
    %block_exponentials = tile.block(%input) {iters = [par {T}, par 8], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
    ^body(%element: f32):
      %exponential = arith.exp(%element) : (f32) -> f32
      tile.yield(%exponential) : (f32) -> ()
    }) : (tensor<{T}x8xf32>) -> tensor<{T}x8xf32>
    tile.yield(%block_exponentials) : (tensor<{T}x8xf32>) -> ()
  }) : () -> tensor<{T}x8xf32>
  func.return(%sum_of_squares, %exponentials) : (tensor<{T}xf32>, tensor<{T}x8xf32>) -> ()
}
