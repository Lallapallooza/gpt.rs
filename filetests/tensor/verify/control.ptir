  ^else_branch(%4: tensor<4xf32>):
    %5 = tensor.reshape(%4) {shape = [2, 2]} : (tensor<4xf32>) -> tensor<2x2xf32>
    tensor.yield(%5) : (tensor<2x2xf32>) -> ()
  }) : (tensor<i1>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%2) : (tensor<4xf32>) -> ()
}

