// RUN: pass tensor-to-tile

// CHECK: func.func @mxfp4([[CODES:%[0-9]+]]: tensor<4x64xf4e2m1>, [[SCALES:%[0-9]+]]: tensor<4x2xe8m0>) -> tensor<4x64xbf16> {
// CHECK: tile.block([[CODES]], [[SCALES]]) {iters = [par 4, par 64], reads = [$0[d0, d1], $1[d0, d1 floordiv 32]], folds = [none -> [d0, d1]]}
// CHECK-NEXT: ^body([[CODE:%[0-9]+]]: f4e2m1, [[SCALE:%[0-9]+]]: e8m0):
// CHECK: arith.cast([[CODE]]) {to = f32} : (f4e2m1) -> f32
// CHECK-NEXT: arith.cast([[SCALE]]) {to = f32} : (e8m0) -> f32
// CHECK-NEXT: arith.mul
// CHECK-NEXT: arith.cast({{%[0-9]+}}) {to = bf16}
// CHECK-NOT: tensor.
func.func @mxfp4(%codes: tensor<4x64xf4e2m1>, %scales: tensor<4x2xe8m0>) -> tensor<4x64xbf16> {
  %dequantized = tensor.dequantize(%codes, %scales) {block = [1, 32], to = bf16} : (tensor<4x64xf4e2m1>, tensor<4x2xe8m0>) -> tensor<4x64xbf16>
  func.return(%dequantized) : (tensor<4x64xbf16>) -> ()
}

// -----
// CHECK: reads = [$0[d0, d1], $1[d0 floordiv 8, d1 floordiv 16]]
// CHECK: arith.cast({{%[0-9]+}}) {to = f8e4m3}
// Rounding to an integer adds and subtracts 2^23.
// CHECK: arith.constant() {value = 8388608.0 : f32}
// CHECK: arith.cast({{%[0-9]+}}) {to = si8}
// CHECK-NOT: tensor.
func.func @per_tensor(%input: tensor<8x16xf32>, %scale: tensor<1x1xf32>) -> (tensor<8x16xf8e4m3>, tensor<8x16xsi8>) {
  %fp8 = tensor.quantize(%input, %scale) {block = [8, 16], to = f8e4m3} : (tensor<8x16xf32>, tensor<1x1xf32>) -> tensor<8x16xf8e4m3>
  %int8 = tensor.quantize(%input, %scale) {block = [8, 16], to = si8} : (tensor<8x16xf32>, tensor<1x1xf32>) -> tensor<8x16xsi8>
  func.return(%fp8, %int8) : (tensor<8x16xf8e4m3>, tensor<8x16xsi8>) -> ()
}

// -----
// CHECK: func.func @offset_and_table([[CODES:%[0-9]+]]: tensor<4x64xui4>, [[SCALES:%[0-9]+]]: tensor<4x2xf16>, [[OFFSETS:%[0-9]+]]: tensor<4x2xf16>, [[TABLE:%[0-9]+]]: tensor<16xf32>) -> (tensor<4x64xbf16>, tensor<4x64xbf16>) {
// CHECK: reads = [$0[d0, d1], $1[d0, d1 floordiv 32], $2[d0, d1 floordiv 32]]
// CHECK: arith.add
// A table is read at the code by `take`; its values dequantize as any element.
// CHECK: [[VALUES:%[0-9]+]] = tile.block([[TABLE]], {{%[0-9]+}}) {iters = [par 4, par 64], reads = [$0[$1[d0, d1]]]
// CHECK: tile.block([[VALUES]], [[SCALES]]) {iters = [par 4, par 64], reads = [$0[d0, d1], $1[d0, d1 floordiv 32]]
// CHECK-NOT: tensor.
func.func @offset_and_table(%codes: tensor<4x64xui4>, %scales: tensor<4x2xf16>, %offsets: tensor<4x2xf16>, %table: tensor<16xf32>) -> (tensor<4x64xbf16>, tensor<4x64xbf16>) {
  %dequantized = tensor.dequantize(%codes, %scales, %offsets) {block = [1, 32], to = bf16} : (tensor<4x64xui4>, tensor<4x2xf16>, tensor<4x2xf16>) -> tensor<4x64xbf16>
  %indices = tensor.cast(%codes) {to = si32} : (tensor<4x64xui4>) -> tensor<4x64xsi32>
  %values = tensor.take(%table, %indices) : (tensor<16xf32>, tensor<4x64xsi32>) -> tensor<4x64xf32>
  %table_dequantized = tensor.dequantize(%values, %scales) {block = [1, 32], to = bf16} : (tensor<4x64xf32>, tensor<4x2xf16>) -> tensor<4x64xbf16>
  func.return(%dequantized, %table_dequantized) : (tensor<4x64xbf16>, tensor<4x64xbf16>) -> ()
}

// -----
// Stochastic rounding reads one draw per element and compares it in f64.
// CHECK: func.func @quantize_options([[INPUT:%[0-9]+]]: tensor<8x16xf32>, [[SCALES:%[0-9]+]]: tensor<8x1xf32>, [[DRAWS:%[0-9]+]]: tensor<8x16xui32>, [[TABLE:%[0-9]+]]: tensor<16xf32>) -> (tensor<8x16xf8e4m3>, tensor<8x16xui8>, tensor<8x16xui4>) {
// CHECK: tile.block([[INPUT]], [[SCALES]], [[DRAWS]]) {iters = [par 8, par 16], reads = [$0[d0, d1], $1[d0, d1 floordiv 16], $2[d0, d1]]
// CHECK: arith.cast({{%[0-9]+}}) {to = f64} : (ui32) -> f64
// The scale and the offset are one value here, so one operand.
// CHECK: tile.block([[INPUT]], [[SCALES]]) {iters = [par 8, par 16], reads = [$0[d0, d1], $1[d0, d1 floordiv 16], $1[d0, d1 floordiv 16]]
// A table quantizes to the index of the nearest entry, folded with `argmin`.
// CHECK: [[DISTANCES:%[0-9]+]], [[NEAREST:%[0-9]+]] = tile.block([[INPUT]], [[SCALES]], [[TABLE]]) {iters = [par 8, par 16, red 16], reads = [$0[d0, d1], $1[d0, d1 floordiv 16], $2[d2], $2[0]], folds = [argmin -> ([d0, d1], [d0, d1])]}
// CHECK: tile.block([[NEAREST]])
// CHECK: arith.cast({{%[0-9]+}}) {to = ui4}
// CHECK-NOT: tensor.
func.func @quantize_options(%input: tensor<8x16xf32>, %scales: tensor<8x1xf32>, %draws: tensor<8x16xui32>, %table: tensor<16xf32>) -> (tensor<8x16xf8e4m3>, tensor<8x16xui8>, tensor<8x16xui4>) {
  %stochastic = tensor.quantize_stochastic(%input, %scales, %draws) {block = [1, 16], to = f8e4m3} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<8x16xui32>) -> tensor<8x16xf8e4m3>
  %offset = tensor.quantize(%input, %scales, %scales) {block = [1, 16], to = ui8} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<8x1xf32>) -> tensor<8x16xui8>
  %table_codes = tensor.quantize_table(%input, %scales, %table) {block = [1, 16], to = ui4} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<16xf32>) -> tensor<8x16xui4>
  func.return(%stochastic, %offset, %table_codes) : (tensor<8x16xf8e4m3>, tensor<8x16xui8>, tensor<8x16xui4>) -> ()
}

// -----
// Each block's range, then its scale, then the quantization with the scale as stored.
// CHECK: func.func @dynamic([[INPUT:%[0-9]+]]: tensor<{T}x64xf32>) -> (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>, tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>) {
// CHECK: [[LO:%[0-9]+]], [[HI:%[0-9]+]] = tile.block([[INPUT]]) {iters = [par {T}, par 4, red 1, red 16], reads = [$0[d0 + d2, d1 * 16 + d3] pad 0.0], folds = [min -> [d0, d1], max -> [d0, d1]]}
// CHECK: [[SCALES:%[0-9]+]] = tile.block([[LO]], [[HI]])
// CHECK: tile.block([[INPUT]], [[SCALES]]) {iters = [par {T}, par 64], reads = [$0[d0, d1], $1[d0, d1 floordiv 16]]
// e8m0 scales are their exponent codes.
// CHECK: arith.bitcast({{%[0-9]+}}) {to = e8m0} : (ui8) -> e8m0
// CHECK-NOT: tensor.
func.func @dynamic(%input: tensor<{T}x64xf32>) -> (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>, tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>) {
  %fp8_scales = tensor.block_scale_amax(%input) {block = [1, 16], to = f4e2m1, scale_dtype = f8e4m3} : (tensor<{T}x64xf32>) -> tensor<{T}x4xf8e4m3>
  %fp4 = tensor.quantize(%input, %fp8_scales) {block = [1, 16], to = f4e2m1} : (tensor<{T}x64xf32>, tensor<{T}x4xf8e4m3>) -> tensor<{T}x64xf4e2m1>
  %e8m0_scales = tensor.block_scale_pow2_floor(%input) {block = [1, 32], to = f6e3m2, scale_dtype = e8m0} : (tensor<{T}x64xf32>) -> tensor<{T}x2xe8m0>
  %fp6 = tensor.quantize(%input, %e8m0_scales) {block = [1, 32], to = f6e3m2} : (tensor<{T}x64xf32>, tensor<{T}x2xe8m0>) -> tensor<{T}x64xf6e3m2>
  func.return(%fp4, %fp8_scales, %fp6, %e8m0_scales) : (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>, tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>) -> ()
}

// -----
// An asymmetric block gives a scale and an offset.
// CHECK: func.func @dynamic_options([[INPUT:%[0-9]+]]: tensor<4x64xf32>, [[DRAWS:%[0-9]+]]: tensor<4x64xui32>) -> (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>, tensor<4x64xf8e4m3>, tensor<4x2xe8m0>) {
// CHECK: [[SCALES:%[0-9]+]], [[OFFSETS:%[0-9]+]] = tile.block({{%[0-9]+}}, {{%[0-9]+}}) {iters = [par 4, par 2], reads = [$0[d0, d1], $1[d0, d1]], folds = [none -> [d0, d1], none -> [d0, d1]]}
// CHECK: tile.block([[INPUT]], [[SCALES]], [[OFFSETS]])
// CHECK-NOT: tensor.
func.func @dynamic_options(%input: tensor<4x64xf32>, %draws: tensor<4x64xui32>) -> (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>, tensor<4x64xf8e4m3>, tensor<4x2xe8m0>) {
  %scales, %offsets = tensor.block_scale_range(%input) {block = [1, 32], to = ui8, scale_dtype = f32} : (tensor<4x64xf32>) -> (tensor<4x2xf32>, tensor<4x2xf32>)
  %codes = tensor.quantize(%input, %scales, %offsets) {block = [1, 32], to = ui8} : (tensor<4x64xf32>, tensor<4x2xf32>, tensor<4x2xf32>) -> tensor<4x64xui8>
  %e8m0_scales = tensor.block_scale_pow2_ceil(%input) {block = [1, 32], to = f8e4m3, scale_dtype = e8m0} : (tensor<4x64xf32>) -> tensor<4x2xe8m0>
  %stochastic = tensor.quantize_stochastic(%input, %e8m0_scales, %draws) {block = [1, 32], to = f8e4m3} : (tensor<4x64xf32>, tensor<4x2xe8m0>, tensor<4x64xui32>) -> tensor<4x64xf8e4m3>
  func.return(%codes, %scales, %offsets, %stochastic, %e8m0_scales) : (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>, tensor<4x64xf8e4m3>, tensor<4x2xe8m0>) -> ()
}
