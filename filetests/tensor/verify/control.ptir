// RUN: verify

// ERROR: tensor.cond: the predicate must be an i1 scalar, got tensor<2xi1>
func.func @cond_predicate(%0: tensor<2xi1>, %1: tensor<4xf32>) -> tensor<4xf32> {
  %2 = tensor.cond(%0, %1) {results = [tensor<4xf32>]} ({
  ^then_branch(%3: tensor<4xf32>):
    tensor.yield(%3) : (tensor<4xf32>) -> ()
  }, {
  ^else_branch(%4: tensor<4xf32>):
    tensor.yield(%4) : (tensor<4xf32>) -> ()
  }) : (tensor<2xi1>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%2) : (tensor<4xf32>) -> ()
}

