// RUN: pass name-target {target = "x86-64-v4", numerics = <contract = true>}, select-atoms {target = "x86-64-v4"}, split-lane-folds {target = "x86-64-v4"}

// The largest score of each of 12 rows: the 64 scores of a row take their maximum in the lanes of
// vectors, 16 lanes in 4 tiles, and the block that folds them takes the maximum of the 16 lanes
// of each row in halves. A maximum gives the same value in any order, so the dispatch needs no
// numerics that regroup it.
// CHECK: [[LANE_MAXIMA:%[0-9]+]] = tile.block({{%[0-9]+}}) {iters = [par 12, red 4, par 16], reads = [$0[d0, d1 * 16 + d2]], folds = [max -> [d0, d2]], loops = [d0 by 1, d1 by 1, d2 by 16 : lanes]} ({
// CHECK: [[MAXIMA:%[0-9]+]] = tile.block([[LANE_MAXIMA]]) {iters = [par 12], reads = [$0[d0, 0], $0[d0, 1], $0[d0, 2], $0[d0, 3], $0[d0, 4], $0[d0, 5], $0[d0, 6], $0[d0, 7], $0[d0, 8], $0[d0, 9], $0[d0, 10], $0[d0, 11], $0[d0, 12], $0[d0, 13], $0[d0, 14], $0[d0, 15]], folds = [none -> [d0]]} ({
// CHECK-NEXT: ^body([[LANE_0:%[0-9]+]]: f32, [[LANE_1:%[0-9]+]]: f32, [[LANE_2:%[0-9]+]]: f32, [[LANE_3:%[0-9]+]]: f32, [[LANE_4:%[0-9]+]]: f32, [[LANE_5:%[0-9]+]]: f32, [[LANE_6:%[0-9]+]]: f32, [[LANE_7:%[0-9]+]]: f32, [[LANE_8:%[0-9]+]]: f32, [[LANE_9:%[0-9]+]]: f32, [[LANE_10:%[0-9]+]]: f32, [[LANE_11:%[0-9]+]]: f32, [[LANE_12:%[0-9]+]]: f32, [[LANE_13:%[0-9]+]]: f32, [[LANE_14:%[0-9]+]]: f32, [[LANE_15:%[0-9]+]]: f32):
// CHECK-NEXT: [[PAIR:%[0-9]+]] = arith.maximum([[LANE_0]], [[LANE_8]]) : (f32, f32) -> f32
// CHECK: func.return([[MAXIMA]]) : (tensor<12xf32>) -> ()
tile.dispatch @row_maxima(%scores: tensor<12x64xf32>) -> tensor<12xf32> {
  %largest = tile.block(%scores) {iters = [par 12, red 64], reads = [$0[d0, d1]], folds = [max -> [d0]]} ({
  ^body(%score: f32):
    tile.yield(%score) : (f32) -> ()
  }) : (tensor<12x64xf32>) -> tensor<12xf32>
  func.return(%largest) : (tensor<12xf32>) -> ()
}
func.func @main(%scores: tensor<12x64xf32>) -> tensor<12xf32> {
  %largest = host.dispatch(%scores) {callee = @row_maxima} : (tensor<12x64xf32>) -> tensor<12xf32>
  func.return(%largest) : (tensor<12xf32>) -> ()
}

// -----

// 70 scores fill 5 tiles of 16 lanes but for 10: each reads past the row at -inf, which leaves
// every maximum as it is.
// CHECK: tile.block({{%[0-9]+}}) {iters = [par 12, red 5, par 16], reads = [$0[d0, d1 * 16 + d2] pad -inf], folds = [max -> [d0, d2]], loops = [d0 by 1, d1 by 1, d2 by 16 : lanes]} ({
tile.dispatch @row_maxima(%scores: tensor<12x70xf32>) -> tensor<12xf32> {
  %largest = tile.block(%scores) {iters = [par 12, red 70], reads = [$0[d0, d1]], folds = [max -> [d0]]} ({
  ^body(%score: f32):
    tile.yield(%score) : (f32) -> ()
  }) : (tensor<12x70xf32>) -> tensor<12xf32>
  func.return(%largest) : (tensor<12xf32>) -> ()
}
func.func @main(%scores: tensor<12x70xf32>) -> tensor<12xf32> {
  %largest = host.dispatch(%scores) {callee = @row_maxima} : (tensor<12x70xf32>) -> tensor<12xf32>
  func.return(%largest) : (tensor<12xf32>) -> ()
}
