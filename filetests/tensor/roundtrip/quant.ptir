// RUN: roundtrip

func.func @mxfp4(%0: tensor<4x64xf4e2m1>, %1: tensor<4x2xe8m0>) -> tensor<4x64xbf16> {
  %2 = tensor.dequantize(%0, %1) {block = [1, 32], to = bf16} : (tensor<4x64xf4e2m1>, tensor<4x2xe8m0>) -> tensor<4x64xbf16>
  func.return(%2) : (tensor<4x64xbf16>) -> ()
}

// -----

func.func @per_tensor(%0: tensor<8x16xf32>, %1: tensor<1x1xf32>) -> (tensor<8x16xf8e4m3>, tensor<8x16xsi8>) {
  %2 = tensor.quantize(%0, %1) {block = [8, 16], to = f8e4m3} : (tensor<8x16xf32>, tensor<1x1xf32>) -> tensor<8x16xf8e4m3>
  %3 = tensor.quantize(%0, %1) {block = [8, 16], to = si8} : (tensor<8x16xf32>, tensor<1x1xf32>) -> tensor<8x16xsi8>
  func.return(%2, %3) : (tensor<8x16xf8e4m3>, tensor<8x16xsi8>) -> ()
}

// -----

func.func @offset_and_table(%0: tensor<4x64xui4>, %1: tensor<4x2xf16>, %2: tensor<4x2xf16>, %3: tensor<16xf32>) -> (tensor<4x64xbf16>, tensor<4x64xbf16>) {
  %4 = tensor.dequantize(%0, %1, %2) {block = [1, 32], to = bf16, operand_segments = [1, 1, 1, 0]} : (tensor<4x64xui4>, tensor<4x2xf16>, tensor<4x2xf16>) -> tensor<4x64xbf16>
  %5 = tensor.dequantize(%0, %1, %3) {block = [1, 32], to = bf16, operand_segments = [1, 1, 0, 1]} : (tensor<4x64xui4>, tensor<4x2xf16>, tensor<16xf32>) -> tensor<4x64xbf16>
  func.return(%4, %5) : (tensor<4x64xbf16>, tensor<4x64xbf16>) -> ()
}

// -----

func.func @quantize_options(%0: tensor<8x16xf32>, %1: tensor<8x1xf32>, %2: tensor<8x16xui32>, %3: tensor<16xf32>) -> (tensor<8x16xf8e4m3>, tensor<8x16xui8>, tensor<8x16xui4>) {
  %4 = tensor.quantize(%0, %1, %2) {block = [1, 16], to = f8e4m3, rounding = stochastic, operand_segments = [1, 1, 0, 0, 1]} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<8x16xui32>) -> tensor<8x16xf8e4m3>
  %5 = tensor.quantize(%0, %1, %1) {block = [1, 16], to = ui8, operand_segments = [1, 1, 1, 0, 0]} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<8x1xf32>) -> tensor<8x16xui8>
  %6 = tensor.quantize(%0, %1, %3) {block = [1, 16], to = ui4, operand_segments = [1, 1, 0, 1, 0]} : (tensor<8x16xf32>, tensor<8x1xf32>, tensor<16xf32>) -> tensor<8x16xui4>
  func.return(%4, %5, %6) : (tensor<8x16xf8e4m3>, tensor<8x16xui8>, tensor<8x16xui4>) -> ()
}

// -----

func.func @dynamic(%0: tensor<{T}x64xf32>) -> (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>, tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>) {
  %1, %2 = tensor.quantize_dynamic(%0) {block = [1, 16], to = f4e2m1, scale_dtype = f8e4m3} : (tensor<{T}x64xf32>) -> (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>)
  %3, %4 = tensor.quantize_dynamic(%0) {block = [1, 32], to = f6e3m2, scale_dtype = e8m0, scale_rule = pow2_floor} : (tensor<{T}x64xf32>) -> (tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>)
  func.return(%1, %2, %3, %4) : (tensor<{T}x64xf4e2m1>, tensor<{T}x4xf8e4m3>, tensor<{T}x64xf6e3m2>, tensor<{T}x2xe8m0>) -> ()
}

// -----

func.func @dynamic_options(%0: tensor<4x64xf32>, %1: tensor<4x64xui32>) -> (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>, tensor<4x64xf8e4m3>, tensor<4x2xe8m0>) {
  %2, %3, %4 = tensor.quantize_dynamic(%0) {block = [1, 32], to = ui8, scale_dtype = f32, asymmetric = true} : (tensor<4x64xf32>) -> (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>)
  %5, %6 = tensor.quantize_dynamic(%0, %1) {block = [1, 32], to = f8e4m3, scale_dtype = e8m0, scale_rule = pow2_ceil, rounding = stochastic} : (tensor<4x64xf32>, tensor<4x64xui32>) -> (tensor<4x64xf8e4m3>, tensor<4x2xe8m0>)
  func.return(%2, %3, %4, %5, %6) : (tensor<4x64xui8>, tensor<4x2xf32>, tensor<4x2xf32>, tensor<4x64xf8e4m3>, tensor<4x2xe8m0>) -> ()
}
