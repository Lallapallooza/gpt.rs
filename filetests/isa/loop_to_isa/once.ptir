// RUN: pass tile-to-loop, loop-to-isa {target = "x86-64-v4"}

// {N} elements scaled by one element of a factor, in tiles of 16 lanes: the whole tiles, then the
// last one, which holds what they leave. The factor is the same at every point, so it loads once
// before each atom. The last atom's extent is not a constant, so its accesses of the input and the
// output take a mask, and the load of the factor reads as it is: the loop runs the last atom only
// for a tile that holds a point.
// CHECK: [[EXTENT:%[0-9]+]] = loop.index({{%[0-9]+}}, {{%[0-9]+}}) {expr = min(16, d1 - d0)} : (index, index) -> index
// CHECK: isa.tile_mask([[EXTENT]]) {dims = [1, 16]} : (index) -> !isa.vec<1x16xi1>
// CHECK: [[AT:%[0-9]+]] = loop.index() {expr = 2} : () -> index
// CHECK-NEXT: [[FACTOR:%[0-9]+]] = loop.load({{%[0-9]+}}, [[AT]]) : (!loop.buf<4xf32, global>, index) -> f32
// CHECK-NEXT: isa.splat([[FACTOR]]) {dims = [1, 16]} : (f32) -> !isa.vec<1x16xf32>
tile.dispatch @scale(%input: tensor<{N}xf32>, %factor: tensor<4xf32>) -> tensor<{N}xf32> attributes {target = "x86-64-v4@3928f7d3"} {
  %scaled = tile.block(%input, %factor) {iters = [par {N}], reads = [$0[d0], $1[2]], folds = [none -> [d0]], loops = [d0 by 16, d0 by 16 : lanes]} ({
  ^body(%element: f32, %by: f32):
    %product = arith.mul(%element, %by) : (f32, f32) -> f32
    tile.yield(%product) : (f32) -> ()
  }) : (tensor<{N}xf32>, tensor<4xf32>) -> tensor<{N}xf32>
  func.return(%scaled) : (tensor<{N}xf32>) -> ()
}
func.func @main(%input: tensor<{N}xf32>, %factor: tensor<4xf32>) -> tensor<{N}xf32> {
  %scaled = host.dispatch(%input, %factor) {callee = @scale} : (tensor<{N}xf32>, tensor<4xf32>) -> tensor<{N}xf32>
  func.return(%scaled) : (tensor<{N}xf32>) -> ()
}
