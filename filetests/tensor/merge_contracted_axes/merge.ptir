// RUN: pass merge-contracted-axes

// A convolution splits its patches [N, OH, OW, KH * KW * C_in] into [N, OH, OW, KH, KW, C_in] and
// contracts them with the weight [C_out, C_in, KH, KW]. The pass moves the weight to
// [KH * KW * C_in, C_out], and the patches contract whole.
// CHECK: func.func @conv([[PATCHES:%[0-9]+]]: tensor<1x2x2x12xf32>, [[WEIGHT:%[0-9]+]]: tensor<4x3x2x2xf32> {param = 1})
// CHECK: [[TRANSPOSED:%[0-9]+]] = tensor.transpose([[WEIGHT]]) {perm = [2, 3, 1, 0]} : (tensor<4x3x2x2xf32>) -> tensor<2x2x3x4xf32>
// CHECK: [[MERGED:%[0-9]+]] = tensor.reshape([[TRANSPOSED]]) {shape = [12, 4]} : (tensor<2x2x3x4xf32>) -> tensor<12x4xf32>
// CHECK: tensor.dot_general([[PATCHES]], [[MERGED]]) {contract_lhs = [3], contract_rhs = [0]} : (tensor<1x2x2x12xf32>, tensor<12x4xf32>) -> tensor<1x2x2x4xf32>
func.func @conv(%patches: tensor<1x2x2x12xf32>, %weight: tensor<4x3x2x2xf32> {param = 1}) -> tensor<1x2x2x4xf32> {
  %split = tensor.reshape(%patches) {shape = [1, 2, 2, 2, 2, 3]} : (tensor<1x2x2x12xf32>) -> tensor<1x2x2x2x2x3xf32>
  %convolved = tensor.dot_general(%split, %weight) {contract_lhs = [3, 4, 5], contract_rhs = [2, 3, 1]} : (tensor<1x2x2x2x2x3xf32>, tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32>
  func.return(%convolved) : (tensor<1x2x2x4xf32>) -> ()
}

// -----

// A batch axis of the lhs after the split axis moves up, and the weight keeps its batch axis first.
// CHECK: func.func @batched([[LHS:%[0-9]+]]: tensor<6x4xf32>, [[WEIGHT:%[0-9]+]]: tensor<4x3x2x5xf32> {param = 1})
// CHECK: [[TRANSPOSED:%[0-9]+]] = tensor.transpose([[WEIGHT]]) {perm = [0, 2, 1, 3]} : (tensor<4x3x2x5xf32>) -> tensor<4x2x3x5xf32>
// CHECK: [[MERGED:%[0-9]+]] = tensor.reshape([[TRANSPOSED]]) {shape = [4, 6, 5]} : (tensor<4x2x3x5xf32>) -> tensor<4x6x5xf32>
// CHECK: tensor.dot_general([[LHS]], [[MERGED]]) {batch_lhs = [1], batch_rhs = [0], contract_lhs = [0], contract_rhs = [1]} : (tensor<6x4xf32>, tensor<4x6x5xf32>) -> tensor<4x5xf32>
func.func @batched(%lhs: tensor<6x4xf32>, %weight: tensor<4x3x2x5xf32> {param = 1}) -> tensor<4x5xf32> {
  %split = tensor.reshape(%lhs) {shape = [2, 3, 4]} : (tensor<6x4xf32>) -> tensor<2x3x4xf32>
  %product = tensor.dot_general(%split, %weight) {batch_lhs = [2], batch_rhs = [0], contract_lhs = [0, 1], contract_rhs = [2, 1]} : (tensor<2x3x4xf32>, tensor<4x3x2x5xf32>) -> tensor<4x5xf32>
  func.return(%product) : (tensor<4x5xf32>) -> ()
}

// -----

// A weight computed at run time stays as it is: transposing it would cost a copy on every run.
// CHECK: func.func @run_time_weight
// CHECK-NOT: tensor.transpose
func.func @run_time_weight(%patches: tensor<1x2x2x12xf32>, %weight: tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32> {
  %split = tensor.reshape(%patches) {shape = [1, 2, 2, 2, 2, 3]} : (tensor<1x2x2x12xf32>) -> tensor<1x2x2x2x2x3xf32>
  %convolved = tensor.dot_general(%split, %weight) {contract_lhs = [3, 4, 5], contract_rhs = [2, 3, 1]} : (tensor<1x2x2x2x2x3xf32>, tensor<4x3x2x2xf32>) -> tensor<1x2x2x4xf32>
  func.return(%convolved) : (tensor<1x2x2x4xf32>) -> ()
}

// -----

// The pass leaves a dot alone when its reshape does more than split one axis into the contracted
// axes.
// CHECK: func.func @not_a_split
// CHECK-NOT: tensor.transpose
func.func @not_a_split(%lhs: tensor<4x3xf32>, %weight: tensor<2x3x5xf32> {param = 1}) -> tensor<2x5xf32> {
  %reshaped = tensor.reshape(%lhs) {shape = [2, 2, 3]} : (tensor<4x3xf32>) -> tensor<2x2x3xf32>
  %product = tensor.dot_general(%reshaped, %weight) {contract_lhs = [1, 2], contract_rhs = [0, 1]} : (tensor<2x2x3xf32>, tensor<2x3x5xf32>) -> tensor<2x5xf32>
  func.return(%product) : (tensor<2x5xf32>) -> ()
}
