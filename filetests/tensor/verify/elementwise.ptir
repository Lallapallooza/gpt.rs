// ERROR: tensor.add: operands must have equal types, got tensor<4xf32> and tensor<3xf32>
func.func @mismatch(%0: tensor<4xf32>, %1: tensor<3xf32>) -> tensor<4xf32> {
  %2 = tensor.add(%0, %1) : (tensor<4xf32>, tensor<3xf32>) -> tensor<4xf32>
  func.return(%2) : (tensor<4xf32>) -> ()
}

