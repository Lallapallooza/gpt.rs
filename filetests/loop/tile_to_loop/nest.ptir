// RUN: pass tile-to-loop

// A projection whose columns run on the workers of level `core`, four per worker, the last worker
// with the two left over. The loop over tiles of the contracted axis is outside the inner column
// tiles, so the sums of a worker's three rows and four columns stay in a private buffer while it
// walks them.
// CHECK: loop.func @project([[INPUT:%[0-9]+]]: !loop.buf<3x8xf32, global>, [[WEIGHT:%[0-9]+]]: !loop.buf<6x8xf32, global>, [[PRODUCT:%[0-9]+]]: !loop.buf<3x6xf32, global>) attributes {access = [in, in, out], target = "x86-64-v4@3928f7d3"} {
// CHECK-NEXT: [[START:%[0-9]+]] = loop.index() {expr = 0} : () -> index
// CHECK-NEXT: [[COLUMNS:%[0-9]+]] = loop.index() {expr = 6} : () -> index
// CHECK-NEXT: [[UNITS:%[0-9]+]] = loop.index() {expr = 2} : () -> index
// CHECK-NEXT: [[ZERO:%[0-9]+]] = loop.index() {expr = 0} : () -> index
// CHECK-NEXT: loop.forall([[ZERO]], [[UNITS]]) {level = core} ({
// CHECK-NEXT: ^body([[UNIT:%[0-9]+]]: index):
// CHECK-NEXT: [[FIRST_COLUMN:%[0-9]+]] = loop.index([[START]], [[UNIT]]) {expr = d0 + d1 * 4} : (index, index) -> index
// CHECK-NEXT: [[END_COLUMN:%[0-9]+]] = loop.index([[FIRST_COLUMN]], [[COLUMNS]]) {expr = min(d0 + 4, d1)} : (index, index) -> index
// CHECK-NEXT: [[SUMS:%[0-9]+]] = loop.alloc() {shape = [3, 4], dtype = f32} : () -> !loop.buf<3x4xf32, private>
// CHECK: [[COLUMNS_HERE:%[0-9]+]] = loop.index([[FIRST_COLUMN]], [[END_COLUMN]]) {expr = min(4, d1 - d0)} : (index, index) -> index
// CHECK: loop.store({{%[0-9]+}}, [[SUMS]], [[ROW_OFFSET:%[0-9]+]], [[COLUMN_OFFSET:%[0-9]+]])
// CHECK: [[DEPTH:%[0-9]+]] = loop.index() {expr = 8} : () -> index
// CHECK-NEXT: [[DEPTH_TILES:%[0-9]+]] = loop.index() {expr = 2} : () -> index
// CHECK: loop.for({{%[0-9]+}}, [[DEPTH_TILES]]) ({
// CHECK-NEXT: ^body([[DEPTH_TILE:%[0-9]+]]: index):
// CHECK-NEXT: [[FIRST_DEPTH:%[0-9]+]] = loop.index({{%[0-9]+}}, [[DEPTH_TILE]]) {expr = d0 + d1 * 4} : (index, index) -> index
// CHECK-NEXT: [[END_DEPTH:%[0-9]+]] = loop.index([[FIRST_DEPTH]]) {expr = d0 + 4} : (index) -> index
// CHECK-NEXT: [[PAIRS:%[0-9]+]] = loop.index([[FIRST_COLUMN]], [[END_COLUMN]]) {expr = (d1 - d0 + 1) floordiv 2} : (index, index) -> index
// CHECK: loop.for({{%[0-9]+}}, [[PAIRS]]) ({
// CHECK-NEXT: ^body([[PAIR:%[0-9]+]]: index):
// CHECK-NEXT: [[FIRST_OF_PAIR:%[0-9]+]] = loop.index([[FIRST_COLUMN]], [[PAIR]]) {expr = d0 + d1 * 2} : (index, index) -> index
// CHECK-NEXT: [[END_OF_PAIR:%[0-9]+]] = loop.index([[FIRST_OF_PAIR]], [[END_COLUMN]]) {expr = min(d0 + 2, d1)} : (index, index) -> index
// CHECK: ^body([[ROW:%[0-9]+]]: index):
// CHECK-NEXT: loop.for([[FIRST_OF_PAIR]], [[END_OF_PAIR]]) ({
// CHECK-NEXT: ^body([[COLUMN:%[0-9]+]]: index):
// CHECK-NEXT: loop.for([[FIRST_DEPTH]], [[END_DEPTH]]) ({
// CHECK-NEXT: ^body([[POINT:%[0-9]+]]: index):
// CHECK-NEXT: [[ELEMENT:%[0-9]+]] = loop.load([[INPUT]], [[ROW]], [[POINT]])
// CHECK-NEXT: [[SCALE:%[0-9]+]] = loop.load([[WEIGHT]], [[COLUMN]], [[POINT]])
// CHECK-NEXT: [[TERM:%[0-9]+]] = arith.mul([[ELEMENT]], [[SCALE]])
// CHECK-NEXT: [[ROW_IN_TILE:%[0-9]+]] = loop.index([[ROW]], {{%[0-9]+}}) {expr = d0 - d1} : (index, index) -> index
// CHECK-NEXT: [[COLUMN_IN_TILE:%[0-9]+]] = loop.index([[COLUMN]], [[FIRST_COLUMN]]) {expr = d0 - d1} : (index, index) -> index
// CHECK-NEXT: [[SO_FAR:%[0-9]+]] = loop.load([[SUMS]], [[ROW_IN_TILE]], [[COLUMN_IN_TILE]])
// CHECK-NEXT: [[SUM:%[0-9]+]] = arith.add([[SO_FAR]], [[TERM]])
// CHECK-NEXT: loop.store([[SUM]], [[SUMS]], [[ROW_IN_TILE]], [[COLUMN_IN_TILE]])
// CHECK: [[FINAL:%[0-9]+]] = loop.load([[SUMS]], [[ROW_OFFSET:%[0-9]+]], [[COLUMN_OFFSET:%[0-9]+]])
// CHECK-NEXT: loop.store([[FINAL]], [[PRODUCT]], {{%[0-9]+}}, {{%[0-9]+}})
tile.dispatch @project(%input: tensor<3x8xf32>, %weight: tensor<6x8xf32>) -> tensor<3x6xf32> attributes {target = "x86-64-v4@3928f7d3"} {
  %product = tile.block(%input, %weight) {iters = [par 3, par 6, red 8], reads = [$0[d0, d2], $1[d1, d2]], folds = [sum -> [d0, d1] held scratch<at = 1>], loops = [d1 by 4 : workers<level = core>, d2 by 4, d1 by 2, d0 by 1, d1 by 1, d2 by 1]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<3x8xf32>, tensor<6x8xf32>) -> tensor<3x6xf32>
  func.return(%product) : (tensor<3x6xf32>) -> ()
}
func.func @main(%input: tensor<3x8xf32>, %weight: tensor<6x8xf32>) -> tensor<3x6xf32> {
  %product = host.dispatch(%input, %weight) {callee = @project} : (tensor<3x8xf32>, tensor<6x8xf32>) -> tensor<3x6xf32>
  func.return(%product) : (tensor<3x6xf32>) -> ()
}

// -----

// Two workers run the five rows of a map in pieces of three, the second taking the two left over.
// Each row runs its columns on the cores of its worker, two each.
// CHECK: loop.func @rows({{%[0-9]+}}: !loop.buf<5x4xf32, global>, {{%[0-9]+}}: !loop.buf<5x4xf32, global>) attributes {access = [in, out<over = 0>]} {
// CHECK: [[ROWS:%[0-9]+]] = loop.index() {expr = 5} : () -> index
// CHECK-NEXT: [[WORKERS:%[0-9]+]] = loop.index() {expr = 2} : () -> index
// CHECK: loop.forall({{%[0-9]+}}, [[WORKERS]]) {level = l3} ({
// CHECK-NEXT: ^body([[WORKER:%[0-9]+]]: index):
// CHECK-NEXT: [[PIECE_START:%[0-9]+]] = loop.index({{%[0-9]+}}, [[WORKER]]) {expr = d0 + d1 * 3} : (index, index) -> index
// CHECK-NEXT: [[PIECE_END:%[0-9]+]] = loop.index([[PIECE_START]], [[ROWS]]) {expr = min(d0 + 3, d1)} : (index, index) -> index
// CHECK: loop.forall({{%[0-9]+}}, {{%[0-9]+}}) {level = core} ({
// CHECK: loop.for([[PIECE_START]], [[PIECE_END]]) ({
tile.dispatch @rows(%input: tensor<5x4xf32>) -> tensor<5x4xf32> {
  %negated = tile.block(%input) {iters = [par 5, par 4], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 3 : workers<level = l3>, d1 by 2 : workers<level = core>, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    %negative = arith.neg(%element) : (f32) -> f32
    tile.yield(%negative) : (f32) -> ()
  }) : (tensor<5x4xf32>) -> tensor<5x4xf32>
  func.return(%negated) : (tensor<5x4xf32>) -> ()
}
func.func @main(%input: tensor<5x4xf32>) -> tensor<5x4xf32> {
  %negated = host.dispatch(%input) {callee = @rows} : (tensor<5x4xf32>) -> tensor<5x4xf32>
  func.return(%negated) : (tensor<5x4xf32>) -> ()
}

// -----

// Two loops on the cores, over pieces of 2 of the 5 columns and over the 3 rows, run as one
// `loop.forall` over their 9 pairs: each core takes the pairs of its share, and a pair stands at
// its row and its piece of the columns, which the loops inside then walk as they would alone.
// CHECK: loop.func @grid({{%[0-9]+}}: !loop.buf<3x5xf32, global>, {{%[0-9]+}}: !loop.buf<3x5xf32, global>) attributes {access = [in, out<over = 0>]} {
// CHECK: [[COLUMN_PIECES:%[0-9]+]] = loop.index() {expr = 3} : () -> index
// CHECK: [[ROWS:%[0-9]+]] = loop.index({{%[0-9]+}}, {{%[0-9]+}}) {expr = d1 - d0} : (index, index) -> index
// CHECK-NEXT: [[PAIRS:%[0-9]+]] = loop.index([[COLUMN_PIECES]], [[ROWS]]) {expr = d0 * d1} : (index, index) -> index
// CHECK: loop.forall({{%[0-9]+}}, [[PAIRS]]) {level = core} ({
// CHECK-NEXT: ^body([[PAIR:%[0-9]+]]: index):
// CHECK-NEXT: [[ROW:%[0-9]+]] = loop.index([[PAIR]], [[ROWS]]) {expr = d0 mod d1} : (index, index) -> index
// CHECK-NEXT: [[COLUMN_PIECE:%[0-9]+]] = loop.index([[PAIR]], [[ROWS]]) {expr = d0 floordiv d1} : (index, index) -> index
// CHECK-NEXT: [[PIECE_START:%[0-9]+]] = loop.index({{%[0-9]+}}, [[COLUMN_PIECE]]) {expr = d0 + d1 * 2} : (index, index) -> index
// CHECK-NOT: loop.forall
// CHECK: [[ROW_INDEX:%[0-9]+]] = loop.index({{%[0-9]+}}, [[ROW]]) {expr = d0 + d1} : (index, index) -> index
// CHECK-NEXT: loop.for([[PIECE_START]], {{%[0-9]+}}) ({
// CHECK: loop.load({{%[0-9]+}}, [[ROW_INDEX]], {{%[0-9]+}})
tile.dispatch @grid(%input: tensor<3x5xf32>) -> tensor<3x5xf32> {
  %negated = tile.block(%input) {iters = [par 3, par 5], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d1 by 2 : workers<level = core>, d0 by 1 : workers<level = core>, d1 by 1]} ({
  ^body(%element: f32):
    %negative = arith.neg(%element) : (f32) -> f32
    tile.yield(%negative) : (f32) -> ()
  }) : (tensor<3x5xf32>) -> tensor<3x5xf32>
  func.return(%negated) : (tensor<3x5xf32>) -> ()
}
func.func @main(%input: tensor<3x5xf32>) -> tensor<3x5xf32> {
  %negated = host.dispatch(%input) {callee = @grid} : (tensor<3x5xf32>) -> tensor<3x5xf32>
  func.return(%negated) : (tensor<3x5xf32>) -> ()
}

// -----

// `top_k` over tiles of the reduced axis, inside the workers' tiles of rows: the state keeps each
// row's held candidates while the loop walks the tiles of the scores.
// CHECK: loop.func @best({{%[0-9]+}}: !loop.buf<4x7xf32, global>, [[VALUES:%[0-9]+]]: !loop.buf<4x2xf32, global>, [[INDICES:%[0-9]+]]: !loop.buf<4x2xsi32, global>) attributes {access = [in, out, out], target = "x86-64-v4@3928f7d3"} {
// CHECK: loop.forall({{%[0-9]+}}, {{%[0-9]+}}) {level = core} ({
// CHECK: [[HELD_VALUES:%[0-9]+]] = loop.alloc() {shape = [2, 2], dtype = f32} : () -> !loop.buf<2x2xf32, private>
// CHECK-NEXT: [[HELD_INDICES:%[0-9]+]] = loop.alloc() {shape = [2, 2], dtype = si32} : () -> !loop.buf<2x2xsi32, private>
// CHECK-NEXT: [[HELD:%[0-9]+]] = loop.alloc() {shape = [2], dtype = si64} : () -> !loop.buf<2xsi64, private>
// CHECK: [[SCORES:%[0-9]+]] = loop.index() {expr = 7} : () -> index
// CHECK-NEXT: [[SCORE_TILES:%[0-9]+]] = loop.index() {expr = 3} : () -> index
// CHECK: loop.for({{%[0-9]+}}, [[SCORE_TILES]]) ({
// CHECK: loop.store({{%[0-9]+}}, [[VALUES]], {{%[0-9]+}}, {{%[0-9]+}}) : (f32, !loop.buf<4x2xf32, global>, index, index) -> ()
tile.dispatch @best(%scores: tensor<4x7xf32>) -> (tensor<4x2xf32>, tensor<4x2xsi32>) attributes {target = "x86-64-v4@3928f7d3"} {
  %values, %indices = tile.block(%scores) {iters = [par 4, red 7], reads = [$0[d0, d1]], folds = [top_k<k = 2> -> ([d0], [d0]) held scratch<at = 1>], loops = [d0 by 2 : workers<level = core>, d1 by 3, d0 by 1, d1 by 1]} ({
  ^body(%score: f32):
    %position = tile.index() {expr = d1, dtype = si32} : () -> si32
    tile.yield(%score, %position) : (f32, si32) -> ()
  }) : (tensor<4x7xf32>) -> (tensor<4x2xf32>, tensor<4x2xsi32>)
  func.return(%values, %indices) : (tensor<4x2xf32>, tensor<4x2xsi32>) -> ()
}
func.func @main(%scores: tensor<4x7xf32>) -> (tensor<4x2xf32>, tensor<4x2xsi32>) {
  %values, %indices = host.dispatch(%scores) {callee = @best} : (tensor<4x7xf32>) -> (tensor<4x2xf32>, tensor<4x2xsi32>)
  func.return(%values, %indices) : (tensor<4x2xf32>, tensor<4x2xsi32>) -> ()
}

// -----

// Two loops of workers of one level, the second clipped to the rows where the input stays in
// range: a clipped loop does not join the `loop.forall` of the loop around it, but runs its own.
// CHECK: loop.func @taps([[INPUT:%[0-9]+]]: !loop.buf<6x16xf32, global>, {{%[0-9]+}}: !loop.buf<6x16xf32, global>)
// CHECK: loop.forall({{%[0-9]+}}, {{%[0-9]+}}) {level = core} ({
// CHECK-NEXT: ^body([[COLUMN_UNIT:%[0-9]+]]: index):
// CHECK: [[ROWS:%[0-9]+]] = loop.index([[FIRST_ROW:%[0-9]+]], {{%[0-9]+}}) {expr = d1 - d0} : (index, index) -> index
// CHECK-NEXT: [[ZERO:%[0-9]+]] = loop.index() {expr = 0} : () -> index
// CHECK-NEXT: loop.forall([[ZERO]], [[ROWS]]) {level = core} ({
// CHECK-NEXT: ^body([[ROW_UNIT:%[0-9]+]]: index):
// CHECK-NEXT: [[ROW:%[0-9]+]] = loop.index([[FIRST_ROW]], [[ROW_UNIT]]) {expr = d0 + d1} : (index, index) -> index
// CHECK: {{%[0-9]+}} = loop.load([[INPUT]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<6x16xf32, global>, index, index) -> f32
tile.dispatch @taps(%input: tensor<6x16xf32>) -> tensor<6x16xf32> attributes {target = "x86-64-v4@3928f7d3"} {
  %out = tile.block(%input) {iters = [par 6, par 16, red 3], reads = [$0[d0 + d2 - 1, d1] pad -inf], folds = [max -> [d0, d1] held scratch<at = 0>], loops = [d2 by 1, d1 by 8 : workers<level = core>, d0 by 1 : workers<level = core>, d1 by 1], clip = [d0]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<6x16xf32>) -> tensor<6x16xf32>
  func.return(%out) : (tensor<6x16xf32>) -> ()
}
func.func @main(%input: tensor<6x16xf32>) -> tensor<6x16xf32> {
  %out = host.dispatch(%input) {callee = @taps} : (tensor<6x16xf32>) -> tensor<6x16xf32>
  func.return(%out) : (tensor<6x16xf32>) -> ()
}

// -----

// Two loops of workers of one level with the piece of a placed block between them: the piece of 2
// rows starts inside the first, so the second runs a `loop.forall` of its own inside it.
// CHECK: loop.func @rows_added([[INPUT:%[0-9]+]]: !loop.buf<4x4xf32, global>, [[OUTPUT:%[0-9]+]]: !loop.buf<4xf32, global>)
// CHECK: loop.forall({{%[0-9]+}}, {{%[0-9]+}}) {level = core} ({
// CHECK: [[PIECE:%[0-9]+]] = loop.alloc() {shape = [2, 4], dtype = f32} : () -> !loop.buf<2x4xf32, private>
// CHECK: loop.forall({{%[0-9]+}}, {{%[0-9]+}}) {level = core} ({
// CHECK: [[TWICE:%[0-9]+]] = arith.add({{%[0-9]+}}, {{%[0-9]+}}) : (f32, f32) -> f32
// CHECK: loop.store([[TWICE]], [[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (f32, !loop.buf<2x4xf32, private>, index, index) -> ()
// CHECK: {{%[0-9]+}} = loop.load([[PIECE]], {{%[0-9]+}}, {{%[0-9]+}}) : (!loop.buf<2x4xf32, private>, index, index) -> f32
// CHECK: loop.store({{%[0-9]+}}, [[OUTPUT]], {{%[0-9]+}}) : (f32, !loop.buf<4xf32, global>, index) -> ()
tile.dispatch @rows_added(%input: tensor<4x4xf32>) -> tensor<4xf32> attributes {target = "x86-64-v4@3928f7d3"} {
  %doubled = tile.block(%input) {iters = [par 4, par 4], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 2 : workers<level = core>, d1 by 2 : workers<level = core>, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    %twice = arith.add(%element, %element) : (f32, f32) -> f32
    tile.yield(%twice) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4x4xf32>
  %sums = tile.block(%doubled) {iters = [par 4], reads = [$0[d0, 0] at 0, $0[d0, 1], $0[d0, 2], $0[d0, 3]], folds = [none -> [d0]]} ({
  ^body(%first: f32, %second: f32, %third: f32, %fourth: f32):
    %pair_0 = arith.add(%first, %second) : (f32, f32) -> f32
    %pair_1 = arith.add(%third, %fourth) : (f32, f32) -> f32
    %total = arith.add(%pair_0, %pair_1) : (f32, f32) -> f32
    tile.yield(%total) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4xf32>
  func.return(%sums) : (tensor<4xf32>) -> ()
}
func.func @main(%input: tensor<4x4xf32>) -> tensor<4xf32> {
  %out = host.dispatch(%input) {callee = @rows_added} : (tensor<4x4xf32>) -> tensor<4xf32>
  func.return(%out) : (tensor<4xf32>) -> ()
}
