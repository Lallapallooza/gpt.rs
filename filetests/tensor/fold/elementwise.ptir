// RUN: pass fold,dce

// Identities that hold bit for bit fold to the left operand.
// CHECK: func.func @identities
// CHECK-NOT: tensor.mul
// CHECK-NOT: tensor.add
// CHECK-NOT: tensor.sub
// CHECK-NOT: tensor.div
// CHECK: func.return(%0, %0, %0, %0)
func.func @identities(%0: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>, tensor<4xf32>) {
  %1 = tensor.constant() {value = dense<[4] x f32: 1.0>} : () -> tensor<4xf32>
  %2 = tensor.constant() {value = dense<[4] x f32: -0.0>} : () -> tensor<4xf32>
  %3 = tensor.constant() {value = dense<[4] x f32: 0.0>} : () -> tensor<4xf32>
  %4 = tensor.mul(%0, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %5 = tensor.add(%0, %2) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %6 = tensor.sub(%0, %3) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %7 = tensor.div(%0, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%4, %5, %6, %7) : (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>, tensor<4xf32>) -> ()
}

// -----

// `x + 0.0` is not `x`: for `x = -0.0` it is `0.0`. The interpreter check feeds -0.0, so a fold
// here fails.
// CHECK: func.func @plus_zero
// CHECK: tensor.add(%0, {{%[0-9]+}})
func.func @plus_zero(%0: tensor<4xf32>) -> tensor<4xf32> {
  %1 = tensor.constant() {value = dense<[4] x f32: 0.0>} : () -> tensor<4xf32>
  %2 = tensor.add(%0, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%2) : (tensor<4xf32>) -> ()
}

// -----

// A constant on the left of a commutative op moves to the right, where the folder sees it.
// CHECK: func.func @commuted
// CHECK-NOT: tensor.mul
// CHECK: func.return(%0)
func.func @commuted(%0: tensor<4xf32>) -> tensor<4xf32> {
  %1 = tensor.constant() {value = dense<[4] x f32: 1.0>} : () -> tensor<4xf32>
  %2 = tensor.mul(%1, %0) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%2) : (tensor<4xf32>) -> ()
}

// -----

// Integer identities, and `maximum(x, x)`, which is `x`.
// CHECK: func.func @integers
// CHECK-NOT: tensor.
// CHECK: func.return(%0, %0)
func.func @integers(%0: tensor<4xsi32>) -> (tensor<4xsi32>, tensor<4xsi32>) {
  %1 = tensor.constant() {value = dense<[4] x si32: 0>} : () -> tensor<4xsi32>
  %2 = tensor.add(%0, %1) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %3 = tensor.maximum(%2, %2) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%2, %3) : (tensor<4xsi32>, tensor<4xsi32>) -> ()
}

// -----

// The compiler never computes on elements: an op on two non-splat constants stays.
// CHECK: func.func @constants
// CHECK: tensor.add
func.func @constants() -> tensor<2xf32> {
  %0 = tensor.constant() {value = dense<[2] x f32: [1.0, -2.0]>} : () -> tensor<2xf32>
  %1 = tensor.constant() {value = dense<[2] x f32: [2.0, 1.0]>} : () -> tensor<2xf32>
  %2 = tensor.add(%0, %1) : (tensor<2xf32>, tensor<2xf32>) -> tensor<2xf32>
  func.return(%2) : (tensor<2xf32>) -> ()
}

// -----

// neg is an involution and abs is idempotent.
// CHECK: func.func @involution
// CHECK-NEXT: [[A:%[0-9]+]] = tensor.abs(%0)
// CHECK-NEXT: func.return(%0, [[A]])
func.func @involution(%0: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
  %1 = tensor.neg(%0) : (tensor<4xf32>) -> tensor<4xf32>
  %2 = tensor.neg(%1) : (tensor<4xf32>) -> tensor<4xf32>
  %3 = tensor.abs(%0) : (tensor<4xf32>) -> tensor<4xf32>
  %4 = tensor.abs(%3) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%2, %4) : (tensor<4xf32>, tensor<4xf32>) -> ()
}

// -----

// select with a splat predicate, or with equal branches, is one of its branches.
// CHECK: func.func @select
// CHECK-NOT: tensor.select
// CHECK: func.return(%0, %1, %0)
func.func @select(%0: tensor<4xf32>, %1: tensor<4xf32>, %2: tensor<4xi1>) -> (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>) {
  %3 = tensor.constant() {value = dense<[4] x i1: true>} : () -> tensor<4xi1>
  %4 = tensor.constant() {value = dense<[4] x i1: false>} : () -> tensor<4xi1>
  %5 = tensor.select(%3, %0, %1) : (tensor<4xi1>, tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %6 = tensor.select(%4, %0, %1) : (tensor<4xi1>, tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %7 = tensor.select(%2, %0, %0) : (tensor<4xi1>, tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%5, %6, %7) : (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>) -> ()
}

// -----

// A cast to the input's own dtype is the input.
// CHECK: func.func @cast
// CHECK-NOT: tensor.cast
// CHECK: func.return(%0)
func.func @cast(%0: tensor<4xf32>) -> tensor<4xf32> {
  %1 = tensor.cast(%0) {to = f32} : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%1) : (tensor<4xf32>) -> ()
}

// -----

// An absorbing integer constant is the result. Float `x * 0.0` stays: `inf * 0.0` is NaN.
// CHECK: func.func @absorbing
// CHECK-NEXT: [[Z:%[0-9]+]] = tensor.constant() {value = dense<[4] x si32: 0>}
// CHECK-NEXT: [[M:%[0-9]+]] = tensor.constant() {value = dense<[4] x si32: 2147483647>}
// CHECK-NEXT: [[F:%[0-9]+]] = tensor.constant() {value = dense<[4] x f32: 0.0>}
// CHECK-NEXT: [[P:%[0-9]+]] = tensor.mul(%1, [[F]])
// CHECK-NEXT: func.return([[Z]], [[M]], [[P]])
func.func @absorbing(%0: tensor<4xsi32>, %1: tensor<4xf32>) -> (tensor<4xsi32>, tensor<4xsi32>, tensor<4xf32>) {
  %2 = tensor.constant() {value = dense<[4] x si32: 0>} : () -> tensor<4xsi32>
  %3 = tensor.constant() {value = dense<[4] x si32: 2147483647>} : () -> tensor<4xsi32>
  %4 = tensor.constant() {value = dense<[4] x f32: 0.0>} : () -> tensor<4xf32>
  %5 = tensor.mul(%0, %2) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %6 = tensor.maximum(%3, %0) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %7 = tensor.mul(%1, %4) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%5, %6, %7) : (tensor<4xsi32>, tensor<4xsi32>, tensor<4xf32>) -> ()
}
