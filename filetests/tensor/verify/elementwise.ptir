// -----
// ERROR: tensor.cast: to must be an i1, integer, float or narrow float dtype, got e8m0
func.func @cast_to_e8m0(%input: tensor<4xf32>) -> tensor<4xe8m0> {
  %scales = tensor.cast(%input) {to = e8m0} : (tensor<4xf32>) -> tensor<4xe8m0>
  func.return(%scales) : (tensor<4xe8m0>) -> ()
}
