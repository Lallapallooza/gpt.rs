  ^body(%position: index):
    %element = loop.load(%input, %position) : (!loop.buf<64xf64, global>, index) -> f64
    %power = arith.exp(%element) : (f64) -> f64
    loop.store(%power, %output, %position) : (f64, !loop.buf<64xf64, global>, index) -> ()
    loop.yield() : () -> ()
  }) : (index, index) -> ()
  loop.return() : () -> ()
}
func.func @main(%input: tensor<64xf64>) -> tensor<64xf64> {
