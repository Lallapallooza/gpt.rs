// RUN: pass canonicalize

// Integer sums merge: wrapping addition combines in any order and grouping.
// CHECK: func.func @int_merge([[INPUT:%[0-9]+]]: tensor<2x3xsi32>) -> tensor<si32> {
// CHECK-NEXT: [[TOTAL:%[0-9]+]] = tensor.reduce_sum([[INPUT]]) {axes = [0, 1]} : (tensor<2x3xsi32>) -> tensor<si32>
// CHECK-NEXT: func.return([[TOTAL]])
func.func @int_merge(%input: tensor<2x3xsi32>) -> tensor<si32> {
  %row_sums = tensor.reduce_sum(%input) {axes = [1]} : (tensor<2x3xsi32>) -> tensor<2xsi32>
  %total = tensor.reduce_sum(%row_sums) {axes = [0]} : (tensor<2xsi32>) -> tensor<si32>
  func.return(%total) : (tensor<si32>) -> ()
}

// -----
// An integer sum of a concatenation adds the sums of the parts.
// CHECK: func.func @int_of_concat([[TOP:%[0-9]+]]: tensor<2x3xsi32>, [[BOTTOM:%[0-9]+]]: tensor<1x3xsi32>) -> tensor<3xsi32> {
// CHECK-NEXT: [[TOP_SUMS:%[0-9]+]] = tensor.reduce_sum([[TOP]]) {axes = [0]} : (tensor<2x3xsi32>) -> tensor<3xsi32>
// CHECK-NEXT: [[BOTTOM_SUMS:%[0-9]+]] = tensor.reduce_sum([[BOTTOM]]) {axes = [0]} : (tensor<1x3xsi32>) -> tensor<3xsi32>
// CHECK-NEXT: [[COLUMN_SUMS:%[0-9]+]] = tensor.add([[TOP_SUMS]], [[BOTTOM_SUMS]])
// CHECK-NEXT: func.return([[COLUMN_SUMS]])
func.func @int_of_concat(%top: tensor<2x3xsi32>, %bottom: tensor<1x3xsi32>) -> tensor<3xsi32> {
  %joined = tensor.concat(%top, %bottom) {axis = 0} : (tensor<2x3xsi32>, tensor<1x3xsi32>) -> tensor<3x3xsi32>
  %column_sums = tensor.reduce_sum(%joined) {axes = [0]} : (tensor<3x3xsi32>) -> tensor<3xsi32>
  func.return(%column_sums) : (tensor<3xsi32>) -> ()
}

// -----
// An accumulator or result dtype equal to the default is left out, here for integer dots and
// windows.
// CHECK: func.func @int_defaults([[LHS:%[0-9]+]]: tensor<2x3xsi32>, [[RHS:%[0-9]+]]: tensor<3x2xsi32>, [[SEQUENCE:%[0-9]+]]: tensor<4xsi32>) -> (tensor<2x2xsi32>, tensor<4xsi32>) {
// CHECK-NEXT: tensor.dot_general([[LHS]], [[RHS]]) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xsi32>, tensor<3x2xsi32>) -> tensor<2x2xsi32>
// CHECK-NEXT: tensor.reduce_window_max([[SEQUENCE]]) {window_dims = [2], strides = [1], padding = [(1, 0)], base_dilation = [1], window_dilation = [1]} : (tensor<4xsi32>) -> tensor<4xsi32>
func.func @int_defaults(%lhs: tensor<2x3xsi32>, %rhs: tensor<3x2xsi32>, %sequence: tensor<4xsi32>) -> (tensor<2x2xsi32>, tensor<4xsi32>) {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0], out = si32} : (tensor<2x3xsi32>, tensor<3x2xsi32>) -> tensor<2x2xsi32>
  %pooled = tensor.reduce_window_max(%sequence) {window_dims = [2], strides = [1], padding = [(1, 0)], base_dilation = [1], window_dilation = [1], accum = si32} : (tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%product, %pooled) : (tensor<2x2xsi32>, tensor<4xsi32>) -> ()
}

// -----
// Arithmetic, casts and comparisons of bf16 broadcasts run on the broadcast inputs.
// CHECK: func.func @bf16_hoist([[LHS:%[0-9]+]]: tensor<3xbf16>, [[RHS:%[0-9]+]]: tensor<3xbf16>) -> (tensor<2x3xsi32>, tensor<2x3xbf16>) {
// CHECK-NEXT: [[PRODUCT:%[0-9]+]] = tensor.mul([[LHS]], [[RHS]]) : (tensor<3xbf16>, tensor<3xbf16>) -> tensor<3xbf16>
// CHECK-NEXT: [[EXP:%[0-9]+]] = tensor.exp([[PRODUCT]]) : (tensor<3xbf16>) -> tensor<3xbf16>
// CHECK-NEXT: [[AS_INT:%[0-9]+]] = tensor.cast([[EXP]]) {to = si32} : (tensor<3xbf16>) -> tensor<3xsi32>
// CHECK-NEXT: [[WIDE_AS_INT:%[0-9]+]] = tensor.broadcast_to([[AS_INT]]) {shape = [2, 3]}
// CHECK-NEXT: [[BELOW:%[0-9]+]] = tensor.less([[PRODUCT]], [[EXP]]) : (tensor<3xbf16>, tensor<3xbf16>) -> tensor<3xi1>
// CHECK-NEXT: [[BELOW_BF16:%[0-9]+]] = tensor.cast([[BELOW]]) {to = bf16} : (tensor<3xi1>) -> tensor<3xbf16>
// CHECK-NEXT: [[WIDE_BELOW_BF16:%[0-9]+]] = tensor.broadcast_to([[BELOW_BF16]]) {shape = [2, 3]}
// CHECK-NEXT: func.return([[WIDE_AS_INT]], [[WIDE_BELOW_BF16]])
func.func @bf16_hoist(%lhs: tensor<3xbf16>, %rhs: tensor<3xbf16>) -> (tensor<2x3xsi32>, tensor<2x3xbf16>) {
  %wide_lhs = tensor.broadcast_to(%lhs) {shape = [2, 3]} : (tensor<3xbf16>) -> tensor<2x3xbf16>
  %wide_rhs = tensor.broadcast_to(%rhs) {shape = [2, 3]} : (tensor<3xbf16>) -> tensor<2x3xbf16>
  %product = tensor.mul(%wide_lhs, %wide_rhs) : (tensor<2x3xbf16>, tensor<2x3xbf16>) -> tensor<2x3xbf16>
  %exp = tensor.exp(%product) : (tensor<2x3xbf16>) -> tensor<2x3xbf16>
  %as_int = tensor.cast(%exp) {to = si32} : (tensor<2x3xbf16>) -> tensor<2x3xsi32>
  %below = tensor.less(%product, %exp) : (tensor<2x3xbf16>, tensor<2x3xbf16>) -> tensor<2x3xi1>
  %below_bf16 = tensor.cast(%below) {to = bf16} : (tensor<2x3xi1>) -> tensor<2x3xbf16>
  func.return(%as_int, %below_bf16) : (tensor<2x3xsi32>, tensor<2x3xbf16>) -> ()
}
