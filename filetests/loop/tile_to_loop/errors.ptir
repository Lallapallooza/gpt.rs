// RUN: pass tile-to-loop

// ERROR: tile-to-loop: tile.block: failed to legalize: a block lowers in a dispatch; seal-dispatches outlines it into one
func.func @unsealed(%input: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%input) {iters = [par 4], reads = [$0[d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile-to-loop: tile.dispatch: failed to legalize: DispatchToLoop: tensor<{N}xf32> crosses blocks in private scratch, whose extents are static
tile.dispatch @symbolic(%input: tensor<{N}xf32>) -> tensor<{N}xf32> {
  %doubled = tile.block(%input) {iters = [par {N}], reads = [$0[d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    %sum = arith.add(%element, %element) : (f32, f32) -> f32
    tile.yield(%sum) : (f32) -> ()
  }) : (tensor<{N}xf32>) -> tensor<{N}xf32>
  %squared = tile.block(%doubled) {iters = [par {N}], reads = [$0[d0]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    %product = arith.mul(%element, %element) : (f32, f32) -> f32
    tile.yield(%product) : (f32) -> ()
  }) : (tensor<{N}xf32>) -> tensor<{N}xf32>
  func.return(%squared) : (tensor<{N}xf32>) -> ()
}
