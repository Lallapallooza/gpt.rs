// RUN: pass canonicalize

// Nested reductions of one kind merge into one over the axes of both, reshaped to the result. The
// inner reduction's axes are axes of the input. The outer reduction's axes are axes of the inner
// result, so axis 1 of the inner result below is axis 2 of the input.
// CHECK: func.func @merge([[INPUT:%[0-9]+]]: tensor<2x3x3xf32>) -> (tensor<3xf32>, tensor<2x1xf32>) {
// CHECK-NEXT: [[MAX:%[0-9]+]] = tensor.reduce_max([[INPUT]]) {axes = [0, 2]} : (tensor<2x3x3xf32>) -> tensor<3xf32>
// CHECK-NEXT: [[MERGED_MIN:%[0-9]+]] = tensor.reduce_min([[INPUT]]) {axes = [1, 2]} : (tensor<2x3x3xf32>) -> tensor<2xf32>
// CHECK-NEXT: [[MIN:%[0-9]+]] = tensor.reshape([[MERGED_MIN]]) {shape = [2, 1]}
// CHECK-NEXT: func.return([[MAX]], [[MIN]])
func.func @merge(%input: tensor<2x3x3xf32>) -> (tensor<3xf32>, tensor<2x1xf32>) {
  %inner_max = tensor.reduce_max(%input) {axes = [0]} : (tensor<2x3x3xf32>) -> tensor<3x3xf32>
  %max = tensor.reduce_max(%inner_max) {axes = [1]} : (tensor<3x3xf32>) -> tensor<3xf32>
  %inner_min = tensor.reduce_min(%input) {axes = [1], keepdims = true} : (tensor<2x3x3xf32>) -> tensor<2x1x3xf32>
  %min = tensor.reduce_min(%inner_min) {axes = [2]} : (tensor<2x1x3xf32>) -> tensor<2x1xf32>
  func.return(%max, %min) : (tensor<3xf32>, tensor<2x1xf32>) -> ()
}

// -----

// Float sums do not merge: they would add in another order.
// CHECK: func.func @sum_stays([[INPUT:%[0-9]+]]: tensor<2x3xf32>) -> tensor<1xf32> {
// CHECK: tensor.reduce_sum([[INPUT]]) {axes = [1], keepdims = true}
// CHECK-NEXT: tensor.reduce_sum
func.func @sum_stays(%input: tensor<2x3xf32>) -> tensor<1xf32> {
  %row_sums = tensor.reduce_sum(%input) {axes = [1], keepdims = true} : (tensor<2x3xf32>) -> tensor<2x1xf32>
  %total = tensor.reduce_sum(%row_sums) {axes = [0]} : (tensor<2x1xf32>) -> tensor<1xf32>
  func.return(%total) : (tensor<1xf32>) -> ()
}

// -----

// A max over the axes a broadcast repeats along is the broadcast's input: copies of one element
// combine to it.
// CHECK: func.func @of_broadcast([[INPUT:%[0-9]+]]: tensor<3xf32>) -> (tensor<3xf32>, tensor<3x1xf32>) {
// CHECK-NEXT: [[COLUMN_MAX:%[0-9]+]] = tensor.reshape([[INPUT]]) {shape = [3, 1]}
// CHECK-NEXT: func.return([[INPUT]], [[COLUMN_MAX]])
func.func @of_broadcast(%input: tensor<3xf32>) -> (tensor<3xf32>, tensor<3x1xf32>) {
  %rows = tensor.broadcast_to(%input) {shape = [2, 3]} : (tensor<3xf32>) -> tensor<2x3xf32>
  %row_max = tensor.reduce_max(%rows) {axes = [0]} : (tensor<2x3xf32>) -> tensor<3xf32>
  %column = tensor.reshape(%input) {shape = [1, 3, 1]} : (tensor<3xf32>) -> tensor<1x3x1xf32>
  %repeated = tensor.broadcast_to(%column) {shape = [5, 3, 4]} : (tensor<1x3x1xf32>) -> tensor<5x3x4xf32>
  %repeated_max = tensor.reduce_max(%repeated) {axes = [0, 2], keepdims = true} : (tensor<5x3x4xf32>) -> tensor<1x3x1xf32>
  %column_max = tensor.reshape(%repeated_max) {shape = [3, 1]} : (tensor<1x3x1xf32>) -> tensor<3x1xf32>
  func.return(%row_max, %column_max) : (tensor<3xf32>, tensor<3x1xf32>) -> ()
}

// -----

// The reduction stays when it does not cover every repeated axis, when it covers a dynamic axis
// that may have no elements, or when it is a sum. `%sequence` binds `N` for the run.
// CHECK: func.func @broadcast_stays
// CHECK: tensor.reduce_max({{%[0-9]+}}) {axes = [0]} : (tensor<2x4x3xf32>)
// CHECK: tensor.reduce_max({{%[0-9]+}}) {axes = [0]} : (tensor<{N}x3xf32>)
// CHECK: tensor.reduce_sum
func.func @broadcast_stays(%row: tensor<1x3xf32>, %sequence: tensor<{N}xf32>) -> (tensor<4x3xf32>, tensor<3xf32>, tensor<3xf32>) {
  %stacked = tensor.broadcast_to(%row) {shape = [2, 4, 3]} : (tensor<1x3xf32>) -> tensor<2x4x3xf32>
  %stacked_max = tensor.reduce_max(%stacked) {axes = [0]} : (tensor<2x4x3xf32>) -> tensor<4x3xf32>
  %dynamic = tensor.broadcast_to(%row) {shape = [{N}, 3]} : (tensor<1x3xf32>) -> tensor<{N}x3xf32>
  %dynamic_max = tensor.reduce_max(%dynamic) {axes = [0]} : (tensor<{N}x3xf32>) -> tensor<3xf32>
  %pair = tensor.broadcast_to(%row) {shape = [2, 3]} : (tensor<1x3xf32>) -> tensor<2x3xf32>
  %pair_sum = tensor.reduce_sum(%pair) {axes = [0]} : (tensor<2x3xf32>) -> tensor<3xf32>
  func.return(%stacked_max, %dynamic_max, %pair_sum) : (tensor<4x3xf32>, tensor<3xf32>, tensor<3xf32>) -> ()
}

// -----

// A max over the concatenated axis is the maximum of the parts' maxima.
// CHECK: func.func @of_concat([[LEFT:%[0-9]+]]: tensor<2x3xf32>, [[RIGHT:%[0-9]+]]: tensor<2x5xf32>) -> tensor<2xf32> {
// CHECK-NEXT: [[LEFT_MAX:%[0-9]+]] = tensor.reduce_max([[LEFT]]) {axes = [1]} : (tensor<2x3xf32>) -> tensor<2xf32>
// CHECK-NEXT: [[RIGHT_MAX:%[0-9]+]] = tensor.reduce_max([[RIGHT]]) {axes = [1]} : (tensor<2x5xf32>) -> tensor<2xf32>
// CHECK-NEXT: [[MAX:%[0-9]+]] = tensor.maximum([[LEFT_MAX]], [[RIGHT_MAX]])
// CHECK-NEXT: func.return([[MAX]])
func.func @of_concat(%left: tensor<2x3xf32>, %right: tensor<2x5xf32>) -> tensor<2xf32> {
  %joined = tensor.concat(%left, %right) {axis = 1} : (tensor<2x3xf32>, tensor<2x5xf32>) -> tensor<2x8xf32>
  %max = tensor.reduce_max(%joined) {axes = [1]} : (tensor<2x8xf32>) -> tensor<2xf32>
  func.return(%max) : (tensor<2xf32>) -> ()
}

// -----

// Nested reductions stay apart when they differ in kind, or when the inner one has another use.
// CHECK: func.func @merge_stays([[INPUT:%[0-9]+]]: tensor<2x3xf32>) -> (tensor<1xf32>, tensor<1xf32>, tensor<2xf32>) {
// CHECK-NEXT: [[COLUMN_MAX:%[0-9]+]] = tensor.reduce_max([[INPUT]]) {axes = [0]}
// CHECK-NEXT: tensor.reduce_min([[COLUMN_MAX]]) {axes = [0], keepdims = true}
// CHECK-NEXT: [[ROW_MAX:%[0-9]+]] = tensor.reduce_max([[INPUT]]) {axes = [1]}
// CHECK-NEXT: tensor.reduce_max([[ROW_MAX]]) {axes = [0], keepdims = true}
func.func @merge_stays(%input: tensor<2x3xf32>) -> (tensor<1xf32>, tensor<1xf32>, tensor<2xf32>) {
  %column_max = tensor.reduce_max(%input) {axes = [0]} : (tensor<2x3xf32>) -> tensor<3xf32>
  %min_of_column_max = tensor.reduce_min(%column_max) {axes = [0], keepdims = true} : (tensor<3xf32>) -> tensor<1xf32>
  %row_max = tensor.reduce_max(%input) {axes = [1]} : (tensor<2x3xf32>) -> tensor<2xf32>
  %max_of_row_max = tensor.reduce_max(%row_max) {axes = [0], keepdims = true} : (tensor<2xf32>) -> tensor<1xf32>
  func.return(%min_of_column_max, %max_of_row_max, %row_max) : (tensor<1xf32>, tensor<1xf32>, tensor<2xf32>) -> ()
}

// -----

// A reduction with its own result dtype keeps its input.
// CHECK: func.func @merge_out([[INPUT:%[0-9]+]]: tensor<2x3xbf16>) -> tensor<1xf32> {
// CHECK-NEXT: [[COLUMN_MAX:%[0-9]+]] = tensor.reduce_max([[INPUT]]) {axes = [0], out = f32}
// CHECK-NEXT: tensor.reduce_max([[COLUMN_MAX]])
func.func @merge_out(%input: tensor<2x3xbf16>) -> tensor<1xf32> {
  %column_max = tensor.reduce_max(%input) {axes = [0], out = f32} : (tensor<2x3xbf16>) -> tensor<3xf32>
  %max = tensor.reduce_max(%column_max) {axes = [0], keepdims = true} : (tensor<3xf32>) -> tensor<1xf32>
  func.return(%max) : (tensor<1xf32>) -> ()
}

// -----

// A max that also reduces an axis the broadcast does not repeat stays, and so does a max of a
// concat over another axis.
// CHECK: func.func @partial_stays
// CHECK: tensor.reduce_max({{%[0-9]+}}) {axes = [0, 1], keepdims = true} : (tensor<2x3xf32>)
// CHECK: tensor.reduce_max({{%[0-9]+}}) {axes = [0]} : (tensor<2x6xf32>)
func.func @partial_stays(%row: tensor<1x3xf32>, %matrix: tensor<2x3xf32>) -> (tensor<1x1xf32>, tensor<6xf32>) {
  %rows = tensor.broadcast_to(%row) {shape = [2, 3]} : (tensor<1x3xf32>) -> tensor<2x3xf32>
  %rows_max = tensor.reduce_max(%rows) {axes = [0, 1], keepdims = true} : (tensor<2x3xf32>) -> tensor<1x1xf32>
  %joined = tensor.concat(%matrix, %matrix) {axis = 1} : (tensor<2x3xf32>, tensor<2x3xf32>) -> tensor<2x6xf32>
  %column_max = tensor.reduce_max(%joined) {axes = [0]} : (tensor<2x6xf32>) -> tensor<6xf32>
  func.return(%rows_max, %column_max) : (tensor<1x1xf32>, tensor<6xf32>) -> ()
}
