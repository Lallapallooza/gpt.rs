// RUN: pass canonicalize

// Static operands of an associative op gather into one static value, which the backend computes
// at load time.
// CHECK: func.func @gather
// CHECK-NEXT: [[W:%[0-9]+]] = tensor.maximum(%1, %2)
// CHECK-NEXT: [[M:%[0-9]+]] = tensor.maximum(%0, [[W]])
// CHECK-NEXT: func.return([[M]])
func.func @gather(%0: tensor<4xf32>, %1: tensor<4xf32> {param = 1}, %2: tensor<4xf32> {param = 2}) -> tensor<4xf32> {
  %3 = tensor.maximum(%1, %0) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %4 = tensor.maximum(%3, %2) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%4) : (tensor<4xf32>) -> ()
}

// -----

// Static operands do not gather when the inner op has another use.
// CHECK: func.func @gather_shared
// CHECK-NEXT: [[I:%[0-9]+]] = tensor.maximum(%0, %1)
// CHECK-NEXT: tensor.maximum([[I]], %2)
func.func @gather_shared(%0: tensor<4xf32>, %1: tensor<4xf32> {param = 1}, %2: tensor<4xf32> {param = 2}) -> (tensor<4xf32>, tensor<4xf32>) {
  %3 = tensor.maximum(%0, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %4 = tensor.maximum(%3, %2) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%4, %3) : (tensor<4xf32>, tensor<4xf32>) -> ()
}

// -----

// Integer addition regroups. Float addition does not: regrouped, it rounds differently.
// CHECK: func.func @regroup
// CHECK: [[C:%[0-9]+]] = tensor.add({{%[0-9]+}}, {{%[0-9]+}}) : (tensor<4xsi32>
// CHECK-NEXT: tensor.add(%0, [[C]])
// CHECK: [[F:%[0-9]+]] = tensor.add(%1, {{%[0-9]+}})
// CHECK-NEXT: tensor.add([[F]], {{%[0-9]+}})
func.func @regroup(%0: tensor<4xsi32>, %1: tensor<4xf32>, %2: tensor<4xsi32> {param = 1}, %3: tensor<4xf32> {param = 2}) -> (tensor<4xsi32>, tensor<4xf32>) {
  %4 = tensor.constant() {value = dense<[4] x si32: 5>} : () -> tensor<4xsi32>
  %5 = tensor.add(%0, %2) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %6 = tensor.add(%5, %4) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %7 = tensor.constant() {value = dense<[4] x f32: 5.0>} : () -> tensor<4xf32>
  %8 = tensor.add(%1, %3) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %9 = tensor.add(%8, %7) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%6, %9) : (tensor<4xsi32>, tensor<4xf32>) -> ()
}

// -----

// Integer multiplication distributes over addition, so a shared factor comes out, on either side
// of the commutative multiplication.
// CHECK: func.func @factor
// CHECK-NEXT: [[S:%[0-9]+]] = tensor.add(%1, %2)
// CHECK-NEXT: [[P:%[0-9]+]] = tensor.mul(%0, [[S]])
// CHECK-NEXT: func.return([[P]])
func.func @factor(%0: tensor<4xsi32>, %1: tensor<4xsi32>, %2: tensor<4xsi32>) -> tensor<4xsi32> {
  %3 = tensor.mul(%0, %1) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %4 = tensor.mul(%2, %0) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %5 = tensor.add(%3, %4) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%5) : (tensor<4xsi32>) -> ()
}

// -----

// Float multiplication does not distribute exactly, and a product with another use stays.
// CHECK: func.func @no_factor
// CHECK: tensor.mul(%0, %1)
// CHECK: tensor.mul(%0, %2)
// CHECK: tensor.add
// CHECK: tensor.mul(%3, %4)
// CHECK: tensor.mul(%3, %5)
func.func @no_factor(%0: tensor<4xf32>, %1: tensor<4xf32>, %2: tensor<4xf32>, %3: tensor<4xsi32>, %4: tensor<4xsi32>, %5: tensor<4xsi32>) -> (tensor<4xf32>, tensor<4xsi32>, tensor<4xsi32>) {
  %6 = tensor.mul(%0, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %7 = tensor.mul(%0, %2) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %8 = tensor.add(%6, %7) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  %9 = tensor.mul(%3, %4) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %10 = tensor.mul(%3, %5) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  %11 = tensor.add(%9, %10) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%8, %11, %9) : (tensor<4xf32>, tensor<4xsi32>, tensor<4xsi32>) -> ()
}
