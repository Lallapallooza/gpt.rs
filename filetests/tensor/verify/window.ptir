// -----
// ERROR: tensor.reduce_window_min: the dilated input overflows on axis 0
func.func @window_base_dilation_overflow(%input: tensor<4xf32>) -> tensor<4xf32> {
  %min = tensor.reduce_window_min(%input) {window_dims = [1], strides = [1], padding = [(0, 0)], base_dilation = [9223372036854775807], window_dilation = [1]} : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%min) : (tensor<4xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_min: the padded input overflows on axis 0
func.func @window_padding_overflow(%input: tensor<4xf32>) -> tensor<4xf32> {
  %min = tensor.reduce_window_min(%input) {window_dims = [1], strides = [1], padding = [(18446744073709551615, 0)], base_dilation = [1], window_dilation = [1]} : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%min) : (tensor<4xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_min: the dilated window overflows on axis 0
func.func @window_dilation_overflow(%input: tensor<4xf32>) -> tensor<1xf32> {
  %min = tensor.reduce_window_min(%input) {window_dims = [4], strides = [1], padding = [(0, 0)], base_dilation = [1], window_dilation = [9223372036854775807]} : (tensor<4xf32>) -> tensor<1xf32>
  func.return(%min) : (tensor<1xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_min: window extent 3 exceeds padded input extent 2 on axis 0
func.func @window_too_large(%input: tensor<2x4xf32>) -> tensor<1x4xf32> {
  %min = tensor.reduce_window_min(%input) {window_dims = [3, 1], strides = [1, 1], padding = [(0, 0), (0, 0)], base_dilation = [1, 1], window_dilation = [1, 1]} : (tensor<2x4xf32>) -> tensor<1x4xf32>
  func.return(%min) : (tensor<1x4xf32>) -> ()
}
