// RUN: pass tensor-to-tile, canonicalize

// A splat operand is a constant in the body.
// CHECK: func.func @splat_operand([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK: tile.block([[INPUT]]) {iters = [par 4], reads = [$0[d0]], folds = [none -> [d0]]}
// CHECK: arith.constant() {value = 2.0 : f32}
// CHECK-NOT: tensor.constant
func.func @splat_operand(%input: tensor<4xf32>) -> tensor<4xf32> {
  %twos = tensor.constant() {value = dense<4xf32: 2.0>} : () -> tensor<4xf32>
  %doubled = tensor.mul(%input, %twos) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%doubled) : (tensor<4xf32>) -> ()
}

// -----

// `x * 1.0` folds in the body, and the block that copies its operand is the operand.
// CHECK: func.func @multiply_by_one([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK-NEXT: func.return([[INPUT]])
func.func @multiply_by_one(%input: tensor<4xf32>) -> tensor<4xf32> {
  %ones = tensor.constant() {value = dense<4xf32: 1.0>} : () -> tensor<4xf32>
  %product = tensor.mul(%input, %ones) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%product) : (tensor<4xf32>) -> ()
}

// -----

// `x * 0` folds to the zero in the body, and the read of `x` is removed.
// CHECK: tile.block() {iters = [par 4], reads = [], folds = [none -> [d0]]}
// CHECK-NEXT: arith.constant() {value = 0 : si32}
func.func @multiply_by_zero(%input: tensor<4xsi32>) -> tensor<4xsi32> {
  %zeros = tensor.constant() {value = dense<4xsi32: 0>} : () -> tensor<4xsi32>
  %product = tensor.mul(%input, %zeros) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%product) : (tensor<4xsi32>) -> ()
}

// -----

// Iterators of extent 1 are 0.
// CHECK: func.func @unit_axes([[INPUT:%[0-9]+]]: tensor<4x1xf32>)
// CHECK: tile.block([[INPUT]]) {iters = [par 4], reads = [$0[d0, 0]], folds = [sum -> [d0, 0]]}
// CHECK: tile.block([[INPUT]]) {iters = [par 4], reads = [$0[d0, 0]], folds = [none -> [0, d0]]}
func.func @unit_axes(%input: tensor<4x1xf32>) -> (tensor<4x1xf32>, tensor<1x4xf32>) {
  %sums = tensor.reduce_sum(%input) {axes = [1], keepdims = true} : (tensor<4x1xf32>) -> tensor<4x1xf32>
  %transposed = tensor.transpose(%input) {perm = [1, 0]} : (tensor<4x1xf32>) -> tensor<1x4xf32>
  %exponentials = tensor.exp(%transposed) : (tensor<1x4xf32>) -> tensor<1x4xf32>
  func.return(%sums, %exponentials) : (tensor<4x1xf32>, tensor<1x4xf32>) -> ()
}

// -----

// Index expressions take their canonical form: the row-major position of `[d0, d1, d2]` in
// `[4, 2, 3]`, divided by 6, is `d0`, since `d1 * 3 + d2` is below 6.
// CHECK: func.func @split_axis([[INPUT:%[0-9]+]]: tensor<4x6xf32>)
// CHECK: tile.block([[INPUT]]) {iters = [par 4, par 2, par 3], reads = [$0[d0, d1 * 3 + d2]]
func.func @split_axis(%input: tensor<4x6xf32>) -> tensor<4x2x3xf32> {
  %split = tensor.reshape(%input) {shape = [4, 2, 3]} : (tensor<4x6xf32>) -> tensor<4x2x3xf32>
  func.return(%split) : (tensor<4x2x3xf32>) -> ()
}

// -----

// `x * x` reads `x` once, and multiplies that element by itself.
// CHECK: func.func @square([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK-NEXT: tile.block([[INPUT]]) {iters = [par 4], reads = [$0[d0]], folds = [none -> [d0]]}
// CHECK-NEXT: ^body([[ELEMENT:%[0-9]+]]: f32):
// CHECK-NEXT: arith.mul([[ELEMENT]], [[ELEMENT]])
func.func @square(%input: tensor<4xf32>) -> tensor<4xf32> {
  %squares = tensor.mul(%input, %input) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%squares) : (tensor<4xf32>) -> ()
}
