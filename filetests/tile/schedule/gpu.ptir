// RUN: pass schedule {target = "%S/gpu-shaped.toml"}

// The L2, which all 8 warps share, takes in each element once under every split whose parts fit
// it, so the tile that loads the fewest vectors decides: 4 rows by 4 vectors, the warps taking 2
// parts of 64 lanes by 4 of 8 rows. A warp's two tiles of rows read its 4 KiB of the weight, which
// is copied into its part of the shared memory once; each reads its own rows of the input.
// CHECK: reads = [$0[d0, d2], $1[d2, d1] held copy<level = shared, at = 1>], folds = [sum -> [d0, d1]], loops = [d1 by 64 : workers<level = warp>, d0 by 8 : workers<level = warp>, d0 by 4, d2 by 1, d0 by 4 : reg, d1 by 64 : reg, d1 by 16 : lanes]
tile.dispatch @projection(%input: tensor<32x16xf32>, %weight: tensor<16x128xf32>) -> tensor<32x128xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true>} {
  %product = tile.block(%input, %weight) {iters = [par 32, par 128, red 16], reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]], loops = [d0 by 1, d1 by 16, d2 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<32x16xf32>, tensor<16x128xf32>) -> tensor<32x128xf32>
  func.return(%product) : (tensor<32x128xf32>) -> ()
}
func.func @main(%input: tensor<32x16xf32>, %weight: tensor<16x128xf32>) -> tensor<32x128xf32> {
  %result = host.dispatch(%input, %weight) {callee = @projection} : (tensor<32x16xf32>, tensor<16x128xf32>) -> tensor<32x128xf32>
  func.return(%result) : (tensor<32x128xf32>) -> ()
}

// -----

// Each warp sums 64 lanes; every element is read once, so nothing is copied.
// CHECK: reads = [$0[d1, d0]], folds = [sum -> [d0]], loops = [d0 by 64 : workers<level = warp>, d1 by 1, d0 by 64 : reg, d0 by 16 : lanes]
tile.dispatch @row_sums(%input: tensor<64x256xf32>) -> tensor<256xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true>} {
  %sums = tile.block(%input) {iters = [par 256, red 64], reads = [$0[d1, d0]], folds = [sum -> [d0]], loops = [d0 by 16, d1 by 1, d0 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<64x256xf32>) -> tensor<256xf32>
  func.return(%sums) : (tensor<256xf32>) -> ()
}
func.func @main(%input: tensor<64x256xf32>) -> tensor<256xf32> {
  %result = host.dispatch(%input) {callee = @row_sums} : (tensor<64x256xf32>) -> tensor<256xf32>
  func.return(%result) : (tensor<256xf32>) -> ()
}

// -----

// Warps that take 32 lanes each move 8,320 bytes into the L2 they share, the factor arriving once,
// with tiles of 8 rows; tiles of 13 rows, which load fewer vectors, take one line more. A warp's 8
// tiles of rows read its 128 bytes of the factor, which are copied into its shared memory once.
// CHECK: reads = [$0[d0, d1], $1[d1] held copy<level = shared, at = 0>], folds = [none -> [d0, d1]], loops = [d1 by 32 : workers<level = warp>, d1 by 16, d0 by 8, d0 by 8 : reg, d1 by 16 : lanes]
tile.dispatch @scale(%input: tensor<64x256xf32>, %factor: tensor<256xf32>) -> tensor<64x256xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true>} {
  %scaled = tile.block(%input, %factor) {iters = [par 64, par 256], reads = [$0[d0, d1], $1[d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 16, d1 by 16 : lanes]} ({
  ^body(%element: f32, %by: f32):
    %product = arith.mul(%element, %by) : (f32, f32) -> f32
    tile.yield(%product) : (f32) -> ()
  }) : (tensor<64x256xf32>, tensor<256xf32>) -> tensor<64x256xf32>
  func.return(%scaled) : (tensor<64x256xf32>) -> ()
}
func.func @main(%input: tensor<64x256xf32>, %factor: tensor<256xf32>) -> tensor<64x256xf32> {
  %result = host.dispatch(%input, %factor) {callee = @scale} : (tensor<64x256xf32>, tensor<256xf32>) -> tensor<64x256xf32>
  func.return(%result) : (tensor<64x256xf32>) -> ()
}

// -----

// Tiles of 4 columns by 2 vectors let 4 warps take one each, 2 rows by 2 parts of the columns, so
// that the busiest warp moves the fewest bytes into the L2. Its input over the 3 kernel rows,
// which the taps read again, is copied into the warp's shared memory once for its part. The weight
// is read once by each warp's one tile.
// CHECK: reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d5] pad 0.0 held copy<level = shared, at = 1>, $1[d5, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d0 by 1 : workers<level = warp>, d1 by 4 : workers<level = warp>, d3 by 1, d4 by 1, d5 by 1, d1 by 4 : reg, d2 by 32 : reg, d2 by 16 : lanes]
tile.dispatch @conv(%input: tensor<1x2x7x8xf32>, %weight: tensor<8x3x3x32xf32>) -> tensor<1x2x7x32xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true>} {
  %output = tile.block(%input, %weight) {iters = [par 2, par 7, par 32, red 3, red 3, red 8], reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d5] pad 0.0, $1[d5, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d0 by 1, d1 by 1, d2 by 16, d3 by 1, d4 by 1, d5 by 1, d2 by 16 : lanes]} ({
  ^body(%pixel: f32, %tap: f32):
    %term = arith.mul(%pixel, %tap) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<1x2x7x8xf32>, tensor<8x3x3x32xf32>) -> tensor<1x2x7x32xf32>
  func.return(%output) : (tensor<1x2x7x32xf32>) -> ()
}
func.func @main(%input: tensor<1x2x7x8xf32>, %weight: tensor<8x3x3x32xf32>) -> tensor<1x2x7x32xf32> {
  %result = host.dispatch(%input, %weight) {callee = @conv} : (tensor<1x2x7x8xf32>, tensor<8x3x3x32xf32>) -> tensor<1x2x7x32xf32>
  func.return(%result) : (tensor<1x2x7x32xf32>) -> ()
}

// -----

// The warps take the 2 tiles of 16 channels by 4 parts of 2 rows, and each a tile of the 7 columns
// by its 2 rows: the busiest warp moves 1,936 bytes into the L2, against 2,852 for a warp that
// takes one row of all the channels, and loads 135 vectors against 144. Its 4 input rows, which
// the taps read again, are copied into its shared memory once for its part.
// CHECK: reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d2] pad 0.0 held copy<level = shared, at = 1>, $1[0, 0, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d2 by 16 : workers<level = warp>, d0 by 2 : workers<level = warp>, d3 by 1, d4 by 1, d1 by 7 : reg, d0 by 2 : reg, d2 by 16 : lanes]
tile.dispatch @depthwise(%input: tensor<1x7x7x32xf32>, %weight: tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true>} {
  %output = tile.block(%input, %weight) {iters = [par 7, par 7, par 32, red 3, red 3], reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d2] pad 0.0, $1[0, 0, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d0 by 1, d1 by 1, d2 by 16, d3 by 1, d4 by 1, d2 by 16 : lanes]} ({
  ^body(%pixel: f32, %tap: f32):
    %term = arith.mul(%pixel, %tap) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<1x7x7x32xf32>, tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32>
  func.return(%output) : (tensor<1x7x7x32xf32>) -> ()
}
func.func @main(%input: tensor<1x7x7x32xf32>, %weight: tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32> {
  %result = host.dispatch(%input, %weight) {callee = @depthwise} : (tensor<1x7x7x32xf32>, tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32>
  func.return(%result) : (tensor<1x7x7x32xf32>) -> ()
}

// -----

// The product of a weight stored `[out, in]`, the lanes along the reduction: the 8 warps take 4
// parts of 3 outputs by 2 of 4 rows, each a register tile of 4 rows by 3 outputs, walked by rows
// so that the code holds the 3 outputs' weight vectors across them.
// CHECK: reads = [$0[d0, d2 * 16 + d3], $1[d1, d2 * 16 + d3]], folds = [sum -> [d0, d1, d3]], loops = [d1 by 3 : workers<level = warp>, d0 by 4 : workers<level = warp>, d2 by 1, d0 by 4 : reg, d1 by 3 : reg, d3 by 16 : lanes]
tile.dispatch @projection(%input: tensor<8x64xf32>, %weight: tensor<12x64xf32>) -> tensor<8x12x16xf32> attributes {target = "%S/gpu-shaped.toml@0f46f219", numerics = <contract = true, skip_pad = true, reassoc = true>} {
  %sums = tile.block(%input, %weight) {iters = [par 8, par 12, red 4, par 16], reads = [$0[d0, d2 * 16 + d3], $1[d1, d2 * 16 + d3]], folds = [sum -> [d0, d1, d3]], loops = [d0 by 1, d1 by 1, d2 by 1, d3 by 16 : lanes]} ({
  ^body(%activation: f32, %coefficient: f32):
    %term = arith.mul(%activation, %coefficient) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<8x64xf32>, tensor<12x64xf32>) -> tensor<8x12x16xf32>
  func.return(%sums) : (tensor<8x12x16xf32>) -> ()
}
func.func @main(%input: tensor<8x64xf32>, %weight: tensor<12x64xf32>) -> tensor<8x12x16xf32> {
  %sums = host.dispatch(%input, %weight) {callee = @projection} : (tensor<8x64xf32>, tensor<12x64xf32>) -> tensor<8x12x16xf32>
  func.return(%sums) : (tensor<8x12x16xf32>) -> ()
}
