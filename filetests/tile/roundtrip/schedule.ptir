// RUN: roundtrip

// A dispatch with a schedule: tiles of rows on two units at level l3, tiles of columns on cores,
// and tiles of the contracted axis in order.
// CHECK: tile.dispatch @project([[INPUT:%[0-9]+]]: tensor<4x8xf32>, [[WEIGHT:%[0-9]+]]: tensor<6x8xf32>) -> tensor<4x6xf32> attributes {schedule = #sched<nest = [d0 by 2 : par<level = l3, units = 2>, d1 by 3 : par<level = core>, d2 by 4 : seq]>} {
// CHECK-NEXT: [[PRODUCT:%[0-9]+]] = tile.block([[INPUT]], [[WEIGHT]]) {iters = [par 4, par 6, red 8], reads = [$0[d0, d2], $1[d1, d2]], folds = [sum -> [d0, d1]]} ({
// CHECK-NEXT: ^body([[ELEMENT:%[0-9]+]]: f32, [[SCALE:%[0-9]+]]: f32):
// CHECK-NEXT: [[TERM:%[0-9]+]] = arith.mul([[ELEMENT]], [[SCALE]]) : (f32, f32) -> f32
// CHECK-NEXT: tile.yield([[TERM]]) : (f32) -> ()
// CHECK-NEXT: }) : (tensor<4x8xf32>, tensor<6x8xf32>) -> tensor<4x6xf32>
// CHECK-NEXT: func.return([[PRODUCT]]) : (tensor<4x6xf32>) -> ()
// CHECK-NEXT: }
tile.dispatch @project(%input: tensor<4x8xf32>, %weight: tensor<6x8xf32>) -> tensor<4x6xf32> attributes {schedule = #sched<nest = [d0 by 2 : par<level = l3, units = 2>, d1 by 3 : par<level = core>, d2 by 4 : seq]>} {
  %product = tile.block(%input, %weight) {iters = [par 4, par 6, red 8], reads = [$0[d0, d2], $1[d1, d2]], folds = [sum -> [d0, d1]]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<4x8xf32>, tensor<6x8xf32>) -> tensor<4x6xf32>
  func.return(%product) : (tensor<4x6xf32>) -> ()
}
