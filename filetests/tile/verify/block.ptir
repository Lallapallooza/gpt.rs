// ERROR: tile.block: write 0 writes f32 values into tensor<4xsi32>
func.func @update_dtype(%input: tensor<4xf32>, %counts: tensor<4xsi32>) -> tensor<4xsi32> {
  %output = tile.block(%input, %counts) {iters = [par 4], reads = [$0[d0]], folds = [none -> $1[d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>, tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%output) : (tensor<4xsi32>) -> ()
}

// -----

// ERROR: tile.block: init lists 2 operands, but sum starts from 1 states
func.func @init_count(%input: tensor<4x4xf32>, %start: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%input, %start) {iters = [par 4, red 4], reads = [$0[d0, d1]], folds = [sum -> [d0] init ($1, $1)]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: read 0 has no pad, but coordinate 0 is 4 at the point [3], outside tensor<4xf32>
func.func @read_past_the_end(%input: tensor<4xf32>) -> tensor<4xf32> {
  %shifted = tile.block(%input) {iters = [par 4], reads = [$0[d0 + 1]], folds = [none -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%shifted) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: yielded value 0, which online_softmax keeps apart from the value's iterators, depends on d1
func.func @score_of_a_value_iter(%query: tensor<4x8xf32>, %key: tensor<6x8xf32>, %value: tensor<6x8xf32>) -> (tensor<4xf32>, tensor<4xf32>, tensor<4x8xf32>) {
  %max, %sum, %accumulated = tile.block(%query, %key, %value) {iters = [par 4, par 8, red 6], reads = [$0[d0, d1], $1[d2, d1], $2[d2, d1]], folds = [online_softmax<value_iters = [d1]> -> ([d0], [d0], [d0, d1])]} ({
  ^body(%query_element: f32, %key_element: f32, %value_element: f32):
    %product = arith.mul(%query_element, %key_element) : (f32, f32) -> f32
    tile.yield(%product, %value_element) : (f32, f32) -> ()
  }) : (tensor<4x8xf32>, tensor<6x8xf32>, tensor<6x8xf32>) -> (tensor<4xf32>, tensor<4xf32>, tensor<4x8xf32>)
  func.return(%max, %sum, %accumulated) : (tensor<4xf32>, tensor<4xf32>, tensor<4x8xf32>) -> ()
}
