// RUN: pass name-target {target = "%S/foundation.toml"}

// The larger of two vectors of 16 lanes, on a part with AVX-512 Foundation and no doubleword and
// quadword instructions: x86 computes a float maximum with `vrangeps`, which it lacks, so the
// dispatch's verifier rejects the vectors the block pins once `name-target` names the target.
// ERROR: after name-target {target = "%S/foundation.toml"}: tile.dispatch: block 0: isa.maximum on 16 lanes of f32 takes avx512dq, which %S/foundation.toml lacks
tile.dispatch @larger(%lhs: tensor<32xf32>, %rhs: tensor<32xf32>) -> tensor<32xf32> {
  %larger = tile.block(%lhs, %rhs) {iters = [par 32], reads = [$0[d0], $1[d0]], folds = [none -> [d0]], loops = [d0 by 32 : reg, d0 by 16 : lanes]} ({
  ^body(%left: f32, %right: f32):
    %maximum = arith.maximum(%left, %right) : (f32, f32) -> f32
    tile.yield(%maximum) : (f32) -> ()
  }) : (tensor<32xf32>, tensor<32xf32>) -> tensor<32xf32>
  func.return(%larger) : (tensor<32xf32>) -> ()
}
func.func @main(%lhs: tensor<32xf32>, %rhs: tensor<32xf32>) -> tensor<32xf32> {
  %larger = host.dispatch(%lhs, %rhs) {callee = @larger} : (tensor<32xf32>, tensor<32xf32>) -> tensor<32xf32>
  func.return(%larger) : (tensor<32xf32>) -> ()
}
