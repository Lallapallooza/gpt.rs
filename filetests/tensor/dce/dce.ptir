// RUN: pass dce

// Unused pure ops go, including chains.
// CHECK: func.func @dead([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK-NOT: tensor.exp
// CHECK: func.return([[INPUT]])
func.func @dead(%input: tensor<4xf32>) -> tensor<4xf32> {
  %exp = tensor.exp(%input) : (tensor<4xf32>) -> tensor<4xf32>
  %negated = tensor.neg(%exp) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%input) : (tensor<4xf32>) -> ()
}

// -----

// An unused opaque op stays.
// NO-INTERP: custom calls have no reference semantics
// CHECK: func.func @kept([[INPUT:%[0-9]+]]: tensor<4xf32>)
// CHECK: tensor.custom_call([[INPUT]])
func.func @kept(%input: tensor<4xf32>) -> tensor<4xf32> {
  %unused = tensor.custom_call(%input) {target = "k", results = [tensor<4xf32>]} : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%input) : (tensor<4xf32>) -> ()
}
