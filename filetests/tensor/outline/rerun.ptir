// RUN: pass outline-static,dce,outline-static

// A second run leaves the load-time functions as they are.
// CHECK: func.func @static.{{[0-9a-f]+}}(%0: tensor<4xf32> {param = 1}) -> (tensor<4xf32> {param = {{[0-9]+}}})
// CHECK-NEXT: tensor.exp(%0)
// CHECK-NEXT: func.return
func.func @f(%0: tensor<4xf32>, %1: tensor<4xf32> {param = 1}) -> tensor<4xf32> {
  %2 = tensor.exp(%1) : (tensor<4xf32>) -> tensor<4xf32>
  %3 = tensor.add(%0, %2) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xf32>
  func.return(%3) : (tensor<4xf32>) -> ()
}
