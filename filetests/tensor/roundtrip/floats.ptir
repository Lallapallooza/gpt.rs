// RUN: roundtrip

// An f32 element is parsed straight to f32: through f64, 7.038531e-26 would round to the next f32.
// CHECK: func.func @f32_decimal() -> tensor<f32> {
// CHECK-NEXT: [[TINY:%[0-9]+]] = tensor.constant() {value = dense<f32: 7.038531e-26>} : () -> tensor<f32>
// CHECK-NEXT: func.return([[TINY]]) : (tensor<f32>) -> ()
// CHECK-NEXT: }
func.func @f32_decimal() -> tensor<f32> {
  %tiny = tensor.constant() {value = dense<f32: 7.038531e-26>} : () -> tensor<f32>
  func.return(%tiny) : (tensor<f32>) -> ()
}

// -----

// Elements narrower than a byte, packed from the least significant bits of each byte.
// CHECK: func.func @packed_constants() -> (tensor<4xf4e2m1>, tensor<3xui4>, tensor<4xf6e3m2>) {
// CHECK-NEXT: [[FP4_VALUES:%[0-9]+]] = tensor.constant() {value = dense<4xf4e2m1: "0x2143">} : () -> tensor<4xf4e2m1>
// CHECK-NEXT: [[UI4_VALUES:%[0-9]+]] = tensor.constant() {value = dense<3xui4: "0x210f">} : () -> tensor<3xui4>
// CHECK-NEXT: [[FP6_VALUES:%[0-9]+]] = tensor.constant() {value = dense<4xf6e3m2: "0x0c3000">} : () -> tensor<4xf6e3m2>
// CHECK-NEXT: func.return([[FP4_VALUES]], [[UI4_VALUES]], [[FP6_VALUES]]) : (tensor<4xf4e2m1>, tensor<3xui4>, tensor<4xf6e3m2>) -> ()
// CHECK-NEXT: }
func.func @packed_constants() -> (tensor<4xf4e2m1>, tensor<3xui4>, tensor<4xf6e3m2>) {
  %fp4_values = tensor.constant() {value = dense<4xf4e2m1: "0x2143">} : () -> tensor<4xf4e2m1>
  %ui4_values = tensor.constant() {value = dense<3xui4: "0x210f">} : () -> tensor<3xui4>
  %fp6_values = tensor.constant() {value = dense<4xf6e3m2: "0x0c3000">} : () -> tensor<4xf6e3m2>
  func.return(%fp4_values, %ui4_values, %fp6_values) : (tensor<4xf4e2m1>, tensor<3xui4>, tensor<4xf6e3m2>) -> ()
}
