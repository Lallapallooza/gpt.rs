// RUN: verify

// ERROR: tensor.iota: axis 2 is out of range for rank 2
func.func @iota_axis() -> tensor<2x3xsi32> {
  %0 = tensor.iota() {shape = [2, 3], dtype = si32, axis = 2} : () -> tensor<2x3xsi32>
  func.return(%0) : (tensor<2x3xsi32>) -> ()
}

// -----
