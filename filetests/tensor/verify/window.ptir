  func.return(%max) : (tensor<3x4xf32>) -> ()
}

// -----
// ERROR: tensor.reduce_window_max: padding [(0, 0), (0, 0), (0, 0)] has rank 3, but the input has rank 2
func.func @window_padding_rank(%input: tensor<4x4xf32>) -> tensor<3x4xf32> {
