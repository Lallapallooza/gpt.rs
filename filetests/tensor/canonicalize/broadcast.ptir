// RUN: pass canonicalize

// An elementwise op on broadcasts of one shape runs on that shape, and its result broadcasts.
// CHECK: func.func @hoist
// CHECK-NEXT: [[S:%[0-9]+]] = tensor.add(%0, %1) : (tensor<3xf32>, tensor<3xf32>) -> tensor<3xf32>
// CHECK-NEXT: [[E:%[0-9]+]] = tensor.exp([[S]]) : (tensor<3xf32>) -> tensor<3xf32>
// CHECK-NEXT: [[B:%[0-9]+]] = tensor.broadcast_to([[E]]) {shape = [4, 3]}
// CHECK-NEXT: func.return([[B]])
func.func @hoist(%0: tensor<3xf32>, %1: tensor<3xf32>) -> tensor<4x3xf32> {
  %2 = tensor.broadcast_to(%0) {shape = [4, 3]} : (tensor<3xf32>) -> tensor<4x3xf32>
  %3 = tensor.broadcast_to(%1) {shape = [4, 3]} : (tensor<3xf32>) -> tensor<4x3xf32>
  %4 = tensor.add(%2, %3) : (tensor<4x3xf32>, tensor<4x3xf32>) -> tensor<4x3xf32>
  %5 = tensor.exp(%4) : (tensor<4x3xf32>) -> tensor<4x3xf32>
  func.return(%5) : (tensor<4x3xf32>) -> ()
}

// -----

// A splat constant operand is rebuilt in the smaller shape, and a compare broadcasts its i1 result.
// CHECK: func.func @splat_operand
// CHECK: [[C:%[0-9]+]] = tensor.constant() {value = dense<[3] x f32: 2.0>}
// CHECK: [[P:%[0-9]+]] = tensor.compare(%0, [[C]]) {kind = less} : (tensor<3xf32>, tensor<3xf32>) -> tensor<3xi1>
// CHECK-NEXT: tensor.broadcast_to([[P]]) {shape = [4, 3]} : (tensor<3xi1>) -> tensor<4x3xi1>
func.func @splat_operand(%0: tensor<3xf32>) -> tensor<4x3xi1> {
  %1 = tensor.broadcast_to(%0) {shape = [4, 3]} : (tensor<3xf32>) -> tensor<4x3xf32>
  %2 = tensor.constant() {value = dense<[4, 3] x f32: 2.0>} : () -> tensor<4x3xf32>
  %3 = tensor.compare(%1, %2) {kind = less} : (tensor<4x3xf32>, tensor<4x3xf32>) -> tensor<4x3xi1>
  func.return(%3) : (tensor<4x3xi1>) -> ()
}

// -----

// Broadcasts from different shapes, or a non-splat operand, keep the op at the wide shape.
// CHECK: func.func @stays
// CHECK: tensor.add({{%[0-9]+}}, {{%[0-9]+}}) : (tensor<4x3xf32>, tensor<4x3xf32>)
// CHECK: tensor.mul({{%[0-9]+}}, %2) : (tensor<4x3xf32>, tensor<4x3xf32>)
func.func @stays(%0: tensor<3xf32>, %1: tensor<4x1xf32>, %2: tensor<4x3xf32>) -> (tensor<4x3xf32>, tensor<4x3xf32>) {
  %3 = tensor.broadcast_to(%0) {shape = [4, 3]} : (tensor<3xf32>) -> tensor<4x3xf32>
  %4 = tensor.broadcast_to(%1) {shape = [4, 3]} : (tensor<4x1xf32>) -> tensor<4x3xf32>
  %5 = tensor.add(%3, %4) : (tensor<4x3xf32>, tensor<4x3xf32>) -> tensor<4x3xf32>
  %6 = tensor.mul(%3, %2) : (tensor<4x3xf32>, tensor<4x3xf32>) -> tensor<4x3xf32>
  func.return(%5, %6) : (tensor<4x3xf32>, tensor<4x3xf32>) -> ()
}

// -----

// A non-splat constant operand keeps the op at the wide shape.
// CHECK: func.func @non_splat
// CHECK: tensor.mul({{%[0-9]+}}, {{%[0-9]+}}) : (tensor<2x2xf32>, tensor<2x2xf32>)
func.func @non_splat(%0: tensor<2xf32>) -> tensor<2x2xf32> {
  %1 = tensor.broadcast_to(%0) {shape = [2, 2]} : (tensor<2xf32>) -> tensor<2x2xf32>
  %2 = tensor.constant() {value = dense<[2, 2] x f32: [1.0, 2.0, 3.0, 4.0]>} : () -> tensor<2x2xf32>
  %3 = tensor.mul(%1, %2) : (tensor<2x2xf32>, tensor<2x2xf32>) -> tensor<2x2xf32>
  func.return(%3) : (tensor<2x2xf32>) -> ()
}
