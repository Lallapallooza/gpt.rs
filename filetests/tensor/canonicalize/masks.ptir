// RUN: pass canonicalize

// An iota along an axis of extent 1 is 0.
// CHECK: func.func @iota_unit_axis
// CHECK-NOT: tensor.iota
// CHECK: tensor.constant() {value = dense<[] x si32: 0>}
// CHECK: tensor.broadcast_to({{%[0-9]+}}) {shape = [1, 16]}
func.func @iota_unit_axis() -> tensor<1x16xsi32> {
  %0 = tensor.iota() {shape = [1, 16], dtype = si32, axis = 0} : () -> tensor<1x16xsi32>
  func.return(%0) : (tensor<1x16xsi32>) -> ()
}

// -----

// An integer compared with itself is equal to it, so `greater_equal` holds and `less` does not.
// A float is left alone: NaN is not equal to itself.
// CHECK: func.func @compare_with_itself
// CHECK: tensor.constant() {value = dense<[] x i1: true>}
// CHECK: tensor.constant() {value = dense<[] x i1: false>}
// CHECK: tensor.equal(%1, %1)
func.func @compare_with_itself(%0: tensor<4xsi32>, %1: tensor<4xf32>) -> (tensor<4xi1>, tensor<4xi1>, tensor<4xi1>) {
  %2 = tensor.greater_equal(%0, %0) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xi1>
  %3 = tensor.less(%0, %0) : (tensor<4xsi32>, tensor<4xsi32>) -> tensor<4xi1>
  %4 = tensor.equal(%1, %1) : (tensor<4xf32>, tensor<4xf32>) -> tensor<4xi1>
  func.return(%2, %3, %4) : (tensor<4xi1>, tensor<4xi1>, tensor<4xi1>) -> ()
}

// -----

// The causal mask of one position, as a chunk of one token builds it, is one constant.
// CHECK: func.func @mask_of_one_position
// CHECK-NOT: tensor.iota
// CHECK-NOT: tensor.greater_equal
// CHECK-NOT: tensor.select
func.func @mask_of_one_position() -> tensor<1x1xf32> {
  %0 = tensor.iota() {shape = [1, 1], dtype = si32, axis = 0} : () -> tensor<1x1xsi32>
  %1 = tensor.iota() {shape = [1, 1], dtype = si32, axis = 1} : () -> tensor<1x1xsi32>
  %2 = tensor.greater_equal(%0, %1) : (tensor<1x1xsi32>, tensor<1x1xsi32>) -> tensor<1x1xi1>
  %3 = tensor.constant() {value = dense<[1, 1] x f32: 1.0>} : () -> tensor<1x1xf32>
  %4 = tensor.constant() {value = dense<[1, 1] x f32: 0.0>} : () -> tensor<1x1xf32>
  %5 = tensor.select(%2, %3, %4) : (tensor<1x1xi1>, tensor<1x1xf32>, tensor<1x1xf32>) -> tensor<1x1xf32>
  func.return(%5) : (tensor<1x1xf32>) -> ()
}
