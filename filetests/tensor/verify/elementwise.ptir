// -----
// ERROR: tensor.add: each operand must be an integer or float tensor, got tensor<4xf8e4m3>
func.func @add_narrow(%input: tensor<4xf8e4m3>) -> tensor<4xf8e4m3> {
  %sum = tensor.add(%input, %input) : (tensor<4xf8e4m3>, tensor<4xf8e4m3>) -> tensor<4xf8e4m3>
  func.return(%sum) : (tensor<4xf8e4m3>) -> ()
}

// -----
// ERROR: tensor.less: each operand must be an i1, integer or float tensor, got tensor<4xe8m0>
func.func @compare_scales(%scales: tensor<4xe8m0>) -> tensor<4xi1> {
  %is_less = tensor.less(%scales, %scales) : (tensor<4xe8m0>, tensor<4xe8m0>) -> tensor<4xi1>
  func.return(%is_less) : (tensor<4xi1>) -> ()
