      %3 = DotGeneral(DotGeneralSpec { batch_lhs: [], batch_rhs: [], contract_lhs: [3, 4, 5], contract_rhs: [2, 3, 1], accum_dtype: None, out_dtype: None })(%0, %1) -> tensor<F32 x 1x2x2x4>
      %4 = BroadcastTo(BroadcastToSpec { result_shape: Shape { dims: [Static(1), Static(2), Static(2), Static(4)] } })(%2) -> tensor<F32 x 1x2x2x4>
      %5 = ElementwiseBinary(Mul)(%4, %3) -> tensor<F32 x 1x2x2x4>
    results:
      %5 : tensor<F32 x 1x2x2x4>
  }
}
