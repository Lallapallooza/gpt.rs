      %2 : tensor<F32 x 4>
    body:
      %6 = Reshape(ReshapeSpec { new_shape: [Explicit(Static(4)), Explicit(Static(1)), Explicit(Static(1)), Explicit(Static(1))] })(%2) -> tensor<F32 x 4x1x1x1>
      %7 = BroadcastTo(BroadcastToSpec { result_shape: Shape { dims: [Static(4), Static(3), Static(1), Static(1)] } })(%6) -> tensor<F32 x 4x3x1x1>
      %8 = ElementwiseBinary(Mul)(%1, %7) -> tensor<F32 x 4x3x1x1>
      %9 = DotGeneral(DotGeneralSpec { batch_lhs: [], batch_rhs: [], contract_lhs: [3, 4, 5], contract_rhs: [2, 3, 1], accum_dtype: None, out_dtype: None })(%0, %8) -> tensor<F32 x 1x2x2x4>
    results:
      %9 : tensor<F32 x 1x2x2x4>
  }
}
