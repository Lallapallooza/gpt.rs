// RUN: verify

// ERROR: tensor.extract_patches: tensor<{N}x4x4x3xf32> has a dynamic dimension
func.func @patches_dynamic(%input: tensor<{N}x4x4x3xf32>) -> tensor<{N}x2x2x27xf32> {
  %patches = tensor.extract_patches(%input) {window = [3, 3], strides = [1, 1], dilation = [1, 1], padding = [(0, 0), (0, 0)], pad_value = 0.0} : (tensor<{N}x4x4x3xf32>) -> tensor<{N}x2x2x27xf32>
  func.return(%patches) : (tensor<{N}x2x2x27xf32>) -> ()
}

// -----
// ERROR: tensor.extract_patches: input must be [N, spatial..., C], got tensor<4x4xf32>
func.func @patches_rank(%input: tensor<4x4xf32>) -> tensor<4x2x2xf32> {
  %patches = tensor.extract_patches(%input) {window = [3], strides = [1], dilation = [1], padding = [(0, 0)], pad_value = 0.0} : (tensor<4x4xf32>) -> tensor<4x2x2xf32>
  func.return(%patches) : (tensor<4x2x2xf32>) -> ()
}

// -----
