// RUN: pass canonicalize {fuel = 1}

// With fuel for one step, the first fold runs, `neg(neg(x))` to `x`, and nothing else: the dead
// `neg` and `abs(abs(x))` stay.
// CHECK: func.func @fuel([[INPUT:%[0-9]+]]: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
// CHECK-NEXT: {{%[0-9]+}} = tensor.neg([[INPUT]])
// CHECK-NEXT: [[MAGNITUDE:%[0-9]+]] = tensor.abs([[INPUT]])
// CHECK-NEXT: [[DOUBLE_MAGNITUDE:%[0-9]+]] = tensor.abs([[MAGNITUDE]])
// CHECK-NEXT: func.return([[INPUT]], [[DOUBLE_MAGNITUDE]])
func.func @fuel(%input: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
  %negated = tensor.neg(%input) : (tensor<4xf32>) -> tensor<4xf32>
  %double_negated = tensor.neg(%negated) : (tensor<4xf32>) -> tensor<4xf32>
  %magnitude = tensor.abs(%input) : (tensor<4xf32>) -> tensor<4xf32>
  %double_magnitude = tensor.abs(%magnitude) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%double_negated, %double_magnitude) : (tensor<4xf32>, tensor<4xf32>) -> ()
}
