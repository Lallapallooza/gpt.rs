// RUN: parse

// ERROR: 5:38: the expression of tile.index reads no operand, not $0
func.func @index_reads_operand(%input: tensor<4xsi32>) -> tensor<4xsi32> {
  %positions = tile.block(%input) {iters = [par 4], reads = [$0[d0]], folds = [none -> [d0]]} ({
  ^body(%element: si32):
    %position = tile.index() {expr = $0[d0], dtype = si32} : () -> si32
    tile.yield(%position) : (si32) -> ()
  }) : (tensor<4xsi32>) -> tensor<4xsi32>
  func.return(%positions) : (tensor<4xsi32>) -> ()
}

// -----

// ERROR: 3:62: `i` is no iterator: an iterator is `d` and its position, such as d0
func.func @named_iterator(%input: tensor<4xf32>) -> tensor<4xf32> {
  %output = tile.block(%input) {iters = [par 4], reads = [$0[i]], folds = [none -> [i]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}
