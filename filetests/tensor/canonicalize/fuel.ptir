// RUN: pass canonicalize {fuel = 1}

// With fuel for one step, the first fold runs, `neg(neg(x))` to `x`, and nothing else: the dead
// `neg` and `abs(abs(x))` stay.
// CHECK: func.func @fuel
// CHECK-NEXT: {{%[0-9]+}} = tensor.neg(%0)
// CHECK-NEXT: [[A:%[0-9]+]] = tensor.abs(%0)
// CHECK-NEXT: [[B:%[0-9]+]] = tensor.abs([[A]])
// CHECK-NEXT: func.return(%0, [[B]])
func.func @fuel(%0: tensor<4xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
  %1 = tensor.neg(%0) : (tensor<4xf32>) -> tensor<4xf32>
  %2 = tensor.neg(%1) : (tensor<4xf32>) -> tensor<4xf32>
  %3 = tensor.abs(%0) : (tensor<4xf32>) -> tensor<4xf32>
  %4 = tensor.abs(%3) : (tensor<4xf32>) -> tensor<4xf32>
  func.return(%2, %4) : (tensor<4xf32>, tensor<4xf32>) -> ()
}
