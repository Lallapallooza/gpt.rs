// RUN: pass canonicalize

// Integer arith on index values and constants is one index expression, in canonical form.
// CHECK: [[POSITION:%[0-9]+]] = tile.index() {expr = d0 * 2 + 1, dtype = si64}
// CHECK-NEXT: tile.yield([[POSITION]])
func.func @si64(%input: tensor<4xf32>) -> tensor<4xsi64> {
  %positions = tile.block() {iters = [par 4], reads = [], folds = [none -> [d0]]} ({
    %index = tile.index() {expr = d0, dtype = si64} : () -> si64
    %two = arith.constant() {value = 2 : si64} : () -> si64
    %doubled = arith.mul(%index, %two) : (si64, si64) -> si64
    %one = arith.constant() {value = 1 : si64} : () -> si64
    %position = arith.add(%doubled, %one) : (si64, si64) -> si64
    tile.yield(%position) : (si64) -> ()
  }) : () -> tensor<4xsi64>
  func.return(%positions) : (tensor<4xsi64>) -> ()
}

// -----

// The extents bound the values to the range of si32, so they fold. The negation of a minimum
// folds too.
// CHECK: [[NEGATED:%[0-9]+]] = tile.index() {expr = -min(d0, d1 - 1), dtype = si32}
// CHECK-NEXT: tile.yield([[NEGATED]])
func.func @si32_bounded(%input: tensor<4x3xf32>) -> tensor<4x3xsi32> {
  %values = tile.block() {iters = [par 4, par 3], reads = [], folds = [none -> [d0, d1]]} ({
    %row = tile.index() {expr = d0, dtype = si32} : () -> si32
    %column = tile.index() {expr = d1, dtype = si32} : () -> si32
    %one = arith.constant() {value = 1 : si32} : () -> si32
    %previous = arith.sub(%column, %one) : (si32, si32) -> si32
    %smaller = arith.minimum(%row, %previous) : (si32, si32) -> si32
    %negated = arith.neg(%smaller) : (si32) -> si32
    tile.yield(%negated) : (si32) -> ()
  }) : () -> tensor<4x3xsi32>
  func.return(%values) : (tensor<4x3xsi32>) -> ()
}

// -----

// A dynamic extent leaves the values unbounded, and a negative value is out of the range of ui64:
// neither folds.
// CHECK: arith.mul
// CHECK: arith.sub
func.func @unbounded(%input: tensor<{T}xf32>) -> (tensor<{T}xsi32>, tensor<4xui64>) {
  %squares = tile.block() {iters = [par {T}], reads = [], folds = [none -> [d0]]} ({
    %index = tile.index() {expr = d0, dtype = si32} : () -> si32
    %square = arith.mul(%index, %index) : (si32, si32) -> si32
    tile.yield(%square) : (si32) -> ()
  }) : () -> tensor<{T}xsi32>
  %differences = tile.block() {iters = [par 4], reads = [], folds = [none -> [d0]]} ({
    %index = tile.index() {expr = d0, dtype = ui64} : () -> ui64
    %three = arith.constant() {value = 3 : ui64} : () -> ui64
    %difference = arith.sub(%index, %three) : (ui64, ui64) -> ui64
    tile.yield(%difference) : (ui64) -> ()
  }) : () -> tensor<4xui64>
  func.return(%squares, %differences) : (tensor<{T}xsi32>, tensor<4xui64>) -> ()
}
