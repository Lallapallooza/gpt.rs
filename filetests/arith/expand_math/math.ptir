// RUN: pass expand-math {numerics = <expand_math = true>}

// ROUNDING: poly: the polynomial is within 1 ulp of the interpreter's exp
// exp of each element: the input clamped, rounded to a multiple of ln 2 by adding and subtracting
// 2^23, the remainder's polynomial, and 2^n built in the exponent bits of two halves; a NaN passes
// through.
// CHECK: ^body([[POSITION:%[0-9]+]]: index):
// CHECK-NEXT: [[ELEMENT:%[0-9]+]] = loop.load({{%[0-9]+}}, [[POSITION]])
// CHECK-NEXT: [[NAN:%[0-9]+]] = arith.not_equal([[ELEMENT]], [[ELEMENT]]) : (f32, f32) -> i1
// CHECK: arith.constant() {value = -104.0 : f32}
// CHECK: arith.constant() {value = 89.0 : f32}
// CHECK: [[FIRST_WHOLE:%[0-9]+]] = arith.constant() {value = 8388608.0 : f32}
// CHECK-NEXT: [[SHIFTED:%[0-9]+]] = arith.add({{%[0-9]+}}, [[FIRST_WHOLE]]) : (f32, f32) -> f32
// CHECK-NEXT: arith.sub([[SHIFTED]], [[FIRST_WHOLE]]) : (f32, f32) -> f32
// CHECK: [[EXPONENT:%[0-9]+]] = arith.cast({{%[0-9]+}}) {to = si32} : (f32) -> si32
// CHECK: [[HALF:%[0-9]+]] = arith.shift_right_arithmetic([[EXPONENT]], {{%[0-9]+}}) : (si32, si32) -> si32
// CHECK: [[BIAS:%[0-9]+]] = arith.constant() {value = 127 : si32}
// CHECK-NEXT: [[BIASED:%[0-9]+]] = arith.add([[HALF]], [[BIAS]]) : (si32, si32) -> si32
// CHECK: [[HALF_BITS:%[0-9]+]] = arith.shift_left([[BIASED]], {{%[0-9]+}}) : (si32, si32) -> si32
// CHECK-NEXT: [[HALF_SCALE:%[0-9]+]] = arith.bitcast([[HALF_BITS]]) {to = f32} : (si32) -> f32
// CHECK: arith.mul({{%[0-9]+}}, [[HALF_SCALE]]) : (f32, f32) -> f32
// CHECK: [[POWER:%[0-9]+]] = arith.select([[NAN]], [[ELEMENT]], {{%[0-9]+}}) : (i1, f32, f32) -> f32
// CHECK-NEXT: loop.store([[POWER]], {{%[0-9]+}}, [[POSITION]])
// CHECK-NOT: arith.exp
loop.func @exp_each(%input: !loop.buf<64xf32, global>, %output: !loop.buf<64xf32, global>) attributes {access = [in, out]} {
  %zero = loop.index() {expr = 0} : () -> index
  %count = loop.index() {expr = 64} : () -> index
  loop.for(%zero, %count) ({
  ^body(%position: index):
    %element = loop.load(%input, %position) : (!loop.buf<64xf32, global>, index) -> f32
    %power = arith.exp(%element) : (f32) -> f32
    loop.store(%power, %output, %position) : (f32, !loop.buf<64xf32, global>, index) -> ()
    loop.yield() : () -> ()
  }) : (index, index) -> ()
  loop.return() : () -> ()
}
func.func @main(%input: tensor<64xf32>) -> tensor<64xf32> {
  %output = host.dispatch(%input) {callee = @exp_each} : (tensor<64xf32>) -> tensor<64xf32>
  func.return(%output) : (tensor<64xf32>) -> ()
}

// -----

// ROUNDING: poly: the polynomial is within 1 ulp of the interpreter's tanh
// tanh of each element: an odd polynomial below 0.625 in magnitude, and above it
// 1 - 2 / (e^(2|x|) + 1) with the sign of x, the exponential written as exp's polynomial. A zero
// is its own tanh, -0 included.
// CHECK: ^body([[POSITION:%[0-9]+]]: index):
// CHECK-NEXT: [[ELEMENT:%[0-9]+]] = loop.load({{%[0-9]+}}, [[POSITION]])
// CHECK-NEXT: [[MAGNITUDE:%[0-9]+]] = arith.abs([[ELEMENT]]) : (f32) -> f32
// CHECK-NEXT: arith.mul([[ELEMENT]], [[ELEMENT]]) : (f32, f32) -> f32
// CHECK: [[SMALL:%[0-9]+]] = arith.add({{%[0-9]+}}, [[ELEMENT]]) : (f32, f32) -> f32
// CHECK-NEXT: arith.add([[MAGNITUDE]], [[MAGNITUDE]]) : (f32, f32) -> f32
// CHECK: arith.div({{%[0-9]+}}, {{%[0-9]+}}) : (f32, f32) -> f32
// CHECK: [[LARGE:%[0-9]+]] = arith.select({{%[0-9]+}}, {{%[0-9]+}}, {{%[0-9]+}}) : (i1, f32, f32) -> f32
// CHECK-NEXT: [[THRESHOLD:%[0-9]+]] = arith.constant() {value = 0.625 : f32}
// CHECK-NEXT: [[FAR:%[0-9]+]] = arith.greater_equal([[MAGNITUDE]], [[THRESHOLD]]) : (f32, f32) -> i1
// CHECK-NEXT: [[RESULT:%[0-9]+]] = arith.select([[FAR]], [[LARGE]], [[SMALL]]) : (i1, f32, f32) -> f32
// CHECK-NEXT: [[AT_ZERO:%[0-9]+]] = arith.equal([[ELEMENT]], {{%[0-9]+}}) : (f32, f32) -> i1
// CHECK-NEXT: [[SQUASHED:%[0-9]+]] = arith.select([[AT_ZERO]], [[ELEMENT]], [[RESULT]]) : (i1, f32, f32) -> f32
// CHECK-NEXT: loop.store([[SQUASHED]], {{%[0-9]+}}, [[POSITION]])
// CHECK-NOT: arith.tanh
// CHECK-NOT: arith.exp
loop.func @tanh_each(%input: !loop.buf<64xf32, global>, %output: !loop.buf<64xf32, global>) attributes {access = [in, out]} {
  %zero = loop.index() {expr = 0} : () -> index
  %count = loop.index() {expr = 64} : () -> index
  loop.for(%zero, %count) ({
  ^body(%position: index):
    %element = loop.load(%input, %position) : (!loop.buf<64xf32, global>, index) -> f32
    %squashed = arith.tanh(%element) : (f32) -> f32
    loop.store(%squashed, %output, %position) : (f32, !loop.buf<64xf32, global>, index) -> ()
    loop.yield() : () -> ()
  }) : (index, index) -> ()
  loop.return() : () -> ()
}
func.func @main(%input: tensor<64xf32>) -> tensor<64xf32> {
  %output = host.dispatch(%input) {callee = @tanh_each} : (tensor<64xf32>) -> tensor<64xf32>
  func.return(%output) : (tensor<64xf32>) -> ()
}

// -----

// The polynomials are for f32: exp of an f64 stays.
// CHECK: arith.exp({{%[0-9]+}}) : (f64) -> f64
loop.func @exp_f64(%input: !loop.buf<64xf64, global>, %output: !loop.buf<64xf64, global>) attributes {access = [in, out]} {
  %zero = loop.index() {expr = 0} : () -> index
  %count = loop.index() {expr = 64} : () -> index
