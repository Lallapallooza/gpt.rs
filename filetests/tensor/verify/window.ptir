  %patches = tensor.extract_patches(%input) {window = [3], strides = [1, 1], dilation = [1, 1], padding = [(0, 0), (0, 0)], pad_value = 0.0} : (tensor<1x4x4x3xf32>) -> tensor<1x2x2x27xf32>
  func.return(%patches) : (tensor<1x2x2x27xf32>) -> ()
}

