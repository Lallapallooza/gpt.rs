// RUN: pass schedule {target = "%S/small-caches.toml"}

// L1 holds 1.5 KiB, which a piece of 32 lanes of the weight over every reduced point, 2 KiB, does
// not fit: it moves into L1 once for each tile of rows, 3 of them for 11 rows by 2 vectors, which
// the counts take the fewest bytes for (each tile of a loop counted whole), and the fewest
// registers among those that tie.
// CHECK: reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]], loops = [d1 by 32, d0 by 11, d2 by 1, d0 by 11 : reg, d1 by 32 : reg, d1 by 16 : lanes]
tile.dispatch @projection(%input: tensor<32x16xf32>, %weight: tensor<16x128xf32>) -> tensor<32x128xf32> attributes {numerics = <contract = true, skip_pad = true>} {
  %product = tile.block(%input, %weight) {iters = [par 32, par 128, red 16], reads = [$0[d0, d2], $1[d2, d1]], folds = [sum -> [d0, d1]], loops = [d0 by 1, d1 by 16, d2 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32, %scale: f32):
    %term = arith.mul(%element, %scale) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<32x16xf32>, tensor<16x128xf32>) -> tensor<32x128xf32>
  func.return(%product) : (tensor<32x128xf32>) -> ()
}
func.func @main(%input: tensor<32x16xf32>, %weight: tensor<16x128xf32>) -> tensor<32x128xf32> {
  %result = host.dispatch(%input, %weight) {callee = @projection} : (tensor<32x16xf32>, tensor<16x128xf32>) -> tensor<32x128xf32>
  func.return(%result) : (tensor<32x128xf32>) -> ()
}

// -----

// The target states no bandwidth, so no cache can be shown to keep up, and the bytes decide: a
// tile of the 7 columns by both vectors, whose window rows L1's sets hold (the padded points past
// the edges read no memory), and in L2 the largest piece of rows whose lines its sets hold, 2 rows
// of the output, which read their 4 input rows once.
// CHECK: reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d2] pad 0.0, $1[0, 0, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d0 by 2 in l2, d0 by 1, d3 by 1, d4 by 1, d1 by 7 : reg, d2 by 32 : reg, d2 by 16 : lanes], clip = [d0, d1, d3, d4]
tile.dispatch @depthwise(%input: tensor<1x7x7x32xf32>, %weight: tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32> attributes {numerics = <contract = true, skip_pad = true>} {
  %output = tile.block(%input, %weight) {iters = [par 7, par 7, par 32, red 3, red 3], reads = [$0[0, d0 + d3 - 1, d1 + d4 - 1, d2] pad 0.0, $1[0, 0, d3, d4, d2]], folds = [sum -> [0, d0, d1, d2]], loops = [d0 by 1, d1 by 1, d2 by 16, d3 by 1, d4 by 1, d2 by 16 : lanes]} ({
  ^body(%pixel: f32, %tap: f32):
    %term = arith.mul(%pixel, %tap) : (f32, f32) -> f32
    tile.yield(%term) : (f32) -> ()
  }) : (tensor<1x7x7x32xf32>, tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32>
  func.return(%output) : (tensor<1x7x7x32xf32>) -> ()
}
func.func @main(%input: tensor<1x7x7x32xf32>, %weight: tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32> {
  %result = host.dispatch(%input, %weight) {callee = @depthwise} : (tensor<1x7x7x32xf32>, tensor<1x1x3x3x32xf32>) -> tensor<1x7x7x32xf32>
  func.return(%result) : (tensor<1x7x7x32xf32>) -> ()
}
