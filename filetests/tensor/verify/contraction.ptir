// RUN: verify

// ERROR: tensor.dot_general: operands of different dtypes, tensor<2x3xf32> and tensor<3x2xbf16>, need accum and out
func.func @dtype_mismatch(%lhs: tensor<2x3xf32>, %rhs: tensor<3x2xbf16>) -> tensor<2x2xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x2xbf16>) -> tensor<2x2xf32>
  func.return(%product) : (tensor<2x2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: lhs must be an integer, float or narrow float tensor, got tensor<2x3xi1>
func.func @i1_operands(%lhs: tensor<2x3xi1>, %rhs: tensor<3x2xi1>) -> tensor<2x2xi1> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0]} : (tensor<2x3xi1>, tensor<3x2xi1>) -> tensor<2x2xi1>
  func.return(%product) : (tensor<2x2xi1>) -> ()
}

// -----

// ERROR: tensor.dot_general: accum must be a float dtype, got i1
func.func @i1_accum(%lhs: tensor<2x3xf32>, %rhs: tensor<3x2xf32>) -> tensor<2x2xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0], accum = i1} : (tensor<2x3xf32>, tensor<3x2xf32>) -> tensor<2x2xf32>
  func.return(%product) : (tensor<2x2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: rank 10 is above the largest rank, 8
func.func @result_rank(%lhs: tensor<1x1x1x1x1xf32>, %rhs: tensor<1x1x1x1x1xf32>) -> tensor<f32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [], contract_rhs = []} : (tensor<1x1x1x1x1xf32>, tensor<1x1x1x1x1xf32>) -> tensor<f32>
  func.return(%product) : (tensor<f32>) -> ()
}

// -----

// ERROR: tensor.dot_general: batch_lhs [0] and batch_rhs [] differ in length
func.func @batch_count(%lhs: tensor<2x3x4xf32>, %rhs: tensor<4x5xf32>) -> tensor<2x3x5xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {batch_lhs = [0], contract_lhs = [2], contract_rhs = [0]} : (tensor<2x3x4xf32>, tensor<4x5xf32>) -> tensor<2x3x5xf32>
  func.return(%product) : (tensor<2x3x5xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: contract_lhs [1] and contract_rhs [0, 1] differ in length
func.func @contract_count(%lhs: tensor<2x3xf32>, %rhs: tensor<3x3xf32>) -> tensor<2xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0, 1]} : (tensor<2x3xf32>, tensor<3x3xf32>) -> tensor<2xf32>
  func.return(%product) : (tensor<2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: contract_rhs axis 2 is out of range for rank 2
func.func @axis_range(%lhs: tensor<2x3xf32>, %rhs: tensor<3x2xf32>) -> tensor<2x3xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [2]} : (tensor<2x3xf32>, tensor<3x2xf32>) -> tensor<2x3xf32>
  func.return(%product) : (tensor<2x3xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: contract_lhs axis -3 is out of range for rank 2
func.func @negative_axis_range(%lhs: tensor<2x3xf32>, %rhs: tensor<3x2xf32>) -> tensor<2x2xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [-3], contract_rhs = [0]} : (tensor<2x3xf32>, tensor<3x2xf32>) -> tensor<2x2xf32>
  func.return(%product) : (tensor<2x2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: lhs axis -1 is named twice
func.func @axis_twice_counted_back(%lhs: tensor<3x3xf32>, %rhs: tensor<3x3xf32>) -> tensor<f32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1, -1], contract_rhs = [0, 1]} : (tensor<3x3xf32>, tensor<3x3xf32>) -> tensor<f32>
  func.return(%product) : (tensor<f32>) -> ()
}

// -----

// ERROR: tensor.dot_general: lhs axis 0 is named twice
func.func @axis_twice(%lhs: tensor<3x3xf32>, %rhs: tensor<3x3x2xf32>) -> tensor<3x3x2xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [0], contract_rhs = [1]} : (tensor<3x3xf32>, tensor<3x3x2xf32>) -> tensor<3x3x2xf32>
  func.return(%product) : (tensor<3x3x2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: rhs axis 0 is named twice
func.func @axis_twice_in_group(%lhs: tensor<3x3xf32>, %rhs: tensor<3x3xf32>) -> tensor<f32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [0, 1], contract_rhs = [0, 0]} : (tensor<3x3xf32>, tensor<3x3xf32>) -> tensor<f32>
  func.return(%product) : (tensor<f32>) -> ()
}

// -----

// ERROR: tensor.dot_general: batch_lhs axis 0 has extent 2, but batch_rhs axis 0 has extent 3
func.func @batch_extent(%lhs: tensor<2x4x8xf32>, %rhs: tensor<3x8x16xf32>) -> tensor<2x4x16xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {batch_lhs = [0], batch_rhs = [0], contract_lhs = [2], contract_rhs = [1]} : (tensor<2x4x8xf32>, tensor<3x8x16xf32>) -> tensor<2x4x16xf32>
  func.return(%product) : (tensor<2x4x16xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: contract_lhs axis 1 has extent {K}, but contract_rhs axis 0 has extent 8
func.func @contract_extent(%lhs: tensor<4x{K}xf32>, %rhs: tensor<8x16xf32>) -> tensor<4x16xf32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0]} : (tensor<4x{K}xf32>, tensor<8x16xf32>) -> tensor<4x16xf32>
  func.return(%product) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tensor.reduce_sum: the input must be an integer or float tensor, got tensor<4xi1>
func.func @reduce_i1(%input: tensor<4xi1>) -> tensor<1xi1> {
  %sum = tensor.reduce_sum(%input) {axes = [0], keepdims = true} : (tensor<4xi1>) -> tensor<1xi1>
  func.return(%sum) : (tensor<1xi1>) -> ()
}

// -----

// ERROR: tensor.reduce_max: accum must be a float dtype, got i1
func.func @reduce_i1_accum(%input: tensor<4xf32>) -> tensor<1xf32> {
  %max = tensor.reduce_max(%input) {axes = [0], keepdims = true, accum = i1} : (tensor<4xf32>) -> tensor<1xf32>
  func.return(%max) : (tensor<1xf32>) -> ()
}

// -----

// ERROR: tensor.reduce_sum: axis 2 is out of range for rank 2
func.func @reduce_axis_range(%input: tensor<2x3xf32>) -> tensor<2x3x1xf32> {
  %sum = tensor.reduce_sum(%input) {axes = [2], keepdims = true} : (tensor<2x3xf32>) -> tensor<2x3x1xf32>
  func.return(%sum) : (tensor<2x3x1xf32>) -> ()
}

// -----

// ERROR: tensor.reduce_sum: axis -4 is out of range for rank 3
func.func @reduce_negative_axis_range(%input: tensor<2x3x4xf32>) -> tensor<2x3xf32> {
  %sum = tensor.reduce_sum(%input) {axes = [-4]} : (tensor<2x3x4xf32>) -> tensor<2x3xf32>
  func.return(%sum) : (tensor<2x3xf32>) -> ()
}

// -----

// ERROR: tensor.reduce_min: axis 1 is named twice
func.func @reduce_axes_twice(%input: tensor<2x3xf32>) -> tensor<2xf32> {
  %min = tensor.reduce_min(%input) {axes = [1, 1]} : (tensor<2x3xf32>) -> tensor<2xf32>
  func.return(%min) : (tensor<2xf32>) -> ()
}

// -----

// ERROR: tensor.reduce_max: axis -1 is named twice
func.func @reduce_axes_twice_counted_back(%input: tensor<2x3xf32>) -> tensor<2xf32> {
  %max = tensor.reduce_max(%input) {axes = [1, -1]} : (tensor<2x3xf32>) -> tensor<2xf32>
  func.return(%max) : (tensor<2xf32>) -> ()
}

// -----

// ERROR: tensor.dot_general: rhs must be an integer tensor, got tensor<3x2xf32>
func.func @dot_int_float(%lhs: tensor<2x3xsi8>, %rhs: tensor<3x2xf32>) -> tensor<2x2xsi32> {
  %product = tensor.dot_general(%lhs, %rhs) {contract_lhs = [1], contract_rhs = [0], accum = si32, out = si32} : (tensor<2x3xsi8>, tensor<3x2xf32>) -> tensor<2x2xsi32>
  func.return(%product) : (tensor<2x2xsi32>) -> ()
}

// -----

// ERROR: tensor.reduce_and: the input must be an i1 or integer tensor, got tensor<4xf32>
func.func @reduce_and_float(%input: tensor<4xf32>) -> tensor<f32> {
  %all = tensor.reduce_and(%input) {axes = [0]} : (tensor<4xf32>) -> tensor<f32>
  func.return(%all) : (tensor<f32>) -> ()
}
