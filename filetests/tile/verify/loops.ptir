// RUN: verify

// ERROR: tile.block: mode 0 walks d2, which the block does not have
tile.dispatch @missing_iterator(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d2 by 2]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 0 walks pieces of no points
tile.dispatch @empty_tiles(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 0, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 0 runs pieces of d1 on workers, which is not a parallel iterator: that splits a fold
tile.dispatch @split(%input: tensor<4x6xf32>) -> tensor<4xf32> {
  %sums = tile.block(%input) {iters = [par 4, red 6], reads = [$0[d0, d1]], folds = [sum -> [d0]], loops = [d1 by 3 : workers<level = core>, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4xf32>
  func.return(%sums) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 0 walks d1 in pieces of 3 points, a prefix iterator, which its loop walks one point at a time
tile.dispatch @prefix(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %sums = tile.block(%input) {iters = [par 4, prefix 6], reads = [$0[d0, d1]], folds = [sum -> [d0, d1]], loops = [d1 by 3, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%sums) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 0 walks d1 in pieces of 3 points, a reduction in order, which its loop walks one point at a time
tile.dispatch @ordered(%input: tensor<4x6xf32>) -> tensor<4xf32> {
  %sums = tile.block(%input) {iters = [par 4, red_ordered 6], reads = [$0[d0, d1]], folds = [sum -> [d0]], loops = [d1 by 3, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4xf32>
  func.return(%sums) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: fold 0 starts its state outside the loop over d1, the prefix iterator, whose point each element folds up to
tile.dispatch @prefix_held_outside(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %sums = tile.block(%input) {iters = [par 4, prefix 6], reads = [$0[d0, d1]], folds = [sum -> [d0, d1] held scratch<at = 0>], loops = [d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%sums) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile has no lanes mode
tile.dispatch @reg_without_atom(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %output = tile.block(%input) {iters = [par 4, par 16], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 16 : reg]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%output) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 1 holds d1 in the register tile, which is not a parallel iterator
tile.dispatch @reg_of_reduction(%input: tensor<4x16xf32>) -> tensor<4xf32> {
  %output = tile.block(%input) {iters = [par 4, red 16], reads = [$0[d0, d1]], folds = [sum -> [d0]], loops = [d0 by 1, d1 by 16 : reg, d1 by 8 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4xf32>
  func.return(%output) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 1 is a mode of the register tile, and walks the pieces of a memory
tile.dispatch @lanes_in_memory(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %output = tile.block(%input) {iters = [par 4, par 16], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 16 : lanes in l1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%output) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: read 0 is held at mode 3, of loops of 3 modes
tile.dispatch @staged_outside(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1] held copy<level = l1, at = 3>], folds = [none -> [d0, d1]], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: the block clips d2, which it does not have
tile.dispatch @clip_of_missing_iterator(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %first = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0 - 1, d1] pad 0.0], folds = [none -> [d0, d1]], clip = [d2]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%first) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 2 comes after the lanes, the innermost mode
tile.dispatch @after_lanes(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %output = tile.block(%input) {iters = [par 4, par 16], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 16 : lanes, d0 by 2]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%output) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 1 walks pieces of d1 inside the register tile, whose modes are the innermost
tile.dispatch @inside_registers(%input: tensor<4x32xf32>) -> tensor<4x32xf32> {
  %output = tile.block(%input) {iters = [par 4, par 32], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 2 : reg, d1 by 16, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x32xf32>) -> tensor<4x32xf32>
  func.return(%output) : (tensor<4x32xf32>) -> ()
}

// -----

// ERROR: tile.block: read 0 is held at mode 2, a mode of the register tile, which runs its points at once
tile.dispatch @held_in_registers(%input: tensor<4x32xf32>) -> tensor<4x32xf32> {
  %output = tile.block(%input) {iters = [par 4, par 32], reads = [$0[d0, d1] held copy<level = l1, at = 2>], folds = [none -> [d0, d1]], loops = [d1 by 16, d0 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x32xf32>) -> tensor<4x32xf32>
  func.return(%output) : (tensor<4x32xf32>) -> ()
}

// -----

// ERROR: tile.block: mode 1 walks pieces of 4 points of d1, inside pieces of 2
tile.dispatch @growing_tiles(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d1 by 2, d1 by 4, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: modes of a block that updates an operand where its points may collide would reorder its writes
tile.dispatch @into(%input: tensor<4x6xf32>, %update: tensor<4xf32>) -> tensor<4x6xf32> {
  %updated = tile.block(%input, %update) {iters = [par 4], reads = [$1[d0]], folds = [none -> $0[d0 floordiv 2, 0]], loops = [d0 by 2, d0 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>, tensor<4xf32>) -> tensor<4x6xf32>
  func.return(%updated) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: a block that folds with `online_softmax` or `logsumexp` takes no modes: its fold has no update of a piece
tile.dispatch @logsumexp(%input: tensor<4x6xf32>) -> (tensor<4xf32>, tensor<4xf32>) {
  %max, %sum = tile.block(%input) {iters = [par 4, red 6], reads = [$0[d0, d1]], folds = [logsumexp -> ([d0], [d0])], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> (tensor<4xf32>, tensor<4xf32>)
  func.return(%max, %sum) : (tensor<4xf32>, tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.block: the state of fold 0 keeps the piece of d0, whose extent {N} is not static
tile.dispatch @symbolic_state(%input: tensor<{N}x6xf32>) -> tensor<{N}xf32> {
  %sums = tile.block(%input) {iters = [par {N}, red 6], reads = [$0[d0, d1]], folds = [sum -> [d0] held scratch<at = 0>], loops = [d1 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<{N}x6xf32>) -> tensor<{N}xf32>
  func.return(%sums) : (tensor<{N}xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds d1 twice
tile.dispatch @reg_twice(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %output = tile.block(%input) {iters = [par 4, par 16], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 16 : reg, d1 by 16 : reg, d1 by 8 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%output) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: a register tile holds at most 3 iterators, not 4
tile.dispatch @reg_of_four(%input: tensor<2x2x2x16xf32>) -> tensor<2x2x2x16xf32> {
  %output = tile.block(%input) {iters = [par 2, par 2, par 2, par 16], reads = [$0[d0, d1, d2, d3]], folds = [none -> [d0, d1, d2, d3]], loops = [d0 by 2 : reg, d1 by 2 : reg, d2 by 2 : reg, d3 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<2x2x2x16xf32>) -> tensor<2x2x2x16xf32>
  func.return(%output) : (tensor<2x2x2x16xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds 16 points of d1, whose innermost piece has 8
tile.dispatch @reg_inside_a_tile(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %output = tile.block(%input) {iters = [par 4, par 16], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d1 by 8, d0 by 1, d1 by 16 : reg, d1 by 8 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%output) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds 12 points of d1, which vectors of 8 lanes do not fill
tile.dispatch @partial_vectors(%input: tensor<4x12xf32>) -> tensor<4x12xf32> {
  %output = tile.block(%input) {iters = [par 4, par 12], reads = [$0[d0, d1]], folds = [none -> [d0, d1]], loops = [d0 by 1, d1 by 12 : reg, d1 by 8 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x12xf32>) -> tensor<4x12xf32>
  func.return(%output) : (tensor<4x12xf32>) -> ()
}

// -----

// ERROR: tile.block: a register tile of a block with constraints would guard each point
tile.dispatch @reg_with_constraints(%input: tensor<16x16xf32>) -> tensor<16xf32> {
  %sums = tile.block(%input) {iters = [red 16, par 16], reads = [$0[d0, d1]], folds = [sum -> [d1]], constraints = [d0 <= d1], loops = [d0 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<16x16xf32>) -> tensor<16xf32>
  func.return(%sums) : (tensor<16xf32>) -> ()
}

// -----

// ERROR: tile.block: a block with a prefix iterator has no register tile
tile.dispatch @reg_with_prefix(%input: tensor<4x16xf32>) -> tensor<4x16xf32> {
  %sums = tile.block(%input) {iters = [prefix 4, par 16], reads = [$0[d0, d1]], folds = [sum -> [d0, d1]], loops = [d0 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x16xf32>) -> tensor<4x16xf32>
  func.return(%sums) : (tensor<4x16xf32>) -> ()
}

// -----

// ERROR: tile.block: a fold in a register tile keeps one element per point
tile.dispatch @reg_of_argmax(%input: tensor<6x16xf32>) -> (tensor<16xf32>, tensor<16xsi64>) {
  %largest, %position = tile.block(%input) {iters = [red 6, par 16], reads = [$0[d0, d1]], folds = [argmax -> ([d1], [d1])], loops = [d0 by 1, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    %row = tile.index() {expr = d0, dtype = si64} : () -> si64
    tile.yield(%element, %row) : (f32, si64) -> ()
  }) : (tensor<6x16xf32>) -> (tensor<16xf32>, tensor<16xsi64>)
  func.return(%largest, %position) : (tensor<16xf32>, tensor<16xsi64>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds d0, which a write leaves out: its points would write one element
tile.dispatch @reg_left_out(%cache: tensor<1x16xf32>, %row: tensor<1x16xf32>) -> tensor<1x16xf32> {
  %stored = tile.block(%cache, %row) {iters = [par 1, par 16], reads = [$1[d0, d1]], folds = [none -> $0[0, d1]], loops = [d0 by 1 : reg, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<1x16xf32>, tensor<1x16xf32>) -> tensor<1x16xf32>
  func.return(%stored) : (tensor<1x16xf32>) -> ()
}

// -----

// ERROR: tile.block: read 1 holds $0, which another read holds
tile.dispatch @read_twice(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1] held copy<level = l1, at = 0>, $0[d0, 5 - d1] held copy<level = l1, at = 0>], folds = [none -> [d0, d1]], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32, %mirrored: f32):
    %sum = arith.add(%element, %mirrored) : (f32, f32) -> f32
    tile.yield(%sum) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: $0 is held in a copy, and the block uses it other than in one read of it alone
tile.dispatch @copied_and_read(%input: tensor<4x6xf32>) -> tensor<4x6xf32> {
  %output = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1] held copy<level = l1, at = 0>, $0[d0, 5 - d1]], folds = [none -> [d0, d1]], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32, %mirrored: f32):
    %sum = arith.add(%element, %mirrored) : (f32, f32) -> f32
    tile.yield(%sum) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  func.return(%output) : (tensor<4x6xf32>) -> ()
}

// -----

// ERROR: tile.block: the copy of $0 has an axis of {N} elements, which is not static
tile.dispatch @dynamic_copy(%input: tensor<4x{N}xf32>) -> tensor<4x{N}xf32> {
  %output = tile.block(%input) {iters = [par 4, par {N}], reads = [$0[d0, d1] held copy<level = l1, at = 0>], folds = [none -> [d0, d1]], loops = [d0 by 2, d0 by 1, d1 by 1]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x{N}xf32>) -> tensor<4x{N}xf32>
  func.return(%output) : (tensor<4x{N}xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds d0, which the read of $0 takes other than by a multiple of it
tile.dispatch @grouped(%input: tensor<2x8xf32>) -> tensor<4x8xf32> {
  %output = tile.block(%input) {iters = [par 4, par 8], reads = [$0[d0 floordiv 2, d1]], folds = [none -> [d0, d1]], loops = [d0 by 4 : reg, d1 by 8 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<2x8xf32>) -> tensor<4x8xf32>
  func.return(%output) : (tensor<4x8xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds d1, which the read of $0 takes other than by a multiple of it
tile.dispatch @blocks_across_tiles(%input: tensor<3x2x32xf32>) -> tensor<2x96xf32> {
  %output = tile.block(%input) {iters = [par 2, par 96], reads = [$0[d1 floordiv 32, d0, d1 mod 32]], folds = [none -> [d0, d1]], loops = [d1 by 48, d1 by 32, d0 by 2 : reg, d1 by 32 : reg, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<3x2x32xf32>) -> tensor<2x96xf32>
  func.return(%output) : (tensor<2x96xf32>) -> ()
}

// -----

// ERROR: tile.block: the register tile holds d1, which the read of $0 takes other than by a multiple of it
tile.dispatch @lanes_across_blocks(%input: tensor<4x2x16xf32>) -> tensor<2x64xf32> {
  %output = tile.block(%input) {iters = [par 2, par 64], reads = [$0[d1 floordiv 16, d0, d1 mod 16]], folds = [none -> [d0, d1]], loops = [d1 by 32, d0 by 2 : reg, d1 by 32 : reg, d1 by 32 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x2x16xf32>) -> tensor<2x64xf32>
  func.return(%output) : (tensor<2x64xf32>) -> ()
}

// -----

// ERROR: tile.block: the lanes run along d1, which the read of $0 takes other than in whole vectors of consecutive elements
tile.dispatch @lanes_down_blocks(%input: tensor<16x2x3xf32>) -> tensor<2x48xf32> {
  %output = tile.block(%input) {iters = [par 2, par 48], reads = [$0[d1 mod 16, d0, d1 floordiv 16]], folds = [none -> [d0, d1]], loops = [d0 by 2 : reg, d1 by 48 : reg, d1 by 16 : lanes]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<16x2x3xf32>) -> tensor<2x48xf32>
  func.return(%output) : (tensor<2x48xf32>) -> ()
}

// -----

// ERROR: tile.dispatch: block 1 does not run on the elements that the block before it finishes where it is placed: its read 0 takes axis 0 of the result at d1, where the block before it writes d0
tile.dispatch @transposed_epilogue(%input: tensor<4x4xf32>) -> tensor<4x4xf32> {
  %first = tile.block(%input) {iters = [par 4, par 4], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4x4xf32>
  %second = tile.block(%first) {iters = [par 4, par 4], reads = [$0[d1, d0] at reg], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x4xf32>) -> tensor<4x4xf32>
  func.return(%second) : (tensor<4x4xf32>) -> ()
}

// -----

// ERROR: tile.dispatch: block 1 does not run on the elements that the block before it finishes where it is placed: it folds its points with sum
tile.dispatch @placed_sum(%input: tensor<4x6xf32>) -> tensor<4xf32> {
  %first = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  %sums = tile.block(%first) {iters = [par 4, red 6], reads = [$0[d0, d1] at reg], folds = [sum -> [d0]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4xf32>
  func.return(%sums) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tile.dispatch: block 1 does not run on the elements that the block before it finishes where it is placed: it has 3 iterators, and the block before it 2
tile.dispatch @placed_wider(%input: tensor<4x6xf32>) -> tensor<4x6x2xf32> {
  %first = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  %pairs = tile.block(%first) {iters = [par 4, par 6, par 2], reads = [$0[d0, d1] at reg], folds = [none -> [d0, d1, d2]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6x2xf32>
  func.return(%pairs) : (tensor<4x6x2xf32>) -> ()
}

// -----

// ERROR: tile.dispatch: block 1 does not run on the elements that the block before it finishes where it is placed: its d0 is not a parallel iterator of the same extent in both blocks
tile.dispatch @placed_on_columns(%input: tensor<4x6xf32>) -> tensor<6xf32> {
  %first = tile.block(%input) {iters = [par 4, par 6], reads = [$0[d0, d1]], folds = [none -> [d0, d1]]} ({
  ^body(%element: f32):
    tile.yield(%element) : (f32) -> ()
  }) : (tensor<4x6xf32>) -> tensor<4x6xf32>
  %row = tile.block(%first) {iters = [par 6], reads = [$0[0, d0] at reg], folds = [none -> [d0]]} ({
  ^body(%element: f32):
