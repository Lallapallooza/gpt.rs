// RUN: verify

// ERROR: func.func: a load-time function reads only parameters
func.func @load_time_input(%input: tensor<4xf32>) -> (tensor<4xf32> {param = 7}) {
  func.return(%input) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: func.func: region 0 yields (tensor<4xf32>), expected (tensor<4xsi32>)
func.func @wrong_return(%input: tensor<4xf32>) -> tensor<4xsi32> {
  func.return(%input) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: func.func: region 0 does not end with its terminator
func.func @no_return(%input: tensor<4xf32>) -> tensor<4xf32> {
  %exp = tensor.exp(%input) : (tensor<4xf32>) -> tensor<4xf32>
}

// -----

// ERROR: func.return: a terminator must be the last op of its region
func.func @two_returns(%input: tensor<4xf32>) -> tensor<4xf32> {
  func.return(%input) : (tensor<4xf32>) -> ()
  func.return(%input) : (tensor<4xf32>) -> ()
}

// -----

// ERROR: tensor.add: result types are (tensor<8xf32>), but the op gives (tensor<4xf32>)
func.func @stale_result(%input: tensor<4xf32>) -> tensor<8xf32> {
  %sum = tensor.add(%input, %input) : (tensor<4xf32>, tensor<4xf32>) -> tensor<8xf32>
  func.return(%sum) : (tensor<8xf32>) -> ()
}
