// ERROR: tensor.scan: the scanned inputs must share their leading extent, got tensor<5x4xf32>
func.func @scan_steps(%0: tensor<6x4xf32>, %1: tensor<5x4xf32>) -> tensor<6x4xf32> {
  %2 = tensor.scan(%0, %1) {carry_count = 0, outputs = [tensor<4xf32>]} ({
  ^body(%3: tensor<4xf32>, %4: tensor<4xf32>):
